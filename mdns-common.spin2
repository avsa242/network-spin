con

    MDNS_HEADER_LEN     = 12

    struct mdns_header_s(...
        word id, ...
        word flags, ...
        word qdcount, ...
        word ancount, ...
        word nscount, ...
        word arcount)

    QUERY                   = 0


    ' mDNS cache entry structures
    NAME_SZ                 = 128
    TYPE_SZ                 = 32
    DOMAIN_SZ               = 32
    TEXT_SZ                 = 128
    PROTO_SZ                = 5
    MAX_SERVICES_PER_HOST   = 5

    struct mdns_entry_s(...
        long        ipv4_addr, ...
        ipv6_addr_s ipv6_addr, ...
        byte        hostname[NAME_SZ], ...
        byte        name[TEXT_SZ], ...          ' full label with instance/service/proto/domain
        long        ttl, ...
        word        priority, ...
        word        weight, ...
        word        port, ...
        byte        text[512], ...
        byte        services, ...
        byte        in_use)
'xxx add member to store nsec bitmap

    MDNS_IPV4_ADDR  = $fb_0_0_e0
    MDNS_IPV6_ADDR  = $00fb_ff02                ' ff02::fb


DAT
