con

    MDNS_HEADER_LEN     = 12

    struct mdns_header_s(...
        word id, ...
        word flags, ...
        word qdcount, ...
        word ancount, ...
        word nscount, ...
        word arcount)

    QUERY                   = 0


    ' mDNS cache entry structures
    NAME_SZ                 = 64
    TYPE_SZ                 = 32
    DOMN_SZ                 = 32
    TEXT_SZ                 = 107
    PROTO_SZ                = 5
    MAX_SERVICES_PER_HOST   = 5

    struct service_s(...
        byte instance[NAME_SZ], ...
        byte service[NAME_SZ], ...
        byte protocol[PROTO_SZ], ...                      ' layer 4 protocol ID from IP
        word priority, ...
        word weight, ...
        word port)


    struct mdns_entry_s(...
        long        last_seen, ...
        long        ipv4_addr, ...
        ipv6_addr_s ipv6_addr, ...
        byte        name[NAME_SZ], ...
        byte        type[TYPE_SZ], ...
        byte        domain[DOMN_SZ], ...
        byte        text[TEXT_SZ], ...
        byte        in_use, ...
        byte        services, ...
        service_s   service[MAX_SERVICES_PER_HOST])


DAT
