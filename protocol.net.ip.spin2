{Spin2_v51}

#ifndef NET_COMMON
#include "net-common.spin2h"
#endif

CON

    ' limits
    IP_HDR_SZ       = 20                        ' header length

    ' default settings
    TTL_DEFAULT     = 64
    NONE            = 0

    ' layer 4 protocols
    RSVD            = $00
    ICMP            = $01
    IGMP            = $02
    GGP             = $03
    IP_IN_IP        = $04
    TCP             = $06
    EGP             = $08
    UDP             = $11
    ESP             = $32
    AH              = $33

    ' Differentiated Services Codepoints
    CS6             = $30

    ' flags
    IP_DONT_FRAGMENT= 1 << 1
    DF              = IP_DONT_FRAGMENT
    IP_MORE_FRAGS   = 1 << 0
    MF              = IP_MORE_FRAGS


    ' IP header options
    MAX_OPTS                = 13                ' most opts possible if all are 1-byte values
    MAX_OPT_DATA_SZ         = 36

    struct ip_option_s(...
        byte type, ...
        byte length, ...
        byte vals[MAX_OPT_DATA_SZ])             ' 36 is worst-case scenario

    TYPE_COF                = 7
        COF_COPY            = 1 << TYPE_COF
        COF_DONT_COPY       = 0
    TYPE_COF_BITS           = 1 << TYPE_COF     ' copy on fragment
    TYPE_CLASS              = 5
    TYPE_CLASS_BITS         = %11 << TYPE_CLASS
        CLASS_CONTROL       = %00
        DBG_MEAS            = %10
    TYPE_NUMBER             = 0
    TYPE_NUMBER_BITS        = %11111 << TYPE_NUMBER
        TYPE_END            = 0                 ' len=1
        TYPE_NOOP           = 1                 ' len=1
        TYPE_SECURITY       = 2                 ' len=11
        TYPE_LOOSE_SRC      = 3                 ' len=var
        TYPE_INET_TIMEST    = 4                 ' class=2, len=var
        TYPE_REC_ROUTE      = 7                 ' len=var
        TYPE_STREAM_ID      = 8                 ' len=4
        TYPE_STRICT_SRC     = 9                 ' len=var
        TYPE_ROUTER_ALERT   = 20                ' cof=copy, class=control, len=4


OBJ

    net=    NETIF_DRIVER                        ' network driver "virtual" instance
    crc:    "math.crc"


VAR

    long p_ndev                                 ' network driver object pointer

    ^ip_header_s hdr
    ip_option_s option[MAX_OPTS]                ' max options (assuming 1-byte values)


    long _my_ip
    word _ip_start


pub init(optr)
' Set pointer to network device object
    p_ndev := optr


pub set_header(p_hdr)
' Set pointer to IPv4 header ip_header_s structure
    [hdr] := p_hdr


pub addr8888to32b(a3, a2, a1, a0): a
' Convert four-octet IP address into long
'   a3..a0:     IP address octets (MSB..LSB)
'   Returns:    32-bit IP address (big-endian/network-byte-order)
    return (a0 << 24) | (a1 << 16) | (a2 << 8) | a3


pub addr8888to32l(a3, a2, a1, a0): a
' Convert four-octet IP address into long
'   a3..a0:     IP address octets (MSB..LSB)
'   Returns:    32-bit IP address (little-endian)
    return (a3 << 24) | (a2 << 16) | (a1 << 8) | a0


pub clear_option(idx)
' Clear a cached option
    if ( (idx >= 0) and (idx <= MAX_OPTS) )
        option[idx]~


PUB dec_ttl()
' Decrease time-to-live field by 1
    hdr.ttl := 0 #> (hdr.ttl-1)


PUB dest_addr(): a
' Get destination address of IP datagram
'   Returns: 32-bit IP address (LE)
    return swap_long(hdr.dest_addr)             ' swap to host (Propeller) byte order


PUB dgram_len(): l
' Return total length of IP datagram, in bytes
'   Returns: word (little-endian)
    return swap_word(hdr.dgram_len)


PUB dscp(): cp
' Differentiated services code point
'   Returns: 6-bit code point
    return (hdr.dscp_ecn >> 2) & $fc


PUB ecn(): s
' Explicit Congestion Notification
'   Returns: 2-bit ECN state
    return (hdr.dscp_ecn & $03)


PUB flags(): f
' Get fragmentation control flags
'   Returns: 3-bit field
    return (hdr.flags_frag_h >> 5)


PUB frag_offset(): o
' Get offset in overall message of this fragment
'   Returns: 13-bit offset (little-endian)
    return ( (hdr.flags_frag_h << 8) & $1f) | hdr.frag_l


PUB hdr_chk(): c
' Get header checksum
'   Returns: word (little-endian)
    return swap_word(hdr.checksum)


PUB hdr_len(): l
' Get header length, in bytes
'   Returns: byte
    return ( (hdr.version & $0f) * 4)


PUB is_multicast_addr(ip): f
' Flag indicating the given address is a multicast address
    if ( (ip >= $e0_00_00_00) and (ip <= $ef_ff_ff_ff) )
        return true                             ' multicast ip is 224.0.0.0 to 239.255.255.255
    else
        return false


pub is_multicast_link_local_addr(ip): f
' Flag indicating the given address is a link-local multicast address
    if ( (ip >= $e0_00_00_00) and (ip <= $e0_00_00_ff) )
        return true                             ' multicast ip is 224.0.0.0 to 224.0.0.255
    else
        return false


PUB layer4_proto(): p
' Get layer 4/transport protocol carried in datagram
'   Returns: byte
    return hdr.l4proto


PUB msg_ident(): i
' Get identification common to all fragments in a message
'   Returns: word
    return swap_word(hdr.ident)


PUB my_ip(): a
' Get this node's IP address
    return swap_long(_my_ip)


PUB new(l4_proto, src_ip, dest_ip)
' Construct an IPV4 header
'   l4_proto: OSI Layer-4 protocol (L4_TCP, L4_UDP, L4_ICMP)
    _ip_start := net[p_ndev].fifo_wr_ptr()
    reset_ipv4()
    set_layer4_proto(l4_proto)
    set_src_addr(src_ip)
    set_dest_addr(dest_ip)
    if ( is_multicast_link_local_addr(dest_ip) )' ttl _must_ be 1 when datagrams are sent to
        set_ttl(1)                              '   link-local (224.0.0.0 to .255) multicast addr
    else
        set_ttl(TTL_DEFAULT)

    wr_ip_header()


pub option_class(o): c
' Get the class field of a cached option
'   o:  cached option index (0..MAX_OPTS-1)
'   Returns:
'       2-bit class on success
'       -1 on failure
    if ( (o < 0) or (o > MAX_OPTS) )
        return -1

    return (option[o].type & TYPE_CLASS_BITS) >> TYPE_CLASS


pub option_copy_on_frag(o): c
' Get the copy-on-fragmentation field of a cached option
'   o:  cached option index (0..MAX_OPTS-1)
'   Returns:
'       1-bit flag on success (0: false, 1: true)
'       -1 on failure
    if ( (o < 0) or (o > MAX_OPTS) )
        return -1

    return (option[o].type & TYPE_COF_BITS) >> TYPE_COF


pub option_number(o): n
' Get the number field of a cached option
'   o:  cached option index (0..MAX_OPTS-1)
'   Returns:
'       5-bit number on success
'       -1 on failure
    if ( (o < 0) or (o > MAX_OPTS) )
        return -1

    return (option[o].type & TYPE_NUMBER_BITS)


PUB payload_length(): l
' Get the length of the payload (layer 4 and above) only
    return dgram_len()-IP_HDR_SZ


PUB rd_ip_header(p_src=0): p | ihl, o
' Read IP header
'   p_src:  pointer to source buffer in RAM containing IP header
'           (optional; default is to read it from the network device instead)

    ifnot ( p_src )                             ' read an IP header from the network device
        _ip_start := net[p_ndev].fifo_rd_ptr()
        net[p_ndev].rd_block(@hdr, IP_HDR_SZ)
    else                                        ' read an IP header from RAM
        bytemove(@hdr, p_src, IP_HDR_SZ)

    ihl := hdr_len()
    if ( ihl > IP_HDR_SZ )                      ' IP header > 20 bytes? options are attached
        ihl -= IP_HDR_SZ                        ' header length - 20 = options length
        repeat MAX_OPTS with o
            ifnot ( option[o].type )
                ihl -= rd_option(@option)
            if ( ihl <= 0 )
                quit

    return net[p_ndev].fifo_wr_ptr()


pub rd_option(^ip_option_s opt): t
' Read IP header option
'   opt:    pointer to ip_option_s structure
    opt.type := net[p_ndev].rd_byte()
    opt.length := net[p_ndev].rd_byte()
    net[p_ndev].rd_block(@opt.vals, opt.length-2)

    return opt.length


PUB reply(): p
' Set up/write IPv4 header as a reply to last received header
    set_hdr_chk(0)                         ' init header checksum to 0
    set_dest_addr( src_addr() )
    set_src_addr( my_ip() )
    _ip_start := net[p_ndev].fifo_wr_ptr()
    wr_ip_header()


PUB reset_ipv4()
' Reset all values to defaults for an IPV4 header
    hdr~
    set_version(4)
    set_hdr_len(IP_HDR_SZ)
    set_flags(DF)
    set_ttl(TTL_DEFAULT)
    set_msg_ident($0001)


PUB set_dest_addr(a)
' Set destination address of IP datagram
'   a:  32-bit IP address (LE)
    hdr.dest_addr := swap_long(a)               ' swap to network byte order


PUB set_dgram_len(len)
' Set total length of IP datagram, in bytes
'   len: L4 header length + data length
'   NOTE: don't include the 20-bytes of IP header in the length
    len += IP_HDR_SZ
    hdr.dgram_len := swap_word(len)


PUB set_dscp(cp)
' Set Differentiated services code point
    hdr.dscp_ecn |= (cp << 2)


PUB set_ecn(st)
' Set Explicit Congestion Notification state
    hdr.dscp_ecn |= (st & $03)


PUB set_flags(f)
' Set fragmentation control flags
    hdr.flags_frag_h |= (f << 5)


PUB set_frag_offset(offs)
' Set offset in overall message of this fragment
    hdr.flags_frag_h |= (offs.byte[1] & $1f) | offs.byte[0]


PUB set_hdr_chk(ck)
' Set header checksum
    hdr.checksum := swap_word(ck)


PUB set_hdr_len(len)
' Set header length, in bytes
'   NOTE: len must be a multiple of 4
    hdr.version |= (len / 4)


PUB set_layer4_proto(p)
' Set layer 4 protocol carried in datagram
    hdr.l4proto := p


PUB set_msg_ident(id)
' Set identification common to all fragments in a message
    hdr.ident := swap_word(id)


PUB set_my_ip(o3, o2, o1, o0)
' Set this node's IP address (stored in RAM)
'   o3..o0: IP address octets, MSB to LSB (e.g. 192,168,1,10)
    _my_ip.byte[0] := o3
    _my_ip.byte[1] := o2
    _my_ip.byte[2] := o1
    _my_ip.byte[3] := o0


PUB set_my_ip32(a)
' Set this node's IP address, as a 32-bit number (little-endian/host/Propeller-native byte order)
'   addr: IP address in 32bit form, MSB to LSB (e.g. for 192.168.1.10, $c0_a8_01_0a)
    _my_ip := swap_long(a)                      ' convert IP address to network byte order


PUB set_src_addr(a)
' Set source/originator of IP datagram
'   a:  32-bit IP address (LE)
    hdr.src_addr := swap_long(a)                ' swap to network byte order


PUB set_ttl(t)
' Set number of router hops datagram is allowed to traverse
    hdr.ttl := t


PUB set_version(v)
' Set IP version
    hdr.version |= (v << 4)


PUB src_addr(): a
' Get source/originator of IP datagram
'   Returns: 32-bit IP address (LE)
    return swap_long(hdr.src_addr)              ' swap to host (Propeller) byte order


PUB start_pos(): p
' Get pointer to start of IP header
    return _ip_start


PUB swap_dest_src()
' Swap the destination and source IP address fields
    hdr.src_addr, hdr.dest_addr := hdr.dest_addr, hdr.src_addr


PUB ttl(): t
' Get number of router hops datagram is allowed to traverse
'   Returns: byte
    return hdr.ttl


PUB update_chksum(len): ck | p_tmp
' Update IP header with checksum
'   len: length of datagram (layer-4 and datagram only; don't include the 20-byte IP header)
    p_tmp := net[p_ndev].fifo_wr_ptr()          ' save the current pointer

    ' update IP header with specified length and calculate checksum;
    '   NOTE: the checksum should encompass the IP header _only_, _not_ the layer-4 protocol
    '   and the payload, if they exist
    set_dgram_len(len)
    net[p_ndev].fifo_set_wr_ptr(_p_dlen)        ' set pointer to datagram length field
    net[p_ndev].wr_word(hdr.dgram_len)

    ck := crc.inet_chksum(@hdr, hdr_len() )  ' update the IP header checksum
    net[p_ndev].fifo_set_wr_ptr(_p_chk)         ' set pointer to checksum field
    net[p_ndev].wr_word( swap_word(ck) )        '   and write it

    net[p_ndev].fifo_set_wr_ptr(p_tmp)          ' restore pointer pos


PUB version(): v
' Get IP version
'   Returns: byte
    return ( (hdr.version >> 4) & $0f)


VAR long _p_chk, _p_dlen
PUB wr_ip_header(): p
' Write IP header to buffer
'   Returns: length of assembled header, in bytes
'   xxx should just be able to get the start of IP here and use offsets from it instead of the two fifo_wr_ptr() calls below?
    net[p_ndev].wr_block(@hdr.version, 1)
    net[p_ndev].wr_block(@hdr.dscp_ecn, 1)
    _p_dlen := net[p_ndev].fifo_wr_ptr()
    net[p_ndev].wr_block(@hdr.dgram_len, 2)
    net[p_ndev].wr_block(@hdr.ident, 2)
    net[p_ndev].wr_block(@hdr.flags_frag_h, 1)
    net[p_ndev].wr_block(@hdr.frag_l, 1)
    net[p_ndev].wr_block(@hdr.ttl, 1)
    net[p_ndev].wr_block(@hdr.l4proto, 1)
    _p_chk := net[p_ndev].fifo_wr_ptr()
    net[p_ndev].wr_block(@hdr.checksum, 2)
    net[p_ndev].wr_block(@hdr.src_addr, 4)
    net[p_ndev].wr_block(@hdr.dest_addr, 4)

    return net[p_ndev].fifo_wr_ptr()


DAT
