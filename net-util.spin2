obj

' default to the ANSI serial terminal if no terminal driver is specified
#ifndef TERM_DRIVER
#   define TERM_DRIVER  "com.serial.terminal.ansi"
#endif
    term=   TERM_DRIVER                         ' terminal driver "virtual" instance
    str:    "string"                            ' string manipulation


var

    long p_tdrv                                 ' terminal driver object pointer


pub attach = attach_terminal_driver
pub attach_terminal_driver(optr)
' Initialize: set the terminal output driver
'   optr:   pointer to terminal driver object instance
'       (e.g., net_util.attach_terminal_driver(@serial) )
    p_tdrv := optr


PUB show_ip_addr(p_premsg, addr, p_postmsg) | i
' Display IP address in dotted-quad notation
'   p_premsg:       pointer to (optional) string to prefix the IP address with (0 to ignore)
'   addr:           32-bit IP address (LSB-first)
'   p_postmsg:      pointer to (optional) string to post-fix the IP address with (0 to ignore)
    if ( p_premsg )
        term[p_tdrv].str(p_premsg)

    term[p_tdrv].str( str.iptostr(addr) )

    if ( p_postmsg )
        term[p_tdrv].str(p_postmsg)


PUB show_mac_addr(p_premsg, p_addr, p_postmsg) | i
' Display MAC address
'   p_premsg:   pointer to (optional) string to prefix the MAC address with (0 to ignore)
'   p_addr:     pointer to the MAC address
'   p_postmsg:  pointer to (optional) string to post-fix the MAC address with (0 to ignore)
    if ( p_premsg )
        term[p_tdrv].str(p_premsg)

    term[p_tdrv].str( str.mactostr(p_addr) )

    if ( p_postmsg )
        term[p_tdrv].str(p_postmsg)


DAT

    { TCP flags: strings }
    _tcp_flagstr
        byte    " FIN ", 0
        byte    " SYN ", 0
        byte    " RST ", 0
        byte    " PSH ", 0
        byte    " ACK ", 0
        byte    " URG ", 0
        byte    " ECN ", 0
        byte    " CWR ", 0

PUB show_tcp_flags(flags) | i
' Display the TCP header's flag bits as symbols
    term[p_tdrv].str(@"Flags: [")
    repeat i from 7 to 0
        if ( flags & decod(i) )
            if ( flags & (1 << 2) )             ' RST: color red if set
                term[p_tdrv].fgcolor(term[p_tdrv].RED)
            else                                ' other flags green if set
                term[p_tdrv].fgcolor(term[p_tdrv].GREEN)
            term[p_tdrv].str(@_tcp_flagstr[i*6])
        else                                    ' all flags dark grey if clear
            term[p_tdrv].fgcolor(term[p_tdrv].DKGREY)
            term[p_tdrv].str(@_tcp_flagstr[i*6])
    term[p_tdrv].fgcolor(term[p_tdrv].GREY)     ' reset color
    term[p_tdrv].putchar("]")
    term[p_tdrv].newline()


DAT
