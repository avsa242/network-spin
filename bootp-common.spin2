#ifndef NET_COMMON
#include "net-common.spin2h"
#endif

con

    HDWADDRLEN_MAX      = 16
    SRV_HOSTN_LEN       = 64

    BOOTPM_OP           = 0
    BOOTPM_CLI_HW_T     = 1
    BOOTPM_HW_ADDR_LEN  = 2
    BOOTPM_HOP          = 3
    BOOTPM_XID          = 4
    BOOTPM_LSTM_EL_M    = 8
     BOOTPM_LSTM_EL_L   = 9
    BOOTPM_FLAGS        = 10
     BOOTPM_FLAGS_L     = 11
    BOOTPM_CIP          = 12
    BOOTPM_YIP          = BOOTPM_CIP+IPV4ADDR_LEN
    BOOTPM_SIP          = BOOTPM_YIP+IPV4ADDR_LEN
    BOOTPM_GIP          = BOOTPM_SIP+IPV4ADDR_LEN
    BOOTPM_CLI_MAC      = BOOTPM_GIP+IPV4ADDR_LEN
    BOOTPM_HOSTNM       = BOOTPM_CLI_MAC + (HDWADDRLEN_MAX-MACADDR_LEN)
    BOOTPM_FILENM       = BOOTPM_HOSTNM + SRV_HOSTN_LEN

    struct bootp_msg_s(...
        byte        opcode, ...                 '1
        byte        client_hw_t, ...            '1
        byte        hw_addr_len, ...            '1
        byte        hop, ...                    '1
        long        xid, ...                    '4
        word        lease_time_elapsed, ...     '2
        word        flags, ...                  '2
        long        client_ip, ...              '4
        long        your_ip, ...                '4
        long        server_ip, ...              '4
        long        gateway_ip, ...             '4
        byte        client_mac[16], ...         '16
        byte        hostname[64], ...           '64
        byte        filename[128])              '128


DAT
