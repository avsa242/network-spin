{Spin2_v46}

#ifndef NET_COMMON
#include "net-common.spin2h"
#endif

CON

    { limits }
    ICMP_MSG_SZ     = 4                         ' message length    xxx this was 8...4 seems right though...verify
    ICMP_ECHO_MSG_SZ= 12                        ' echo metadata (_not_ echoed data)

    struct  icmp_msg_s(...
        byte    type, ...
        byte    code, ...
        word    checksum)

    struct  echo_msg_s(...
        word    ident, ...
        word    seq_nr)

    struct  timestamp_msg_s(...
        word    ident, ...
        word    seq_nr, ...
        long    time_origin, ...
        long    time_receive, ...
        long    time_transmit)


    { ECHO: offsets within metadata }
    ICMP_IDENT_M    = 0
    ICMP_IDENT_L    = 1
    ICMP_SEQNR_M    = 2
    ICMP_SEQNR_L    = 3
    ICMP_TMSTMP_M   = 4
    ICMP_TMSTMPF_M  = 8

    { error message types }
    DEST_UNREACH    = 3
    SRC_QUENCH      = 4
    REDIRECT        = 5
    TM_EXCEEDED     = 11
    PARAM_PROB      = 12

    { info message types }
    ECHO_REPL       = 0
    ECHO_REQ        = 8
    ROUTER_ADV      = 9
    ROUTER_SOL      = 10
    TMSTAMP_REQ     = 13
    TMSTAMP_REPL    = 14
    INFO_REQ        = 15    ' obsolete
    INFO_REPL       = 16    ' obsolete
    ADDRMASK_REQ    = 17
    ADDRMASK_REPL   = 18
    TRACERT         = 30

    { message codes/subtypes }
    NET_UNREACH     = 0                         ' unreachable (net)
    HOST_UNREACH    = 1                         ' unreachable (host)
    PROTO_UNREACH   = 2                         ' unreachable (protocol)
    PORT_UNREACH    = 3                         ' unreachable (port)
    FRAG_NEEDED     = 4                         ' frag needed but DF set
    SRC_RT_FAILED   = 5                         ' source route failed
    DEST_NET_UNK    = 6                         ' not used; use NET_UNREACH
    DEST_HOST_UNK   = 7                         ' dest. unknown (host)
    SRC_HOST_ISOL   = 8                         ' obsolete
    NOPERM_NET      = 9                         ' comm. prohibited (net)
    NOPERM_HOST     = 10                        ' comm. prohibited (host)
    NET_SVC_UNREACH = 11                        ' dest. net unreachable (type of service)
    HOST_SVC_UNREACH= 12                        ' dest. host unreachable (type of service)
    FILTERED        = 13                        ' comm. prohibited
    NOPERM_PREC     = 14                        ' host precedence violation
    PREC_CUTOFF     = 15                        ' precedence cutoff in effect


OBJ

    net=    NETIF_DRIVER                        ' network driver "virtual" instance


VAR

    long p_ndev                                 ' network driver object pointer

    byte _icmp_msg_len


    icmp_msg_s      message                     ' ICMP message data
    echo_msg_s      echo_msg
    timestamp_msg_s timestamp_msg


pub init(optr)
' Set pointer to network device object
    p_ndev := optr


PUB echo_reply()
' Set up for an echo reply message
    message.checksum := $0000
    message.type := ECHO_REPL
    wr_icmp_msg()


PUB set_chksum(ck)
' Set checksum (optional; set to 0 to ignore)
    message.checksum := swap_word(ck)


PUB set_code(c)
' Set ICMP subtype
    message.code := c


PUB set_ident(i)
' Set ICMP identifier
    echo_msg.ident := swap_word(i)


PUB set_msg_type(t)
' Set ICMP message type
    message.type := t


PUB set_seq_nr(n)
' Set ICMP sequence number
    echo_msg.seq_nr := swap_word(n)


PUB set_timestamp(tm)
' Set timestamp for ICMP message
    timestamp_msg.time_origin := swap_long(tm)


PUB chksum(): ck
' Get checksum
    return message.checksum


PUB code(): c
' Get ICMP subtype/code
    return message.code


PUB ident(): i
' Get ICMP identifier
    return echo_msg.ident


PUB msg_len(): l
' Get length of currently assembled ICMP message
    return _icmp_msg_len


PUB msg_type(): t
' Get ICMP message type
    return message.type


PUB echo_seq_nr(): n
' Get ICMP echo message sequence number
    return echo_msg.seq_nr


PUB timestamp_seq_nr(): n
' Get ICMP timestamp message sequence number
    return timestamp_msg.seq_nr


PUB timestamp(): t
' Get timestamp from ICMP message
    return timestamp_msg.time_receive


PUB rd_icmp_msg(): p
' Read/disassemble ICMP message
'   Returns: network device FIFO write pointer, after reading
    net[p_ndev].rd_block(@message, ICMP_MSG_SZ)

    return net[p_ndev].fifo_wr_ptr()


PUB wr_icmp_msg(): p | st, nd
' Write/assemble ICMP message
'   Returns: network device FIFO write pointer, after writing
    st := net[p_ndev].fifo_wr_ptr()
    net[p_ndev].wr_block(@message, ICMP_MSG_SZ)
    nd := net[p_ndev].fifo_wr_ptr()

    _icmp_msg_len := (nd - st)

    return nd


DAT
