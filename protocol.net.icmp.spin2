{Spin2_v46}

#ifndef NET_COMMON
#include "net-common.spin2h"
#endif

CON

    { limits }
    ICMP_MSG_SZ     = 4                         ' message length    xxx this was 8...4 seems right though...verify
    ICMP_ECHO_MSG_SZ= 12                        ' echo metadata (_not_ echoed data)


    { ECHO: offsets within metadata }
    ICMP_IDENT_M    = 0
    ICMP_IDENT_L    = 1
    ICMP_SEQNR_M    = 2
    ICMP_SEQNR_L    = 3
    ICMP_TMSTMP_M   = 4
    ICMP_TMSTMPF_M  = 8

    { error message types }
    DEST_UNREACH    = 3
    SRC_QUENCH      = 4
    REDIRECT        = 5
    TM_EXCEEDED     = 11
    PARAM_PROB      = 12

    { info message types }
    ECHO_REPL       = 0
    ECHO_REQ        = 8
    ROUTER_ADV      = 9
    ROUTER_SOL      = 10
    TMSTAMP_REQ     = 13
    TMSTAMP_REPL    = 14
    INFO_REQ        = 15    ' obsolete
    INFO_REPL       = 16    ' obsolete
    ADDRMASK_REQ    = 17
    ADDRMASK_REPL   = 18
    TRACERT         = 30

    { message codes/subtypes }
    NET_UNREACH     = 0                         ' unreachable (net)
    HOST_UNREACH    = 1                         ' unreachable (host)
    PROTO_UNREACH   = 2                         ' unreachable (protocol)
    PORT_UNREACH    = 3                         ' unreachable (port)
    FRAG_NEEDED     = 4                         ' frag needed but DF set
    SRC_RT_FAILED   = 5                         ' source route failed
    DEST_NET_UNK    = 6                         ' not used; use NET_UNREACH
    DEST_HOST_UNK   = 7                         ' dest. unknown (host)
    SRC_HOST_ISOL   = 8                         ' obsolete
    NOPERM_NET      = 9                         ' comm. prohibited (net)
    NOPERM_HOST     = 10                        ' comm. prohibited (host)
    NET_SVC_UNREACH = 11                        ' dest. net unreachable (type of service)
    HOST_SVC_UNREACH= 12                        ' dest. host unreachable (type of service)
    FILTERED        = 13                        ' comm. prohibited
    NOPERM_PREC     = 14                        ' host precedence violation
    PREC_CUTOFF     = 15                        ' precedence cutoff in effect


OBJ

    net=    NETIF_DRIVER                        ' network driver "virtual" instance
    crc:    "math.crc"


VAR

    long p_ndev                                 ' network driver object pointer

    long _cksum_pos
    byte _icmp_msg_len
    byte _echo_data_len


pub init(optr)
' Set pointer to network device object
    p_ndev := optr


PUB echo_reply(^icmp4_hdr_s hdr)
' Set up for an echo reply message
'   hdr:    ICMP header structure
    set_chksum(@hdr, 0)
    set_msg_type(@hdr, ECHO_REPL)
    wr_icmp_msg()


PUB set_chksum(^icmp4_hdr_s hdr, ck)
' Set checksum (optional; set to 0 to ignore)
'   hdr:    ICMP header structure
    hdr.checksum := swap_word(ck)


PUB set_code(^icmp4_hdr_s hdr, c)
' Set ICMP subtype
'   hdr:    ICMP header structure
    hdr.code := c


PUB set_echo_data_len(l)
' Set the length of the payload data in an ECHO message
    _echo_data_len := l                         ' keep LE; used internally, not written to the frame


PUB set_ident(^echo_msg_s msg, i)
' Set ICMP identifier
    msg.ident := swap_word(i)


PUB set_msg_type(^icmp4_hdr_s hdr, t)
' Set ICMP message type
'   hdr:    ICMP header structure
    hdr.type := t


PUB set_seq_nr(^echo_msg_s msg, n)
' Set ICMP sequence number
    msg.seq_nr := swap_word(n)


PUB set_timestamp(^timestamp_msg_s msg, tm)
' Set timestamp for ICMP message
    msg.time_origin := swap_long(tm)


PUB chksum(^icmp4_hdr_s hdr): ck
' Get checksum
'   hdr:    ICMP header structure
    return hdr.checksum


PUB code(^icmp4_hdr_s hdr): c
' Get ICMP subtype/code
'   hdr:    ICMP header structure
    return hdr.code


PUB echo_data_len(): l
' Get the length of the ECHO message data (internal only; not contained in the network frame)
    return _echo_data_len


PUB ident(^echo_msg_s msg): i
' Get ICMP identifier
    return msg.ident


PUB msg_len(): l
' Get length of currently assembled ICMP message
    return _icmp_msg_len


PUB msg_type(^icmp4_hdr_s hdr): t
' Get ICMP message type
'   hdr:    ICMP header structure
    return hdr.type


PUB echo_seq_nr(^echo_msg_s msg): n
' Get ICMP echo message sequence number
    return msg.seq_nr


PUB timestamp_seq_nr(^timestamp_msg_s msg): n
' Get ICMP timestamp message sequence number
    return msg.seq_nr


PUB timestamp(^timestamp_msg_s msg): t
' Get timestamp from ICMP message
    return msg.time_receive


PUB rd_echo_data(p_buff, l=0): p
' Read ECHO message optional data
'   p_buff: pointer to buffer to read echo message data to
'   l:      length to read (optional; if unspecified, the current setting of set_echo_data_len()
'               will be used instead)
    if ( l )
        net[p_ndev].rd_block(p_buff, l)
        _echo_data_len := l
    else
        net[p_ndev].rd_block(p_buff, _echo_data_len)


PUB rd_icmp_msg(^icmp4_hdr_s hdr): p
' Read ICMP message from network device
'   hdr:    ICMP header structure
'   Returns: network device FIFO write pointer, after reading
    net[p_ndev].rd_block(@hdr, ICMP_MSG_SZ)

    return net[p_ndev].fifo_wr_ptr()


PUB update_chksum(^icmp4_hdr_s hdr, p_buff=0, len=0) | tmp
' Update the checksum field of the header
'   hdr:    ICMP header structure
'   p_buff: pointer to message data (optional; leave unspecified to ignore)
    set_chksum(@hdr, 0)
    set_chksum(@hdr, crc.inet_chksum(@hdr, ICMP_MSG_SZ, 0, false) )
    if ( p_buff )
        ifnot ( len )
            if ( msg_type(@hdr) == ECHO_REPL )
                len := _echo_data_len
        set_chksum(@hdr, crc.inet_chksum(p_buff, len, hdr.checksum) )

    ' write the checksum to the ICMP header
    tmp := net[p_ndev].fifo_wr_ptr()            ' remember the current write pointer
    net[p_ndev].fifo_set_wr_ptr(_cksum_pos)     ' move it to the ICMP checksum position
    net[p_ndev].wr_word(hdr.checksum)           ' write the checksum
    net[p_ndev].fifo_set_wr_ptr(tmp)            ' restore the original pointer


PUB wr_icmp_msg(): p | st, nd
' Write/assemble ICMP message
'   hdr:    ICMP header structure
'   Returns: network device FIFO write pointer, after writing
    st := net[p_ndev].fifo_wr_ptr()
    _cksum_pos := st + ICMP_CKSUM     ' record the position of the checksum field
    net[p_ndev].wr_block(@hdr, ICMP_MSG_SZ)
    nd := net[p_ndev].fifo_wr_ptr()

    _icmp_msg_len := (nd - st)

    return nd


pub wr_icmp_msg_to(hdr, p_dest): l

    bytemove(p_dest, @hdr, ICMP_MSG_SZ)


PUB wr_echo_data(p_buff, l=0): p
' Write ECHO message optional data
'   p_buff: pointer to echo message data
'   l:      length to read (optional; if unspecified, the current setting of set_echo_data_len()
'               will be used instead)
    if ( l )
        net[p_ndev].wr_block(p_buff, l)
        _echo_data_len := l
    else
        net[p_ndev].wr_block(p_buff, _echo_data_len)

    return net[p_ndev].fifo_wr_ptr()


DAT
