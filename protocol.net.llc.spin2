{Spin2_v46}

#ifndef NET_COMMON
#include "net-common.spin2h"
#endif

con

    ' limits
    LLC_HEADER_SZ   = 3


    ' access point types
    STP             = $42

#include "llc-common.spin2"


obj

    net=    NETIF_DRIVER


var

    long            p_ndev


PUB init(optr)
' Set pointer to network device object
    p_ndev := optr


pub control(^llc_header_s hdr): t
' Get the type of the LLC frame
    return hdr.control


pub dest_svc_access_point(^llc_header_s hdr): p
' Get the destination service access point
    return hdr.dsap


pub set_control(^llc_header_s hdr, t)
' Set the type of the LLC frame
    hdr.control := t


pub set_dest_svc_access_point(^llc_header_s hdr, p)
' Set the destination service access point
    hdr.dsap := p


pub set_src_svc_access_point(^llc_header_s hdr, p)
' Set the source service access point
    hdr.ssap := p


pub src_svc_access_point(^llc_header_s hdr): p
' Get the source service acess point
    return hdr.ssap


pub rd_header(^llc_header_s hdr): l
' Read the LLC header from the network device
    net[p_ndev].rd_block(@hdr, sizeof(hdr) )


pub wr_header(^llc_header_s hdr): p
' Write the currently build LLC header to the network device
    net[p_ndev].wr_block(@hdr, sizeof(hdr) )
    return net[p_ndev].fifo_wr_ptr()


DAT
