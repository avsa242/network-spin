{Spin2_v51}
#include "net-common.spin2h"
#include "core.con.click.spin2"
'#define EXT_DBG
'#pragma exportdef(EXT_DBG)

con

    _clkfreq    = 180_000_000
    _xtlfreq    = 20_000_000

    CLICK_BASE  = 0


obj

    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000
    net:    "socket-manager"
    str:    "string"


dat

    _mac_local  byte $02, $98, $0c, $06, $01, $c9
    _my_ip      byte "10.42.0.216", 0


var

    byte _testdata[100]


pub main() | sck, s, t, len, rem_ip, rem_port, ch

    ser.startrxtx(63, 62, 0, 2_000_000)
    ser.clear()
    ser.strln(@"serial started")

    net.set_mac_addr(@_mac_local)
    net.set_ip(str.strtoip(@_my_ip))

    net.start(CS_PIN, SCK_PIN, MOSI_PIN, MISO_PIN)

    ' 1. Check out a new socket
    sck := net.new_socket(L4_UDP)
    if ( sck < 0 )
        ' this shouldn't actually happen in this case, but is used here
        ' to show that you _should_ check for it
        ser.strln(@"error: no free sockets")
        repeat

    ' 2. Bind an IP address and (optionally) a port to this socket. Leave port at 0 to pick
    '   a random one.
    net.bind(sck, str.strtoip(@_my_ip), 0, @net._mac_local)

    repeat
        ' build the message to send
        str.sprintf1(@_testdata, @"This is test message #%d from the P2\n\r", t++)
        len := strsize(@_testdata)

        ' 3. Send the datagram to a remote host
        ' Note that the first datagram will take longer to send as the P2 waits for ARP to find
        '   the MAC address associated with the IP address. It then gets cached so subsequent
        '   datagrams will be sent much more quickly (until the next reload).
        rem_ip := str.strtoip(@"10.42.0.1")
        rem_port := 1234
        net.sendto(sck, @_testdata, len, rem_ip, rem_port)
        ser.printf(@"Sent '%s'\n\r", @_testdata)
        ch := ser.getchar()
    until ( ch == "q" )
    ser.strln(@"quit - closing socket")

    ' 4. This isn't needed in this demo, but in general, when you're finished, close the socket.
    net.disconnect(sck)

    repeat


DAT
