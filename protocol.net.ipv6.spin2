{Spin2_v46}

#ifndef NET_COMMON
#include "net-common.spin2h"
#endif

con

    ' limits
    IPV6_HDR_SZ     = 40
    HOP_LIMIT_DEF   = 255


   ' layer 4 protocols (next header)
    HOPBYHOP        = $00
    ICMP            = $01
    IGMP            = $02
    GGP             = $03
    IP_IN_IP        = $04
    TCP             = $06
    EGP             = $08
    UDP             = $11
    ESP             = $32
    AH              = $33
    ICMPV6          = $3a


obj

    net=    NETIF_DRIVER                        ' network driver "virtual" instance


var

    long            p_ndev                      ' network driver object pointer

    ipv6_addr_s     _my_ip

    long            _ip_start


pub init(optr)
' Set pointer to network device object
    p_ndev := optr


pub dest_addr(^ipv6_header_s hdr): p
' Get destination address of IP datagram
'   Returns: 4 IPv4 address bytes packed into long
'    bytemove(p, @hdr.dest_addr, IPV6ADDR_LEN)
    return @hdr.dest_addr


pub dscp(^ipv6_header_s hdr): cp
' Differentiated services code point
'   Returns: 6-bit code point
    return (hdr.version_trafcl & $0f) | ( (hdr.trafcl_flow_label >> 4) &  $0f)


pub flow_label(^ipv6_header_s hdr): l
' Get the flow label
'   Returns: 20-bit flow label
    return ( (  hdr.trafcl_flow_label & $0f) << 16) | ...
                (hdr.flow_label[1] << 8) | ...
                hdr.flow_label[2]


pub hdr_len(): l
' Get header length, in bytes
'   Returns: byte
    return IPV6_HDR_SZ


pub is_multicast_addr(p_addr): f
' Flag indicating the given address is a multicast address
    'xxx


pub my_ip(): a
' Get this node's IP address
'   Returns: pointer to 128-bit address
    return @_my_ip


pub new(^ipv6_header_s hdr, l4_proto, p_src, p_dest)
' Construct an IPV6 header
'   l4_proto: OSI Layer-4 protocol (L4_TCP, L4_UDP, L4_ICMP)
'   p_src:      pointer to 128-bit/16-byte source IPv6 address
'   p_dest:     pointer to 128-bit/16-byte destination IPv6 address
    _ip_start := net[p_ndev].fifo_wr_ptr()
    reset_ipv6(hdr)
    set_hop_limit(hdr, HOP_LIMIT_DEF)
    set_next_header(hdr, l4_proto)
    set_src_addr(hdr, p_src)
    set_dest_addr(hdr, p_dest)
    wr_ip_header(hdr)


pub layer4_proto = next_header
pub next_header(^ipv6_header_s hdr): p
' Get layer 4/transport protocol carried in datagram
'   Returns: byte
    return hdr.next_header


pub payload_length(^ipv6_header_s hdr): l
' Get the length of the payload (layer 4 and above) only
    return swap_word(hdr.payload_len)

{
        byte        version_trafcl, ...
        byte        trafcl_flow_label, ...
        byte        flow_label[2], ...          ' 20b
        word        payload_len, ...
        byte        next_header, ...
        byte        hop_limit, ...
        ipv6addr_s  src_addr, ...
        ipv6addr_s  dest_addr )
}
pub rd_ip_header(^ipv6_header_s hdr): p
' Read IP header from buffer
    _ip_start := net[p_ndev].fifo_rd_ptr()
    net[p_ndev].rd_block(@hdr, sizeof(hdr) )
{    header.version_trafcl := net[p_ndev].rd_byte()
    header.trafcl_flow_label := net[p_ndev].rd_byte()
    header.flow_label[0] := net[p_ndev].rd_byte()
    header.flow_label[1] := net[p_ndev].rd_byte()
    header.payload_len := net[p_ndev].rd_word()
    header.next_header := net[p_ndev].rd_byte()
    header.hop_limit := net[p_ndev].rd_byte()
    net[p_ndev].rd_block(@header.src_addr, IPV6ADDR_LEN)
    net[p_ndev].rd_block(@header.dest_addr, IPV6ADDR_LEN)
}
    return net[p_ndev].fifo_wr_ptr()


pub reply(^ipv6_header_s hdr): p
' Set up/write IPv6 header as a reply to last received header
    set_dest_addr(hdr, src_addr(hdr) )
    set_src_addr(hdr, my_ip() )
    _ip_start := net[p_ndev].fifo_wr_ptr()
    wr_ip_header(hdr)


pub reset_ipv6(^ipv6_header_s hdr)
' Reset all values to defaults for an IPV6 header
    hdr~
    set_version(hdr)
    set_hop_limit(hdr, HOP_LIMIT_DEF)


pub set_dest_addr(^ipv6_header_s hdr, p_addr)
' Set destination address of IP datagram
    bytemove(@hdr.dest_addr, p_addr, IPV6ADDR_LEN)


pub set_dgram_len = set_payload_len
pub set_payload_len(^ipv6_header_s hdr, l)
' Set total length of IP datagram, in bytes
'   len: L4 header length + data length
'   NOTE: don't include the 40-bytes of IP header in the length
    hdr.payload_len := swap_word(l)


pub set_ttl = set_hop_limit
pub set_hop_limit(^ipv6_header_s hdr, h)
' Set number of router hops datagram is allowed to traverse
    hdr.hop_limit := h


pub set_my_ip(p_addr)
' Set this node's IP address 
'   p_addr: pointer to 128-bit IP address
    bytemove(@_my_ip, p_addr, sizeof(_my_ip) )


pub set_layer4_proto = set_next_header
pub set_next_header(^ipv6_header_s hdr, p)
' Set next header carried in datagram
    hdr.next_header := p


pub set_src_addr(^ipv6_header_s hdr, p_addr)
' Set source/originator of IP datagram
    bytemove(@hdr.src_addr, p_addr, IPV6ADDR_LEN)


pub set_version(^ipv6_header_s hdr, v=6)
' Set IP version field
'   v:  version (ignored; temporary, for IPv4 API compatibility only)
    hdr.version_trafcl := 6 << 4


pub src_addr(^ipv6_header_s hdr): p
' Get source/originator of IP datagram
'    bytemove(p, @header.src_addr, IPV6ADDR_LEN)
    return @hdr.src_addr

pub start_pos(): p
' Get pointer to start of IP header in network device FIFO
'   NOTE: new(), rd_ip_header(), or reply()must be called first to set this value
    return _ip_start


pub swap_dest_src()
' Swap the destination and source IP address fields
    'xxx


pub traffic_class(^ipv6_header_s hdr): c
' Get the traffic class
    return ((hdr.version_trafcl & $0f) << 4) | (hdr.trafcl_flow_label >> 4) & $0f


pub version(^ipv6_header_s hdr): v
' Get IP version
'   Returns: byte
    return ( (hdr.version_trafcl >> 4) & $0f)


pub wr_ip_header(^ipv6_header_s hdr): p
' Write IP header to buffer
'   Returns: length of assembled header, in bytes
    net[p_ndev].wr_block(@hdr, sizeof(hdr) )
    return net[p_ndev].fifo_wr_ptr()


DAT
