{Spin2_v51}

#ifndef NET_COMMON
#include "net-common.spin2h"
#endif

con

    ' limits
    MAX_GROUP_RECORDS   = 16

    IGMPV3_MCAST_IP     = $e0_00_00_16          ' 224.0.0.22

    ' IGMP message types
    MEMBER_QUERY        = $11
    MEMBER_REPORT_V1    = $12
    MEMBER_REPORT_V2    = $16
    LEAVE_GROUP_V2      = $17
    MEMBER_REPORT_V3    = $22

    ' header/record lengths
    IGMPV3_QUERY_HDR_SZ = 12
    IGMPV3_REPORT_HDR_SZ= 8
    IGMPV3_GRP_RECORD_SZ= 8


    ' membership report record type enums
    #1, MODE_IS_INCLUDE, MODE_IS_EXCLUDE, CHANGE_TO_INCLUDE, CHANGE_TO_EXCLUDE, ALLOW_NEW, ...
    BLOCK_OLD


obj

    net=    NETIF_DRIVER                        ' network driver "virtual" instance
    crc:    "math.crc"
    ser=    "com.serial.terminal.ansi"


var

    long p_ndev                                 ' network driver object pointer
    long pser

    long _fifo_start
    long _fifo_chksum
    long _msg_len
    long _source_addr

    igmp_memb_query_hdr_s   query_hdr
    igmp_memb_rep_hdr_s     report_hdr
    igmp_grp_rec_s          grp_record[MAX_GROUP_RECORDS]

    byte _type


pub init(optr)
' Set pointer to network device object
    p_ndev := optr


pub sser(ps)
    pser := ps


pub add_group_record(^igmp_grp_rec_s grp_record, t, nr_src, addr): s | r
' Add a MEMBER_REPORT_V3 group record
'   t:      record type (MODE_IS_INCLUDE, MODE_IS_EXCLUDE, CHANGE_TO_INCLUDE, CHANGE_TO_EXCLUDE,
'                       ALLOW_NEW, BLOCK_OLD)
'   nr_src: number of sources
'   addr:   source address
    repeat MAX_GROUP_RECORDS with r
        ifnot ( grp_record[r].type )
            grp_record[r].type := t
            grp_record[r].aux_data_len := 0     ' undefined by RFC 9776
            grp_record[r].num_src := swap_word(nr_src)
            grp_record[r].mcast_addr := swap_long(addr)
            return r

    return -1                                   ' error: group records list full


pub group_record_aux_data_len(^igmp_grp_rec_s grp_record, r): l
' Get length of the auxilliary data
'   NOTE: RFC 9776 doesn't define any auxilliary data and specifies that implementations must not
'       include any; this field should return 0.
    return (grp_record[r].aux_data_len * 4)


pub group_record_multicast_addr(^igmp_grp_rec_s grp_record, r): a
' Get group record multicast IP address
'   r:          group record number
'   Returns:    IP address
    return swap_long(grp_record[r].mcast_addr)


pub group_record_num(^igmp_grp_rec_s grp_record, grp_addr): r
' Get the index of the group address within the cache/array
'   grp_addr:   group/multicast address
'   Returns:
'               index number on success
'               -1 if not found
    repeat MAX_GROUP_RECORDS with r
        if ( swap_long(grp_record[r].mcast_addr) == grp_addr )
            return r

    return -1


pub group_record_num_sources(^igmp_grp_rec_s grp_record, r): l
' Get the number of source addresses in a report group record
'   r:          group record number
'   Returns:    number of source addresses
    return swap_word(grp_record[r].num_src)


pub group_record_type(^igmp_grp_rec_s grp_record, r): t
' Get a report group record's type
'   r:          group record number
'   Returns:    report group record type (MODE_IS_INCLUDE, MODE_IS_EXCLUDE, CHANGE_TO_INCLUDE,
'                   CHANGE_TO_EXCLUDE, ALLOW_NEW, BLOCK_OLD)
    return grp_record[r].type


pub query_checksum(^igmp_memb_query_hdr_s query_hdr): c
' Get the membership query header checksum
    return swap_word(query_hdr.checksum)


pub query_clear(^igmp_memb_query_hdr_s query_hdr)
' Clear the membership query header in RAM
    query_hdr~


pub query_flags(^igmp_memb_query_hdr_s query_hdr): f
' Get the membership query header flags, S-Flag, QRV 
    return query_hdr.flags_qrv


pub query_group_address(^igmp_memb_query_hdr_s query_hdr): a
' Get the membership query group address
    return swap_long(query_hdr.group_addr)


pub query_interval(^igmp_memb_query_hdr_s query_hdr): t
' Get the membership querier's query interval code
    return query_hdr.qqic


pub query_max_response_timeout(^igmp_memb_query_hdr_s query_hdr): t
' Get the max time allowed before sending a membership report responding to this query
    return query_hdr.max_resp_code


pub query_num_sources(^igmp_memb_query_hdr_s query_hdr): n
' Get the number of source addresses present in the membership query
    return swap_word(query_hdr.num_src)


pub message_len(): l
' Get the currently assembled message's length
    return _msg_len


pub message_type(): t
' Get the currently assembled message's type
    return _type


pub report_checksum(^igmp_memb_rep_hdr_s report_hdr): c
' Get the membership report's header checksum
    return swap_word(report_hdr.checksum)


pub report_clear(^igmp_memb_rep_hdr_s report_hdr)
' Clear the membership report header in RAM
    report_hdr~


pub report_flags(^igmp_memb_rep_hdr_s report_hdr): f
' Get the membership report's header flags
    return swap_word(report_hdr.flags)


pub report_num_records(^igmp_memb_rep_hdr_s report_hdr): n
' Get the number of group records in the membership report message
    return swap_word(report_hdr.num_records)


pub set_message_type(t): s
' Set the IGMP message type
'   t:  message type (MEMBER_QUERY, MEMBER_REPORT_V3, LEAVE_GROUP_V2)
    s := 0
    ifnot ( lookdown(t: MEMBER_QUERY, MEMBER_REPORT_V3, LEAVE_GROUP_V2) )
        return -1                               ' error: invalid message type

    _type := t


pub set_query_checksum(^igmp_memb_query_hdr_s query_hdr, c)
' Set the membership query header's checksum
    query_hdr.checksum := swap_word(c)


pub set_record_type(r, t)
' Set or update the record type of a group record in RAM
'   r:  record number (0..MAX_GROUP_RECORDS-1)
'   t:  type (MODE_IS_INCLUDE, MODE_IS_EXCLUDE, CHANGE_TO_INCLUDE, CHANGE_TO_EXCLUDE,
'                       ALLOW_NEW, BLOCK_OLD)
    grp_record[r].type := t


pub set_report_checksum(^igmp_memb_rep_hdr_s report_hdr, c)
' Set the membership report header's checksum
    report_hdr.checksum := swap_word(c)


pub set_report_flags(^igmp_memb_rep_hdr_s report_hdr, f)
' Set the membership query header's flags
    report_hdr.flags := f


pub set_report_num_records(^igmp_memb_rep_hdr_s report_hdr, n)
' Set the number of group records in the membership report
    report_hdr.num_records := swap_word(n)


pub rd_query_header(^igmp_memb_query_hdr_s query_hdr)
' Read IGMPv3 query header
    net[p_ndev].rd_block(@query_hdr, IGMPV3_QUERY_HDR_SZ)


pub rd_report_header(^igmp_memb_rep_hdr_s report_hdr) | n, rec
' Read IGMPv3 report header
    net[p_ndev].rd_block(@report_hdr, IGMPV3_REPORT_HDR_SZ)
    n := swap_word(report_hdr.num_records)
    repeat n with rec
        net[p_ndev].rd_block(@grp_record[rec], IGMPV3_GRP_RECORD_SZ)


pub rd_header(^igmp_memb_query_hdr_s query_hdr, ^igmp_grp_rec_s grp_record) | n, rec
' Read the IGMP header
    _fifo_start := net[p_ndev].fifo_rd_ptr()
    _type := net[p_ndev].rd_byte()

    case _type
        MEMBER_QUERY:
'            ser[pser].strln(@"[IGMP]: RD MEMBER_QUERY")
            net[p_ndev].rd_block(@query_hdr, IGMPV3_QUERY_HDR_SZ)
        MEMBER_REPORT_V3:
'            ser[pser].strln(@"[IGMP]: RD MEMBER_REPORT_V3")
            report_hdr.type := _type
            net[p_ndev].rd_block(@report_hdr+1, IGMPV3_REPORT_HDR_SZ)
            n := swap_word(report_hdr.num_records)
'            ser[pser].printf(@"[IGMP]: RD %d records\n\r", n)
            repeat n with rec
                net[p_ndev].rd_block(@grp_record[rec], IGMPV3_GRP_RECORD_SZ)


pub record_type(^igmp_grp_rec_s record): t
' Get the type field of a group record
'   r:          record number
'   Returns:    type
    return record.type


pub wr_member_query_header_to(^igmp_memb_query_hdr_s query_hdr, p_dest): l
' Write membership query header (RAM)
'   query_hdr:  query header (pointer to structure)
'   p_dest:     destination buffer (pointer)
    bytemove(p_dest, @query_hdr, IGMPV3_QUERY_HDR_SZ)
    return IGMPV3_QUERY_HDR_SZ


pub wr_member_report_header_to(^igmp_memb_rep_hdr_s report_hdr, ^igmp_grp_rec_s grp_record, p_dest): l | p, n, rec
' Write member report header (RAM)
'   report_hdr:     report header (pointer to structure)
'   p_dest:         destination buffer (pointer)
    p := p_dest

    report_hdr.type := MEMBER_REPORT_V3
    report_hdr.reserved := 0

    bytemove(p, @report_hdr, IGMPV3_REPORT_HDR_SZ)
    p += IGMPV3_REPORT_HDR_SZ


    n := report_num_records(@report_hdr)
    repeat n with rec
        bytemove(p, @grp_record[rec], IGMPV3_GRP_RECORD_SZ)
        p += IGMPV3_GRP_RECORD_SZ

    return p-p_dest


pub wr_header() | n, rec
' Write the IGMP header
    _fifo_start := net[p_ndev].fifo_wr_ptr()    ' remember the position of the header start
    _fifo_chksum := _fifo_start + 2             '   and the checksum field
    _msg_len := 0

    case _type
        MEMBER_QUERY:
            net[p_ndev].wr_block(@query_hdr, IGMPV3_QUERY_HDR_SZ)
            _msg_len += IGMPV3_QUERY_HDR_SZ
        MEMBER_REPORT_V3:
            report_hdr.type := MEMBER_REPORT_V3
            report_hdr.reserved := 0
            set_report_checksum(@report_hdr, 0)
            net[p_ndev].wr_block(@report_hdr, IGMPV3_REPORT_HDR_SZ)
            _msg_len += IGMPV3_REPORT_HDR_SZ
            n := report_num_records(@report_hdr)
            repeat n with rec
                net[p_ndev].wr_block(@grp_record[rec], IGMPV3_GRP_RECORD_SZ)
                _msg_len += IGMPV3_GRP_RECORD_SZ


pub update_query_checksum(^igmp_memb_query_hdr_s query_hdr) | tmp, ck, r
' Update IGMP checksum field (query header)
    set_query_checksum(@query_hdr, crc.inet_chksum(@query_hdr, IGMPV3_QUERY_HDR_SZ, 0, false) )
    tmp := net[p_ndev].fifo_wr_ptr()
    net[p_ndev].fifo_set_wr_ptr(_fifo_chksum)
    net[p_ndev].wr_word(query_hdr.checksum)
    net[p_ndev].fifo_set_wr_ptr(tmp)


pub update_report_checksum(^igmp_memb_rep_hdr_s report_hdr, ^igmp_grp_rec_s grp_record) | tmp, ck, r
' Update IGMP checksum field (report header)
    ck := crc.inet_chksum(...
            @report_hdr, ...
            IGMPV3_REPORT_HDR_SZ+1, ...
            0, ...
            false)
    repeat r from 0 to report_num_records(@report_hdr)-1
        ' fold each record into the checksum; only complement if it's the last one
        ck := crc.inet_chksum(...
                @grp_record[r], ...
                IGMPV3_GRP_RECORD_SZ, ...
                ck, ...
                (r == report_num_records(@report_hdr)-1) )
    set_report_checksum(@report_hdr, ck)

    tmp := net[p_ndev].fifo_wr_ptr()    ' write checksum and restore write pointer after
    net[p_ndev].fifo_set_wr_ptr(_fifo_chksum)
    net[p_ndev].wr_word(report_hdr.checksum)
    net[p_ndev].fifo_set_wr_ptr(tmp)


DAT
