{Spin2_v51}

#ifndef NET_COMMON
# include "net-common.spin2h"
#endif

#ifndef NETIF_DRIVER
# define NETIF_DRIVER "net.eth.enc28j60"
#endif

CON

    { limits }
    UDP_MSG_SZ      = 8                         ' message length


OBJ

    net=    NETIF_DRIVER                        ' network driver "virtual" instance
    crc:    "math.crc"


VAR

    long p_ndev                                 ' network driver object pointer

    long _fifo_start                            ' start of the datagram in the FIFO

    long _payload_checksum


pub init(optr)
' Set pointer to network device object
    p_ndev := optr


PUB new(^udp_hdr_s hdr, src_port, dest_port)
' Construct new UDP datagram
    set_src_port(@hdr, src_port)
    set_dest_port(@hdr, dest_port)
    set_chksum(@hdr, 0)
    wr_udp_header(@hdr)


PUB set_chksum(^udp_hdr_s hdr, ck)
' Set checksum (optional; set to 0 to ignore)
    hdr.checksum := swap_word(ck)


PUB set_dest_port(^udp_hdr_s hdr, p)
' Set destination port field
    hdr.dest_port := swap_word(p)


PUB set_dgram_len(^udp_hdr_s hdr, len)
' Set length of UDP datagram
'   NOTE: Don't include the 8-bytes of the UDP header itself
    len += UDP_MSG_SZ
    hdr.length := swap_word(len)


PUB set_src_port(^udp_hdr_s hdr, p)
' Set source port field
    hdr.src_port := swap_word(p)


PUB chksum(^udp_hdr_s hdr): c
' Get checksum
    return swap_word(hdr.checksum)


PUB dest_port(^udp_hdr_s hdr): p
' Get destination port field
    return swap_word(hdr.dest_port)


PUB dgram_len(^udp_hdr_s hdr): l
' Get length of UDP datagram
'   NOTE: This length includes the 8-bytes UDP header itself
    return swap_word(hdr.length)


PUB hdr_len(^udp_hdr_s hdr): l
' Get current header length
    return UDP_MSG_SZ


PUB payload_len(^udp_hdr_s hdr): l
' Get length of datagram
'   NOTE: This length is of the payload portion of the datagram only
    return dgram_len(@hdr)-UDP_MSG_SZ


PUB pseudo_header_cksum(src, dest, l=0, iv=0, co=true): ck | pseudo_hdr_s phdr
' Calculate UDP pseudo-header checksum
'   ip_src:     IPv4 source address
'   ip_dest:    IPv4 destination address
'   len:        payload length (optional; default is 0; do not include UDP header length)
'   iv:         initial value (optional; default is 0)
'   co:         complement the checksum (optional; default is yes)
'   Returns:    checksum
    phdr~
    phdr.src_ip :=      swap_long(src)          ' swap to network byte order
    phdr.dest_ip :=     swap_long(dest)         '
    phdr.l4_proto :=    (L4_UDP << 8) | 0       ' b15..8: layer 4 protocol, b7..0: reserved
    phdr.len :=         swap_word(l)            ' UDP header + payload len

    if ( co )
        return crc.inet_chksum(@phdr, 12, iv)
    else
        return crc.inet_chksum(@phdr, 12, iv, false)


PUB src_port(^udp_hdr_s hdr): p
' Get source port field
    return swap_word(hdr.src_port)


PUB reset_udp(^udp_hdr_s hdr)
' Reset all values to defaults
    hdr~


PUB rd_udp_header(^udp_hdr_s hdr): l
' Read/disassemble UDP header
'   Returns: network device FIFO write position
    net[p_ndev].rd_block(@hdr, UDP_MSG_SZ)

    return net[p_ndev].fifo_wr_ptr()


pub set_payload_checksum(ck)
' Set checksum of the payload data
    _payload_checksum := ck


pub start_pos(): p
' Get the start position of the last written UDP message in the FIFO
    return _fifo_start


pub update_checksum(^udp_hdr_s hdr, lip, rip, len=0): ck | tmp, pck
' Update the checksum in the TCP header
'   lip:        local/source IP for pseudo-header checksum
'   rip:        remote/destination IP for pseudo-header checksum
'   len:        payload length (optional; default is 0)
'   Returns:    UDP checksum
    set_chksum(@hdr, 0)                             ' init checksum field to 0

    ' calc pseudo-header checksum seeded by the payload data checksum
    ' then feed that into the UDP header checksum
    pck := pseudo_header_cksum(lip, rip, UDP_MSG_SZ+len, _payload_checksum, false)
    ck := crc.inet_chksum(@hdr, UDP_MSG_SZ, pck, true)

    ' write the checksum back to the UDP header and restore the FIFO write pointer afterwards
    tmp := net[p_ndev].fifo_wr_ptr()
    net[p_ndev].fifo_set_wr_ptr(_fifo_start + UDP_CKSUM)
    net[p_ndev].wr_word( swap_word(ck) )
    net[p_ndev].fifo_set_wr_ptr(tmp)


pub wr_checksum_to(^udp_hdr_s hdr, p_dest, lip, rip, len=0, p_pld=0): ck | tmp
' Calculate and write UDP checksum
'   p_dest:     location to write checksum (pointer)
'   lip:        local IP
'   rip:        remote IP
'   len:        length of payload data (optional; default is 0)
'   p_pld:      payload data (pointer; optional; ignored if len == 0)
'   Returns:    checksum in network byte order

    set_chksum(@hdr, 0)                               ' init checksum field to 0

    ' calc pseudo-header checksum seeded by the payload data checksum
    ' then feed that into the UDP header checksum
    ck := 0
    if ( len )
        ck := crc.inet_chksum(p_pld, len, 0, false)
    ck := pseudo_header_cksum(lip, rip, UDP_MSG_SZ+len, ck, false)
    ck := crc.inet_chksum(@hdr, UDP_MSG_SZ, ck, true)

    ' write/return the checksum
    ck := swap_word(ck)                         ' swap to network byte order
    word[p_dest] := ck


PUB update_len_chksum(^udp_hdr_s hdr, len) | tmp, c
' Update the UDP header length and checksum
'   len:    datagram length
    set_dgram_len(@hdr, len)
    tmp := net[p_ndev].fifo_wr_ptr()            ' remember the current fifo pointer
    net[p_ndev].fifo_set_wr_ptr(start_pos()+UDP_DGRAMLEN)
    net[p_ndev].wr_word(hdr.length)             ' write the new length
    net[p_ndev].fifo_set_wr_ptr(tmp)            ' restore the write pointer


PUB wr_udp_header(^udp_hdr_s hdr): ptr
' Write/assemble UDP header
'   Returns: length of assembled header, in bytes
    _fifo_start := net[p_ndev].fifo_wr_ptr()    ' save this FIFO position as the start of UDP
    net[p_ndev].wr_block(@hdr, sizeof(hdr) )

    return net[p_ndev].fifo_wr_ptr()


PUB wr_udp_header_to(^udp_hdr_s hdr, p_dest): ptr
' Write/assemble UDP header
'   Returns: length of assembled header, in bytes
    bytemove(p_dest, @hdr, sizeof(hdr))


DAT
