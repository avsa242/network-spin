{Spin2_v51}

#ifndef NET_COMMON
#include "net-common.spin2h"
#endif

CON

    { limits }
    ARP_MSG_SZ      = 28                        ' message length
    ENTRIES         = 10                        ' ARP cache entries (RAM usage: n * 12 bytes)


    ' protocol types
    PROTO_TYPE_IP   = $0800


    { opcodes }
    ARP_REQ         = 1
    ARP_REPL        = 2
    RARP_REQ        = 3
    RARP_REPL       = 4
    DRARP_REQ       = 5
    DRARP_REPL      = 6
    DRARP_ERR       = 7
    INARP_REQ       = 8
    INARP_REPL      = 9


OBJ

    net=    NETIF_DRIVER                        ' network device driver "virtual" instance


VAR

    long p_ndev                                 ' network driver object pointer
    ^arp_msg_s  hdr
    arp_entry_s entry[ENTRIES]


PUB init(netdev_ptr)
' Set pointer to network device object
    p_ndev := netdev_ptr


PUB set_header(p_hdr)
' Point to an ARP header structure
    [hdr] := p_hdr


PUB cache_entry(hw_addr, proto_addr, ptype=PROTO_TYPE_IP): e | m
' Cache an entry in the ARP table
    { check for an existing entry with this protocol address first }
    if ( is_multicast(proto_addr) )
        return -11                              ' error: can't cache multicast addresses
    e := proto_addr_entry(proto_addr)
    if ( e >= 0 )
        { found an existing entry: update it with the new hardware address }
        bytemove(@entry[e].hw_addr, hw_addr, MACADDR_LEN)
        if ( hw_addr_valid(hw_addr) and entry[e].proto_addr <> 0 )
            entry[e].resolved := 1
    else
        { not found: create a new entry }
        repeat e from 0 to (ENTRIES-1)
            ifnot ( entry[e].proto_t )
                bytemove(@entry[e].hw_addr, hw_addr, MACADDR_LEN)
                entry[e].proto_addr := proto_addr
                entry[e].proto_t := ptype
                if ( hw_addr_valid(hw_addr) and entry[e].proto_addr <> 0 )
                    entry[e].resolved := 1
                return
        return -10                              ' cache full; no entries available


PUB cache_update_hw_addr(e, p_hwaddr)
' Update the hardware address for a cache entry
'   e:          entry number
'   p_hwaddr:   hardware address (pointer)
    bytefill(@entry[e].hw_addr, 0, MACADDR_LEN)
    bytemove(@entry[e].hw_addr, p_hwaddr, MACADDR_LEN)
    if ( hw_addr_valid(@entry[e].hw_addr) and (entry[e].proto_addr <> 0) )
        entry[e].resolved := 1


PUB cached_proto_addr(e): a
' Get a cached entry's protocol address
'   Returns:    protocol address (little-endian)
    return swap_long(entry[e].proto_addr)


PUB cached_proto_type(e): t
' Get a cached entry's protocol address type
'   Returns:    protocol address type (big-endian)
    return entry[e].proto_t


PUB cached_hw_addr(e): a
' Get a cached entry's hardware address
'   Returns:    hardware address (pointer)
    return @entry[e].hw_addr


PUB clear()
' Clear the currently buffered ARP message
    'message~
    hdr~

PUB drop_entry(e)
' Drop a cached entry from the ARP table
    entry[e]~


PUB entry_is_used(e): f
' Flag indicating entry in the ARP table is used
    return ( entry[e].proto_t <> 0 )


var byte _macaddr_tmp[MACADDR_LEN]
pub hw_addr_of(ip): hw | e
' Read an entry from the cache by IP address
'   ip:         protocol (IPv4) address to resolve
'   Returns:
'           pointer to hardware (MAC) address associated with IPv4 address on success
'           0 on failure
    if ( is_multicast(ip) )
        ' IP is a multicast address
        bytefill(@_macaddr_tmp, 0, MACADDR_LEN)
        _macaddr_tmp[0] := $01
        _macaddr_tmp[1] := $00
        _macaddr_tmp[2] := $5e
        _macaddr_tmp[3] := ip.byte[2] & $7f     ' use the lower 23 bits of the address in the MAC
        _macaddr_tmp[4] := ip.byte[1]
        _macaddr_tmp[5] := ip.byte[0]
        return @_macaddr_tmp
    else
        ' IP is a unicast address
        e := proto_addr_entry(ip)
        if ( e >= 0 )
            return @entry[e].hw_addr

    return 0


PUB hw_addr_len(): l
' Get hardware address length
'   Returns:    byte
    return hdr.hw_addr_len


pub hw_addr_valid(p_addr): f
' Check if a hardware/MAC address is valid (non-zero)
'   p_addr: pointer to MAC address
'   Returns:    TRUE (-1) or FALSE (0)
    return bytecomp(p_addr, @_mac_zero, MACADDR_LEN) <> true


PUB hw_ent(e): p
' Calculate the pointer to a hardware address in the ARP table, given an entry number
'   e:     entry number (1..(ENTRIES-1) )
'   Returns:    pointer to hardware address (OUI first)
    return @entry[e].hw_addr


PUB hw_type(): t
' Get hardware/hardware address type
'   Returns:    word
    return swap_word(hdr.hw_t)


pub is_multicast(ip): f
' Check if an IP address is a multicast address
'   ip: IPv4 address
'   Returns:    TRUE (-1) or FALSE (0)
    return ( (ip >= $e0_00_00_00) and (ip <= $ef_ff_ff_ff) )


pub is_resolved(paddr): f | e
' Check if ARP has resolved an IP address
'   paddr:  protocol/IP address
'   Returns:    TRUE (-1) or FALSE (0)
    f := false
    e := proto_addr_entry(paddr)
    if ( (e >= 0) and entry[e].resolved )
        return true


pub last_probe(paddr): t | e
' Get the last time a protocol address was probed for
'   paddr:      protocol address
'   Returns:    last time an ARP probe was sent for this IP
'               -1 if the IP isn't in the cache
    e := proto_addr_entry(paddr)
    if ( e >= 0 )
        return entry[e].last_checked
    else
        return -1


PUB opcode(): o'xxx verify return size & swap
' Get ARP operation code
'   Returns:    byte
    return swap_word(hdr.opcode)


PUB proto_addr_len(): l
' Get protocol address length
'   Returns:    byte
    return hdr.proto_addr_len


PUB proto_type(): p
' Get protocol/protocol address type
'   Returns:    word
    return swap_word(hdr.proto_t)


PUB read_entry(e): h, p
' Read an entry from the cache
'   Returns:    pointer to HW address, protocol address
    return hw_ent(e), entry[e].proto_addr


PUB proto_addr_entry(paddr): e
' Find an entry in the ARP table by its protocol address
'   proto_addr: protocol address (4 bytes)
'   Returns:    entry number in ARP table, or -1 if not found
    repeat e from 0 to (ENTRIES-1)
        if ( entry_is_used(e) and (entry[e].proto_addr == paddr) )
            return e

    return -1


pub read_entry_ip(e): p
' Read an entry from the cache
'   Returns:    32-bit IP address
    return entry[e].proto_addr


pub read_entry_mac(e): h
' Read an entry from the cache
'   Returns:    pointer to HW address
    return hw_ent(e)


PUB reply(): p
' Set up next ARP message to "reply" to the previous
    set_opcode(ARP_REPL)
    swap_sender_target()

    return wr_arp_msg()


PUB swap_sender_target() | ip_tmp
' Swap the sender and target fields
    ' temporarily store the current sender address
    ip_tmp := target_proto_addr()
    set_target_hw_addr( sender_hw_addr() )
    set_target_proto_addr( sender_proto_addr() )
    set_sender_hw_addr(net[p_ndev].my_mac() )
    set_sender_proto_addr(ip_tmp)

PUB sender_hw_addr(): h
' Get sender hardware address
'   Returns:    pointer to 6-byte MAC address
    return @hdr.sender_hw_addr


PUB sender_proto_addr(): p
' Get sender protocol address
'   Returns:    4-byte IPv4 address, packed into long
    return swap_long(hdr.sender_proto_addr)


PUB target_hw_addr(): h
' Get target hardware address
'   Returns:    pointer to 6-byte MAC address
    return @hdr.target_hw_addr


PUB target_proto_addr(): p
' Get target protocol address
'   Returns:    4-byte IPv4 address, packed into long
    return swap_long(hdr.target_proto_addr)


PUB preset_ethii_ipv4()
' Set up the ARP message for Ethernet hardware addresses, and IPv4 protocol addresses
    set_hw_addr_len(MACADDR_LEN)
    set_hwtype(HRD_ETH)
    set_proto_addr_len(IPV4ADDR_LEN)
    set_proto_type(PROTO_TYPE_IP)


PUB set_hw_addr_len(len)
' Set hardware address length
    hdr.hw_addr_len := len


PUB set_hwtype(hrd)
' Set hardware type
    hdr.hw_t := swap_word(hrd)


PUB set_opcode(op)
' Set ARP operation code
    hdr.opcode := swap_word(op)


PUB set_proto_addr_len(len)
' Set protocol address length
    hdr.proto_addr_len := len


PUB set_proto_type(pro)
' Set protocol type
    hdr.proto_t := swap_word(pro)


PUB set_sender_hw_addr(p_addr=0)
' Set sender hardware address
    if ( p_addr )
        bytemove(@hdr.sender_hw_addr, p_addr, MACADDR_LEN)
    else
        bytefill(@hdr.sender_hw_addr, 0, MACADDR_LEN)


PUB set_sender_proto_addr(addr)
' Set sender protocol address
'   addr:   32-bit IP address (LE)
    hdr.sender_proto_addr := swap_long(addr)    ' swap to network byte order


PUB set_target_hw_addr(p_addr=0)
' Set target hardware address
    if ( p_addr )
        bytemove(@hdr.target_hw_addr, p_addr, MACADDR_LEN)
    else
        bytefill(@hdr.target_hw_addr, $00, MACADDR_LEN)


PUB set_target_proto_addr(addr)
' Set target protocol address
'   addr:   32-bit IP address (LE)
    hdr.target_proto_addr := swap_long(addr)    ' swap to network byte order


PUB rd_arp_msg(): p
' Read ARP message
'   Returns:    network driver current FIFO write pointer
    hdr~
    hdr.hw_t :=                 net[p_ndev].rd_word()
    hdr.proto_t :=              net[p_ndev].rd_word()
    hdr.hw_addr_len :=          net[p_ndev].rd_byte()
    hdr.proto_addr_len :=       net[p_ndev].rd_byte()
    hdr.opcode :=               net[p_ndev].rd_word()
    net[p_ndev].rd_block        (@hdr.sender_hw_addr, MACADDR_LEN)
    hdr.sender_proto_addr :=    net[p_ndev].rd_long()
    net[p_ndev].rd_block        (@hdr.target_hw_addr, MACADDR_LEN)
    hdr.target_proto_addr :=    net[p_ndev].rd_long()

    return net[p_ndev].fifo_wr_ptr()


PUB probe(my_hwa, my_paddr)
' Send an ARP Probe
'   my_hwa:     this node's hardware address (pointer)
'   my_paddr:   this node's protocol address
    preset_ethii_ipv4()
    set_opcode(ARP_REQ)
    set_sender_hw_addr(my_hwa)
    set_sender_proto_addr(0)               ' ensure no mapping between these two so remote
    set_target_hw_addr()                     '   hosts don't update their ARP cache
    set_target_proto_addr(my_paddr)
    wr_arp_msg()


PUB who_has(my_proto_addr, proto_addr)
' Send a query for a protocol address
    set_hw_addr_len(MACADDR_LEN)
    set_hwtype(HRD_ETH)
    set_opcode(ARP_REQ)
    set_proto_addr_len(IPV4ADDR_LEN)
    set_proto_type(PROTO_TYPE_IP)

    { who has d.d.d.d? }
    set_target_hw_addr(@_mac_zero)
    set_target_proto_addr(proto_addr)

    { tell d.d.d.d (xx:xx:xx:xx:xx:xx) }
    set_sender_hw_addr(net[p_ndev].my_mac())
    set_sender_proto_addr(my_proto_addr)

    wr_arp_msg()


PUB wr_arp_msg(): p
' Write ARP message
    net[p_ndev].wr_word(hdr.hw_t)
    net[p_ndev].wr_word(hdr.proto_t)
    net[p_ndev].wr_byte(hdr.hw_addr_len)
    net[p_ndev].wr_byte(hdr.proto_addr_len)
    net[p_ndev].wr_word(hdr.opcode)
    net[p_ndev].wr_block(@hdr.sender_hw_addr, MACADDR_LEN)
    net[p_ndev].wr_long(hdr.sender_proto_addr)
    net[p_ndev].wr_block(@hdr.target_hw_addr, MACADDR_LEN)
    net[p_ndev].wr_long(hdr.target_proto_addr)

    return net[p_ndev].fifo_wr_ptr()


DAT
