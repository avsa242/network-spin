{Spin2_v46}

#ifndef NET_COMMON
#include "net-common.spin2h"
#endif

CON

    { limits }
    ARP_MSG_SZ      = 28                        ' message length
    ENTRIES         = 10                        ' ARP cache entries (RAM usage: n * 12 bytes)

    struct arp_entry_s(...
        word        proto_t, ...
        long        proto_addr, ...
        macaddr_s   hw_addr)

    struct arp_msg_s(...
        word        hw_t, ...
        word        proto_t, ...
        byte        hw_addr_len, ...
        byte        proto_addr_len, ...
        word        opcode, ...
        macaddr_s   sender_hw_addr, ...
        long        sender_proto_addr, ...
        macaddr_s   target_hw_addr, ...
        long        target_proto_addr)

    ' protocol types
    PROTO_TYPE_IP   = $0800


    { opcodes }
    ARP_REQ         = 1
    ARP_REPL        = 2
    RARP_REQ        = 3
    RARP_REPL       = 4
    DRARP_REQ       = 5
    DRARP_REPL      = 6
    DRARP_ERR       = 7
    INARP_REQ       = 8
    INARP_REPL      = 9


OBJ

    net=    NETIF_DRIVER                        ' network device driver "virtual" instance


VAR

    long p_ndev                                 ' network driver object pointer

    arp_entry_s entry[ENTRIES]
    arp_msg_s   message


PUB init(netdev_ptr)
' Set pointer to network device object
    p_ndev := netdev_ptr


PUB cache_entry(hw_addr, proto_addr, ptype): e | m
' Cache an entry in the ARP table
    { check for an existing entry with this protocol address first }
    e := read_entry_by_proto_addr(proto_addr)
    if ( e >= 0 )                               ' 0 is _always_ the entry for our own node
        { found an existing entry: update it with the new hardware address }
        bytemove(@entry[e].hw_addr, hw_addr, MACADDR_LEN)
    else
        { not found: create a new entry }
        repeat e from 0 to (ENTRIES-1)
            ifnot ( entry[e].proto_t )
                bytemove(@entry[e].hw_addr, hw_addr, MACADDR_LEN)
                entry[e].proto_addr := proto_addr
                entry[e].proto_t := ptype
                return
        return -10                              ' cache full; no entries available


PUB cache_update_hw_addr(e, p_hwaddr)
' Update the hardware address for a cache entry
'   e:          entry number
'   p_hwaddr:   hardware address (pointer)
    bytefill(@entry[e].hw_addr, 0, MACADDR_LEN)
    bytemove(@entry[e].hw_addr, p_hwaddr, MACADDR_LEN)


PUB cached_proto_addr(e): a
' Get a cached entry's protocol address
'   Returns:    protocol address (little-endian)
    return swap_long(entry[e].proto_addr)


PUB cached_proto_type(e): t
' Get a cached entry's protocol address type
'   Returns:    protocol address type (big-endian)
    return entry[e].proto_t


PUB cached_hw_addr(e): a
' Get a cached entry's hardware address
'   Returns:    hardware address (pointer)
    return @entry[e].hw_addr


PUB clear()
' Clear the currently buffered ARP message
    message~


PUB drop_entry(e)
' Drop a cached entry from the ARP table
    entry[e]~


PUB entry_is_used(e): f
' Flag indicating entry in the ARP table is used
    return ( entry[e].proto_t <> 0 )


pub find_mac_by_ip(ip): hw | tmp
' Read an entry from the cache by IP address
    tmp := read_entry_by_proto_addr(ip)
    if ( tmp >= 0 )
        return hw_ent( tmp )


PUB hw_addr_len(): l
' Get hardware address length
'   Returns:    byte
    return message.hw_addr_len


PUB hw_ent(e): p
' Calculate the pointer to a hardware address in the ARP table, given an entry number
'   e:     entry number (1..(ENTRIES-1) )
'   Returns:    pointer to hardware address (OUI first)
    return @entry[e].hw_addr


PUB hw_type(): t
' Get hardware/hardware address type
'   Returns:    word
    return swap_word(message.hw_t)


PUB opcode(): o
' Get ARP operation code
'   Returns:    byte
    return swap_word(message.opcode)


PUB proto_addr_len(): l
' Get protocol address length
'   Returns:    byte
    return message.proto_addr_len


PUB proto_type(): p
' Get protocol/protocol address type
'   Returns:    word
    return swap_word(message.proto_t)


PUB read_entry(e): h, p
' Read an entry from the cache
'   Returns:    pointer to HW address, protocol address
    return hw_ent(e), entry[e].proto_addr


PUB read_entry_by_proto_addr(proto_addr): e
' Find an entry in the ARP table by its protocol address
'   proto_addr: protocol address (4 bytes)
'   Returns:    entry number in ARP table, or -1 if not found
    repeat e from 0 to (ENTRIES-1)
        if ( entry_is_used(e) and (entry[e].proto_addr == proto_addr) )
            return e

    return -1


pub read_entry_ip(e): p
' Read an entry from the cache
'   Returns:    32-bit IP address
    return entry[e].proto_addr


pub read_entry_mac(e): h
' Read an entry from the cache
'   Returns:    pointer to HW address
    return hw_ent(e)


PUB reply(): p
' Set up next ARP message to "reply" to the previous
    set_opcode(ARP_REPL)
    swap_sender_target()

    return wr_arp_msg()


PUB swap_sender_target() | ip_tmp
' Swap the sender and target fields
    ' temporarily store the current sender address
    ip_tmp := target_proto_addr()
    set_target_hw_addr( sender_hw_addr() )
    set_target_proto_addr( sender_proto_addr() )
    set_sender_hw_addr( net[p_ndev].my_mac() )
    set_sender_proto_addr( ip_tmp )

PUB sender_hw_addr(): h
' Get sender hardware address
'   Returns:    pointer to 6-byte MAC address
    return @message.sender_hw_addr


PUB sender_proto_addr(): p
' Get sender protocol address
'   Returns:    4-byte IPv4 address, packed into long
    return swap_long(message.sender_proto_addr)


PUB target_hw_addr(): h
' Get target hardware address
'   Returns:    pointer to 6-byte MAC address
    return @message.target_hw_addr


PUB target_proto_addr(): p
' Get target protocol address
'   Returns:    4-byte IPv4 address, packed into long
    return swap_long(message.target_proto_addr)


PUB preset_ethii_ipv4()
' Set up the ARP message for Ethernet hardware addresses, and IPv4 protocol addresses
    set_hw_addr_len(MACADDR_LEN)
    set_hwtype(HRD_ETH)
    set_proto_addr_len(IPV4ADDR_LEN)
    set_proto_type(PTYPE_IP)


PUB set_hw_addr_len(len)
' Set hardware address length
    message.hw_addr_len := len


PUB set_hwtype(hrd)
' Set hardware type
    message.hw_t := swap_word(hrd)


PUB set_opcode(op)
' Set ARP operation code
    message.opcode := swap_word(op)


PUB set_proto_addr_len(len)
' Set protocol address length
    message.proto_addr_len := len


PUB set_proto_type(pro)
' Set protocol type
    message.proto_t := swap_word(pro)


PUB set_sender_hw_addr(p_addr=0)
' Set sender hardware address
    if ( p_addr )
        bytemove(@message.sender_hw_addr, p_addr, MACADDR_LEN)
    else
        bytefill(@message.sender_hw_addr, 0, MACADDR_LEN)


PUB set_sender_proto_addr(addr)
' Set sender protocol address
    message.sender_proto_addr := swap_long(addr)


PUB set_target_hw_addr(p_addr=0)
' Set target hardware address
    if ( p_addr )
        bytemove(@message.target_hw_addr, p_addr, MACADDR_LEN)
    else
        bytefill(@message.target_hw_addr, $00, MACADDR_LEN)


PUB set_target_proto_addr(addr)
' Set target protocol address
    message.target_proto_addr := swap_long(addr)


PUB rd_arp_msg(): p
' Read ARP message
'   Returns:    network driver current FIFO write pointer
    message.hw_t :=                 net[p_ndev].rd_word()
    message.proto_t :=              net[p_ndev].rd_word()
    message.hw_addr_len :=          net[p_ndev].rd_byte()
    message.proto_addr_len :=       net[p_ndev].rd_byte()
    message.opcode :=               net[p_ndev].rd_word()
    net[p_ndev].rd_block            (@message.sender_hw_addr, MACADDR_LEN)
    message.sender_proto_addr :=    net[p_ndev].rd_long()
    net[p_ndev].rd_block            (@message.target_hw_addr, MACADDR_LEN)
    message.target_proto_addr :=    net[p_ndev].rd_long()

    return net[p_ndev].fifo_wr_ptr()


PUB probe(my_hwa, my_paddr)
' Send an ARP Probe
'   my_hwa:     this node's hardware address (pointer)
'   my_paddr:   this node's protocol address
    preset_ethii_ipv4()
    set_opcode(ARP_REQ)
    set_sender_hw_addr(my_hwa)
    set_sender_proto_addr(0)                    ' ensure no mapping between these two so remote
    set_target_hw_addr()                        '   hosts don't update their ARP cache
    set_target_proto_addr(my_paddr)
    wr_arp_msg()


PUB who_has(my_proto_addr, proto_addr)
' Send a query for a protocol address
    set_hw_addr_len(MACADDR_LEN)
    set_hwtype(HRD_ETH)
    set_opcode(ARP_REQ)
    set_proto_addr_len(IPV4ADDR_LEN)
    set_proto_type(ETYP_IPV4)

    { who has d.d.d.d? }
    set_target_hw_addr(@_mac_zero)
    set_target_proto_addr(proto_addr)

    { tell d.d.d.d (xx:xx:xx:xx:xx:xx) }
    set_sender_hw_addr(hw_ent(0))
    set_sender_proto_addr(my_proto_addr)

    wr_arp_msg()


PUB wr_arp_msg(): p
' Write ARP message
    net[p_ndev].wr_word(message.hw_t)
    net[p_ndev].wr_word(message.proto_t)
    net[p_ndev].wr_byte(message.hw_addr_len)
    net[p_ndev].wr_byte(message.proto_addr_len)
    net[p_ndev].wr_word(message.opcode)
    net[p_ndev].wr_block(@message.sender_hw_addr, MACADDR_LEN)
    net[p_ndev].wr_long(message.sender_proto_addr)
    net[p_ndev].wr_block(@message.target_hw_addr, MACADDR_LEN)
    net[p_ndev].wr_long(message.target_proto_addr)

    return net[p_ndev].fifo_wr_ptr()


DAT
