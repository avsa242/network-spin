{Spin2_v51}

#ifndef NETIF_DRIVER
# warn "no network interface driver specified; defaulting to ENC28J60"
# define NETIF_DRIVER "net.eth.enc28j60"
# pragma exportdef(NETIF_DRIVER)
#endif

#include "net-common.spin2h"
#include "socket-common.spin2"


con

    ' limits
    MAX_INTERFACES      = 1
    MAX_IP_PER_IFACE    = 1
    MAX_IP6_PER_IFACE   = 1
    MAX_SOCKETS         = 2                     ' must be at least 1 (or 2 for a server)
    MAX_MC_GROUPS_IFACE = 1
    MAX_MC_SOURCES_IFACE= 64
    FRAME_HEADROOM_SZ   = 128                   ' 128 should cover any type of frame

    ' structure definitions
    struct netcmd_s(...
        long command, ...
        long parameter[3])

    struct group_s(...
        long grp_addr, ...
        byte filt_mode, ...
        byte nr_sources, ...
        long source[MAX_MC_SOURCES_IFACE], ...
        byte refcnt, ...
        byte report_pending)

    struct iface_s(...
        long        ipv4_addr[MAX_IP_PER_IFACE], ...
        long        flags, ...
        byte        mac_addr[MACADDR_LEN], ...
        ipv6_addr_s ipv6_addr[MAX_IP6_PER_IFACE], ...
        group_s     mc_group[MAX_MC_GROUPS_IFACE], ...
        byte        link_state)

    PKTBUFF_CNT     = 8
    PKTBUFF_MASK    = PKTBUFF_CNT-1
    struct pktbuff_s(...
        long p_data, ...
        long p_end, ...
        long len, ...
        byte layer_written, ...
        byte buffer[FRAME_HEADROOM_SZ+RINGBUFF_SZ])

    ARP_REQSQ_SZ     = 4
    ARP_REQSQ_MASK   = ARP_REQSQ_SZ-1
    struct arp_requestq_ent_s(...
        long ip_addr, ...
        long last_try, ...
        long pbuf, ...
        byte type)

    struct arp_requestq_s(...
        long head, ...
        long tail, ...
        arp_requestq_ent_s  entry[ARP_REQSQ_SZ])

    ARP_REPLQ_SZ    = 4
    ARP_REPLQ_MASK  = ARP_REPLQ_SZ-1
    struct arp_replyq_ent_s(...
        long pbuf)
    struct arp_replyq_s(...
        long head, ...
        long tail, ...
        arp_replyq_ent_s    entry[ARP_REPLQ_SZ])


    MAX_TCP_TX_PENDING  = 4
    MAX_TCP_TX_PEND_MASK= MAX_TCP_TX_PENDING-1
    struct tcp_tx_pend_s(...
        byte head, ...
        byte tail, ...
        byte index[MAX_TCP_TX_PENDING])


    ' messages to netloop
    CMD_CONNECT         = 1                     ' connect a socket
    CMD_DISCONNECT      = 2                     ' disconnect a socket
    CMD_PUSH            = 3                     ' deliver a TCP datagram immediately
    CMD_SET_IF_FLAGS    = 4

    ' interface flags
    IF_PROMISCUOUS      = 1 << 0
    IF_MULTICAST_EN     = 1 << 1


    ' socket options
    #1, IP_TTL, IP_MULTICAST_IF, IP_MULTICAST_TTL, IP_ADD_MEMBERSHIP, IP_DROP_MEMBERSHIP, ...
    IP_ADD_SOURCE_MEMBERSHIP, IP_DROP_SOURCE_MEMBERSHIP, IP_BLOCK_SOURCE


    ' error codes
    OK                  = 0


obj

    net:    NETIF_DRIVER
    ethii:  "protocol.net.eth-ii"
    ip:     "protocol.net.ip"
    arp:    "protocol.net.arp"
    icmp:   "protocol.net.icmp"
    igmp:   "protocol.net.igmp"
    udp:    "protocol.net.udp"
    tcp:    "protocol.net.tcp"
    str:    "string"
    math:   "math.int"
    crc:    "math.crc"
    netstr: "net-util"


var

    iface_s         interface[MAX_INTERFACES]   ' network interfaces
    socket_s        socket[MAX_SOCKETS]         ' socket structures
    netcmd_s        netcmd                      ' command interface to the network stack cog
    arp_requestq_s  arp_request_q               ' ARP resolution queue
    arp_replyq_s    arp_reply_q                 ' ARP reply queue
    pktbuff_s       pktbuff[PKTBUFF_CNT]        ' transmit packet buffer queue
    tcp_tx_pend_s   tcp_tx_pend                 ' pending TCP transmission queue

    long            _cog
    long            _timestamp_base
    long            pb_head, pb_tail


con NET_STACK_SZ    = 400
pub start(CS, SCK, MOSI, MISO, SPI_FREQ=10_000_000): s | st
' Start the network device driver and the network processing loop
'   CS:         SPI Chip Select
'   SCK:        SPI Clock
'   MOSI:       Master-Out Slave-In
'   MISO:       Master-In Slave-Out
'   SPI_FREQ:   SPI bus frequency (default is 10_000_000)
    cogspin(NEWCOG, cog_stack(CS, SCK, MOSI, MISO, SPI_FREQ), @_netstack_stk)+1

    ' wait up to one second for the network driver signal it's started
    st := getms()
    repeat
        if ( _cog )
            return _cog
    until ( (getms()-st) > 1_000 )

    return false


pub accept(ls): cs
' Accept a new connection from a listening socket
'   ls:         listening socket number
'   Returns:    socket number of new connection on success
'               -1 if the given socket isn't a valid listening socket
'               -2 if there are no incoming connections pending yet
    if ( socket[ls].state <> LISTENING )
        DEBUG("accept(): error: socket ", udec_(ls), " isn't in LISTENING state")
        return -1                               ' error: socket isn't a listening socket
    cs := socket[ls].backlog.head

    if ( cs < 0 )
        return -2                               ' no connections waiting

    socket[ls].backlog.head := socket[cs].backlog.pnext
    socket[ls].backlog.pending--                ' decrement listener's pending connections 
    if ( socket[ls].backlog.head < 0 )
        socket[ls].backlog.tail := -1
{
    DEBUG(  "head=", udec_(socket[ls].backlog.head), ...
            " backlog=", udec_(socket[ls].backlog.pending), ...
            " tail=", udec_(socket[ls].backlog.tail), ...
            " cs=", udec_(cs) )
}
    return cs


pub bind(sck, lip, lp=0): s | i
' Bind an address to a socket
'   sck:        socket number
'   lip:        local IP address (little-endian/Propeller byte order)
'   lp:         local port (optional; a random value will be selected if omitted)
'   Returns:    0 on success
'               negative numbers on failure

    DEBUG("bind(): ")
    ifnot ( socket[sck].local_ip )              ' make sure this socket isn't already bound
        if ( lookup_iface(lip) >= 0 )
            socket[sck].local_ip := lip
            ifnot ( lp )                        ' choose a random ephemeral port number if
                lp := 49152+math.rndi(16383)    '   one wasn't specified
            socket[sck].local_port := lp
            DEBUG(  "socket ", udec_(sck), ...
                    "ip: ", zstr_(str.iptostr(socket[sck].local_ip)), ...
                    "mac: ", zstr_(str.mactostr( arp.hw_addr_of(socket[sck].local_ip) ) ) )
            return OK
        DEBUG(" error: no such interface")
        return -1
    else
        DEBUG(" error: address already in use")
        return -2


pub connect(sck, rip, rp): s | st, tmo
' Connect a socket to a remote host
'   sck:    socket number
'   rip:    remote IP
'   rp:     remote port
'   Returns:
'       0 on success
'       -1 on failure (invalid argument)
'       -2 on failure (connection timed out)

'   NOTE: This method will block until the connection succeeds or the timeout (30sec) is reached,
'       whichever is first.
'       For non-blocking behavior, set the SOCK_NONBLOCK option on your socket. Then (optionally),
'       poll() can be used to wait for a specific connection state.

    s := 0
    if ( (socket[sck].protocol == L4_TCP) and ip.is_multicast_addr(rip) )
        return -1                               ' error: TCP is unicast only

    longmove(@netcmd.parameter[0], @sck, 3)

    DEBUG(  "connect(", udec_(netcmd.parameter[0]), zstr_(str.iptostr(netcmd.parameter[1]) ), udec_(netcmd.parameter[2]), ")")
    netcmd.command := CMD_CONNECT

    if ( socket[sck].options & SOCK_NONBLOCK )
        return 0                                ' socket is non-blocking type; return success now

    st := getms()
    tmo := 30_000
    repeat                                      ' wait for connection to succeed (up to 30sec)
        if ( socket[sck].state == ESTABLISHED )
            return 0                            ' connection established
    until ( (getms() - st) > tmo )

    return -2                                   ' error: timeout connecting


pub disconnect(sck)
' Disconnect a socket
'   sck:    socket number
    netcmd.parameter[0] := sck
    netcmd.command := CMD_DISCONNECT


pub poll(sck, st, tmo=30_000): s | tst
' Wait for a socket to reach a specific state
'   sck:    socket number
'   st:     socket state
'   tmo:    timeout in milliseconds (optional; default is 30_000, or 30 seconds)
'   Returns:    0 if socket's state reaches that specified
'               -1 on timeout
    tst := getms()
    repeat
        if ( socket[sck].state == st )          ' state matches
            return 0
    while ( (getms() - tst) < tmo )             ' loop until timeout reached

    return -1                                   ' error: timeout


pub new_socket(proto=0): p | sck
' Find/allocate a free socket
'   proto:      layer-4 protocol (optional; L4_UDP, L4_TCP)
'   Returns:    socket number on success
'               negative numbers on failure

    DEBUG("new_socket()")
    repeat MAX_SOCKETS with sck
        if ( socket[sck].state == UNUSED )
            DEBUG("socket ", udec_(sck), " available ")
            socket[sck].protocol := proto
            set_state(sck, CLOSED)
            return sck

    DEBUG(" error: no free sockets")
    return -1


pub listen(port, bl=5): s | svn, sck
' Set up a socket to listen on a port
'   port:       port to listen
'   bl:         pending connection backlog queue depth (default is 5 if unspecified)
'   Returns:    socket number on success
'               negative numbers on failure
    DEBUG("listen()")

    repeat MAX_SOCKETS with sck
        if ( socket[sck].local_ip and (socket[sck].state == CLOSED) )
            socket[sck].state := LISTENING
            socket[sck].local_port := port
            socket[sck].rcv.wnd := rx_bytes_free(sck)
            socket[sck].snd.wnd := 0
            socket[sck].snd.wl1 := 0
            socket[sck].rcv.nxt := 0
            socket[sck].backlog.max_depth := bl
            socket[sck].backlog.pending := 0
            socket[sck].backlog.head := -1
            socket[sck].backlog.tail := -1
            return sck

    DEBUG(" error: no sockets available")
    return -1


pub recv(sck, p_dest, len=posx, flags=0): s
' Receive data from a socket
'   sck:        socket number
'   p_dest:     pointer to destination to copy received data
'   len:        length of data to receive (optional; default is as many bytes as are available)
'   flags:      receive flags (currently unused)

'   Returns:    number of bytes received on success
'               -1 on failure
    DEBUG("recv(): ")

    if ( len <= 0 )
        return -2                               ' error: bad length

    s := 0

    if ( socket[sck].protocol == L4_TCP )
        case socket[sck].state
            ESTABLISHED, FIN_WAIT_1, FIN_WAIT_2:
                DEBUG("connected")
            LISTENING, SYN_SENT, SYN_RECEIVED:      ' queue for processing in ESTABLISHED state
                DEBUG("not yet connected; queue")
                return OK
            CLOSE_WAIT:                             ' deliver remaining text
                ifnot ( rx_available(sck) )         '   otherwise, error: connection closing
                    DEBUG("error: connection closing")
                    return -1                       ' error: socket not connected
            CLOSED, UNUSED:
                DEBUG("error: connection doesn't exist")
                return -1                           ' error: connection doesn't exist
            CLOSING, LAST_ACK, TIME_WAIT:           ' error: connection closing
                DEBUG("error: connection closing")
    return rxget(sck, p_dest, len)              ' copy data from the socket buffer


pub recvfrom(sck, p_dest, max_len, flags, ^sockaddr_s p_addr, addrlen=0): l | h, t
' Receive data from a UDP socket
'   sck:        socket number
'   p_dest:     pointer to destination to copy received data to
'   max_len:    maximum length of data to receive
'   flags:      currently unused
'   p_addr:     socket address structure to copy address and port of the datagram sender to
'   addrlen:    currently unused

    ' check if there are any datagrams queued
    l := 0
    h := socket[sck].rxbuff.datagram.head       ' cache descriptor pointers
    t := socket[sck].rxbuff.datagram.tail

    if ( ( (h-t) & DG_MASK) > 0 )
        bytemove(   [p_addr], ...
                    @socket[sck].rxbuff.datagram.descr[t].remote, ...
                    sizeof(sockaddr_s) )
        l := rxget( sck, ...
                    p_dest, ...
                    socket[sck].rxbuff.datagram.descr[t].len <# max_len)
        socket[sck].rxbuff.datagram.descr[t]~
        socket[sck].rxbuff.datagram.tail := (t + 1) & DG_MASK


pub recvq(sck): a
' Get the number of bytes queued in a socket's receive buffer
    return rx_available(sck)


pub send(sck, p_src, len, flags=0): s
' Send data to a socket
'   sck:        socket number
'   p_src:      pointer to data to send
'   len:        length of data to send
'   flags:      send flags (currently unused)

'   Returns:    number of bytes sent on success
'               -1 on failure

    DEBUG("send(", udec_(sck), uhex_(p_src), udec_(len), uhex_(flags) )
    s := 0
    case socket[sck].state
        CLOSED, UNUSED:
            DEBUG(" error: socket does not exist")
            return -1                           ' error: connection does not exist
        LISTENING:
            DEBUG(" error: remote socket not specified")
            return -1                           ' error: remote socket not specified
        FIN_WAIT_1, FIN_WAIT_2, CLOSING, LAST_ACK, TIME_WAIT:
            DEBUG(" error: socket closing")
            return -1                           ' error: connection closing
        SYN_SENT, SYN_RECEIVED, ESTABLISHED, CLOSE_WAIT:
            DEBUG(" socket connected")
            if ( len <= 0 )
                return -1                       ' error: bad length

    s := txput(sck, p_src, len)                 ' copy data to the socket's buffer
    if ( flags )
        socket[sck].push_data := 1
    if ( enqueue_tcp_tx(sck) < 0 )
        return -1                               ' error: pending TCP transmission queue full

    return


pub sendq(sck): a
' Get the number of bytes queued in a socket's transmit buffer
    return tx_available(sck)


pub sendto(sck, p_src, len, flags, addr, port, al=4): s
' Send data to a remote host
'   sck:        socket number
'   p_src:      pointer to data to send
'   len:        length of data to send
'   flags:      send flags (currently unused)
'   addr:       remote address
'   port:       remote port
'   al:         address length (currently unused)
'   Returns:    number of bytes sent on success
'               -1 on failure

    DEBUG("sendto(", udec_(sck), uhex_(p_src), udec_(len), zstr_(str.iptostr(addr)), udec_(port), ")" )
    s := 0
    if ( (sck < 0) or (sck >= MAX_SOCKETS) )
        return -1                               ' error: invalid argument (invalid socket number)
    ifnot ( addr or port )
        return -1                               ' error: invalid argument (bad remote socket)

    if ( socket[sck].protocol == ip.UDP )
        ' allow re-assigning the socket's remote IP if the address in this call differs
        socket[sck].remote_ip := addr

        ' queue the datagram
        if ( tx_datagrams_free(sck) > 0 )       ' check for free descriptor
            s := txput(sck, p_src, len)         ' (try to) copy the datagram to the socket buffer
            if ( s > 0 )                        ' upon success, write the descriptor
                tx_queue_datagram(sck, addr, port, len)
                DEBUG(" OK")
                return
            DEBUG(" error: socket buffer or descriptor table full")
        return -1                               ' error: socket buffer or descriptor table full



pub set_if_addr(iface, ma, ipa, al=IPV4ADDR_LEN)'todo: this needs to be written to support multiple IP addresses
' Set an interface's addresses
'   iface:  interface #
'   ma:     MAC address (pointer)
'   ipa:    IP address
'               for IPv4 addresses, the address (Propeller byte order)
'               for IPv6 addresses, a pointer to the address
'   al:     address len
'               for IPv4 addresses, 4 (default)
'               for IPv6 addresses, 16
    if ( iface < MAX_INTERFACES )
        bytemove(@interface[iface].mac_addr, ma, MACADDR_LEN)
        if ( al == IPV4ADDR_LEN )
            interface[iface].ipv4_addr := ipa
            arp.cache_entry(ma, interface[iface].ipv4_addr)


pub set_if_flags(iface, flags, md=0)
' Set a network interface's operational flags
'   iface:  interface #
'   flags:  flags to set
'   md:     set mode (optional)
'           0:  set only these flags (default)
'           1:  add flags (bitwise OR) to existing flags

    if ( (iface >= 0) and (iface < MAX_INTERFACES) )
        netcmd.parameter[0] := iface
        if ( md )
            netcmd.parameter[1] |= iface        ' add flag(s)
        else
            netcmd.parameter[1] := iface        ' set only this flag (default)

        netcmd.command := CMD_SET_IF_FLAGS


pub set_socket_mailbox(sck, p_mbox)
' Set a socket's signal mailbox pointer
'   sck:    socket number
'   p_mbox: pointer to mailbox (2 longs)
    socket[sck].p_signal := p_mbox


pub setsockopt(sck, opt, val): s
' Set socket options
'   sck:    socket number
'   opt:    option
'   val:    value
    case opt
        IP_TTL, IP_MULTICAST_TTL:               ' IP time to live (0..255)
            socket[sck].ttl := val
        other:
            return -1                           ' error: invalid argument


pub stack_command(ncmd, parm)
' Send a command to the network stack cog
'   ncmd:
'       CMD_DISCONNECT (1): disconnect a socket (set sck to the address of the socket)
'       other values ignored
'   parm:   pointer to parameter(s)
    if ( ncmd == CMD_DISCONNECT )
        netcmd.parameter := parm
    netcmd.command := ncmd


' -- Stack-side functions

var long _netstack_stk[NET_STACK_SZ], _slock
pri cog_stack(CS_PIN, SCK_PIN, MOSI_PIN, MISO_PIN, SPI_FREQ) | st, s, tl, ul, pbuf, l, rip, sck
' Network stack main processing loop
    st := net.startx(CS_PIN, SCK_PIN, MOSI_PIN, MISO_PIN, SPI_FREQ)
    ifnot ( st )                                ' network driver returned an error on startup
        DEBUG("error: network driver failed to start - halting")
        cogstop( cogid() )

    _cog := cogid()                             ' signal that we've started successfully
    _slock := locknew()

    ' set up protocols - point them to the network device object
    ethii.init(@net)
    ip.init(@net)
    arp.init(@net)
    icmp.init(@net)
    igmp.init(@net)
    udp.init(@net)
    tcp.init(@net)
    net.preset_fdx()

    net.node_address(@interface.mac_addr)
    net.set_pkt_filter(net.PF_MY_UNICAST_ACCEPT | net.PF_BADCRC_REJECT)
    _timestamp_base := swap_long(math.rnd(posx))' randomize local timestamp (TCP only) 'xxx
    repeat
        ' suspend processing if the network link is/goes down
        if ( (net.phy_link_state() == net.DOWN) or (interface.link_state == 0) )
            interface.link_state := 0
            DEBUG("net link DOWN")
            repeat
            until ( net.phy_link_state() == net.UP )
            DEBUG("net link UP")
            arp_announce()  'xxx rewrite this such that it queues a task for ARP
            interface.link_state := 1
        ' task: check for commands sent by the user
        case netcmd.command                     ' process commands to the network loop
            CMD_CONNECT:
                open(netcmd.parameter[0], netcmd.parameter[1], netcmd.parameter[2])
                netcmd~
            CMD_DISCONNECT:
                close(netcmd.parameter[0])
                netcmd~
            CMD_SET_IF_FLAGS:
                iface_set_flags(netcmd.parameter[0], netcmd.parameter[1])
                netcmd~
        ' task: check for packets received on the network interface
        if ( net.pkt_cnt() )
            net.get_frame()
            receive_ethii()                     ' parse incoming frames
        ' TX tasks
        flush_arp_ready()                       ' packet buffers with resolved layer-2 addresses
        flush_tcp_control()                     ' TCP control packets
        flush_tcp_data()                        ' TCP sockets with data
        flush_arp_requests()                    ' ARP resolution requests
        flush_udp()                             ' UDP datagrams
        flush_arp_replies()                     ' replies to ARP requests


pub flush_arp_replies()
' Send pending ARP replies to the network device
    if ( (arp_reply_q.head-arp_reply_q.tail) & ARP_REPLQ_MASK )
        send_pbuf( arp_reply_q.entry[arp_reply_q.tail] )
        arp_reply_q.tail := (arp_reply_q.tail + 1) & ARP_REPLQ_MASK


pri flush_arp_ready() | pbuf, rip
' Send any pbufs that ARP has resolved layer-2 addresses for
    if ( arp_requests_queued() )
        DEBUG("flush_arp_ready() queued")
        pbuf := arp_request_q.entry[arp_request_q.tail].pbuf
        rip := arp_request_q.entry[arp_request_q.tail].ip_addr
        if ( arp.hw_addr_of(rip) )
            DEBUG(zstr_(str.iptostr(rip)), " is resolved")
            ' only if the destination MAC is known do we finally encapsulate the packet
            '   in Ethernet-II and write the frame to the NIC
            if ( pktbuff[pbuf].layer_written == 3 )
                write_ethii(pbuf, ...
                            arp.hw_addr_of(rip), ...
                            @interface[0].mac_addr, ...
                            ETYP_IPV4)
            elseif ( pktbuff[pbuf].layer_written == 2 )
'            pb_head := (pb_head + 1) & PKTBUFF_MASK
            send_pbuf(pbuf)                     ' write pbuf and de-queue it
            arp_request_q.tail := (arp_request_q.tail + 1) & ARP_REQSQ_MASK


pri flush_arp_requests() | pbuf, rip
' Send pending ARP requests
    if ( arp_requests_queued() )
        pbuf := arp_request_q.entry[arp_request_q.tail].pbuf
        rip := arp_request_q.entry[arp_request_q.tail].ip_addr

        ifnot ( arp.hw_addr_of( rip ) )
            ' throttle ARP resolution requests to one per second per IP address
            if ( arp_request_q.entry[arp_request_q.tail].type == 1 )
                send_pbuf(pbuf)
                arp_request_q.tail := (arp_request_q.tail + 1) & ARP_REQSQ_MASK
            else
                if ( (getms()-arp_request_q.entry[arp_request_q.tail].last_try) > 1_000 )
                    arp_request_q.entry[arp_request_q.tail].last_try := getms()
                    pbuf := pbuf_allocate()
                    if ( pbuf >= 0 )
                        write_arp(pbuf, arp.ARP_REQ, 0, rip)
                        write_ethii(pbuf, ...
                                    @_mac_bcast, ...
                                    @interface[0].mac_addr, ...
                                    ETYP_ARP)
                        pb_head := (pb_head + 1) & PKTBUFF_MASK
                        send_pbuf(pbuf)


pri flush_tcp_control()


pri flush_tcp_data() | sck, pbuf, tl, flags

    ' task: check for pending TCP transmissions
    if ( pending_tcp_tx() )                 ' signal from send()
        'xxx this just sends everything, but it should segmentize
        sck := next_pending_tcp_sck()
        DEBUG("pending_tcp_tx ", udec(sck) )
        pbuf := pbuf_allocate()
        if ( pbuf >= 0 )
            flags := tcp.ACK
            if ( socket[sck].push_data )
                flags |= tcp.PSH
            tl := write_tcp_socket(pbuf, sck, flags, tx_available(sck) )
            write_ipv4_socket(pbuf, sck, tl)
            dequeue_tcp_tx()
            socket[sck].tx_pending := false
            pb_head := (pb_head + 1) & PKTBUFF_MASK


pri flush_udp() | sck, pbuf, ul

    ' task: check for pending UDP transmissions
    repeat MAX_SOCKETS with sck
        if ( socket[sck].protocol == L4_UDP )
            if ( tx_datagrams_available(sck) > 0 )
                ' try to send the datagram
                pbuf := pbuf_allocate()
                if ( pbuf >= 0 )
                    ul := write_udp_socket(pbuf, sck)
                    write_ipv4(pbuf, socket[sck].local_ip, socket[sck].remote_ip, ip.UDP, ul)
                    pb_head := (pb_head + 1) & PKTBUFF_MASK
                socket[sck].txbuff.datagram.tail := (socket[sck].txbuff.datagram.tail+1) & DG_MASK


pri arp_announce() | pbuf
' Send a gratuitous ARP announcement
    DEBUG("arp_announce()")
    pbuf := pbuf_allocate()
    if ( pbuf >= 0 )
        write_arp(pbuf, arp.ARP_REQ, 0, interface.ipv4_addr)
        write_ethii(pbuf, @_mac_bcast, @interface.mac_addr, ETYP_ARP)
        pb_head := (pb_head + 1) & PKTBUFF_MASK
        arp_request_q.entry[arp_request_q.head].type := 1
        arp_request_q.head := (arp_request_q.head + 1) & ARP_REQSQ_MASK


pri arp_queue_ip(pbuf, ipaddr): s
' Queue an IP address for ARP resolution
    DEBUG("arp_queue_ip(", udec(pbuf), " ip=", zstr_(str.iptostr(ipaddr) ), ")")
    if ( ( (arp_request_q.tail - arp_request_q.head - 1) & ARP_REQSQ_MASK) > 0 )
        arp_request_q.entry[arp_request_q.head].pbuf := pbuf
        arp_request_q.entry[arp_request_q.head].ip_addr := ipaddr
        arp_request_q.head := (arp_request_q.head + 1) & ARP_REQSQ_MASK
        return 0

    DEBUG(" error: arp queue full")
    return -1


pri arp_requests_queued(): q
' Get the number of ARP resolution requests queued
    q := ( (arp_request_q.head - arp_request_q.tail) & ARP_REQSQ_MASK )
    if ( q )
        DEBUG("arp_requests_queued(): ", udec_(q))


pri close(sck): s | skn, tl, pbuf
' Close a socket
'   sck:        socket number
'   Returns:    0 on success
'               negative numbers on failure
    DEBUG("close()")

    if ( (sck < 0) or (sck >= MAX_SOCKETS) )
        DEBUG(" error: invalid socket ", udec_(sck))
        return -1                               ' error: invalid socket

    if ( socket[sck].state == CLOSED )
        DEBUG(" error: socket ", udec_(sck), " already closed")
        return -1                               ' error: socket already closed

    if ( socket[sck].protocol == L4_UDP )
        DEBUG(" closing UDP socket")
        delete_tcb(sck)
        return OK
    elseif ( socket[sck].protocol == L4_TCP )
        case socket[sck].state
            LISTENING:
                delete_tcb(sck)
                return -1
            SYN_SENT:
                delete_tcb(sck)
                'xxx send, recv should return 'error: closing'
                return -1
            SYN_RECEIVED:
                pbuf := pbuf_allocate()
                if ( pbuf >= 0 )
                    tl := write_tcp_socket(pbuf, sck, tcp.FIN | tcp.ACK)
                    write_ipv4_socket(pbuf, sck, tl)
                    pb_head := (pb_head + 1) & PKTBUFF_MASK
                    set_state(sck, FIN_WAIT_1)
                'xxx what about pending send data? should queue and transition to ESTABLISHED
                return OK
            ESTABLISHED:
                DEBUG(" socket established; closing")
                pbuf := pbuf_allocate()
                if ( pbuf >= 0 )
                    tl := write_tcp_socket(pbuf, sck, tcp.FIN | tcp.ACK)
                    write_ipv4_socket(pbuf, sck, tl)
                    pb_head := (pb_head + 1) & PKTBUFF_MASK
                    socket[sck].snd.nxt++
                    set_state(sck, FIN_WAIT_1)
                    'xxx should put this off until send queue has been sent
                return OK
            FIN_WAIT_1, FIN_WAIT_2:
                return -1                       ' error: connection closing
                ' return OK                     ' ok (ignored; already closing)
            CLOSE_WAIT:
                DEBUG(" in CLOSE_WAIT; closing")
                pbuf := pbuf_allocate()
                if ( pbuf >= 0 )
                    tl := write_tcp_socket(pbuf, sck, tcp.FIN | tcp.ACK)
                    write_ipv4_socket(pbuf, sck, tl)
                    pb_head := (pb_head + 1) & PKTBUFF_MASK
                    socket[sck].snd.nxt++
                    set_state(sck, LAST_ACK)
                return OK
            CLOSING, LAST_ACK, TIME_WAIT:
                return -1                       ' error: connection closing


pri delete_tcb(sck)
' Delete the transmission control block
    if ( socket[sck].state <> UNUSED )
        set_state(sck, UNUSED)                  ' signal to app
        socket[sck]~


pri dequeue_tcp_tx(): s
' Get the ID of the next socket with a TCP transmission queued
    DEBUG("dequeue_tcp_tx():")

    if ( ( (tcp_tx_pend.head-tcp_tx_pend.tail) & MAX_TCP_TX_PEND_MASK) > 0 )
        s := tcp_tx_pend.index[tcp_tx_pend.tail]
        DEBUG(" dequeue socket ", udec_(s) )
        tcp_tx_pend.tail := (tcp_tx_pend.tail + 1) & MAX_TCP_TX_PEND_MASK
        return s

    return -1


pri enqueue(ls, ns)
' Enqueue a connection in a listening socket's backlog
'   ls:     listening socket
'   ns:     new socket
    DEBUG("enqueue(", udec_(ls), udec_(ns), ")")
    if ( socket[ls].state <> LISTENING )
        DEBUG(" error: socket ", udec_(ls), " isn't in LISTENING state")
        return -1
    if ( ls == ns )
        DEBUG(" error: listening socket ", udec_(ls), " == new socket ", udec_(ns) )
        return -1
    socket[ns].backlog.pnext := -1
    if ( socket[ls].backlog.head < 0 )          ' empty queue
        socket[ls].backlog.head := ns
        socket[ls].backlog.tail := ns
        DEBUG(  " first new connection, head=", udec_(socket[ls].backlog.head), " tail=", udec_(socket[ls].backlog.tail) )
    else                                        ' connection(s) queued
        if ( socket[ls].backlog.tail < 0 )
            DEBUG(" error: socket[", udec_(ls), "].tail=", udec_(socket[ls].backlog.tail) )
            return -1                           ' error
        ' link the listening socket's previous tail pointer to the new socket
        '   and update the tail pointer
        socket[ socket[ls].backlog.tail ].backlog.pnext := ns
        socket[ls].backlog.tail := ns  '
{
        DEBUG(  " new connection, sck[", udec_(socket[ls].backlog.tail), ...
                "].next=", socket[ socket[ls].backlog.tail ].backlog.pnext, ...
                " head=", udec_(socket[ls].backlog.head), ...
                " tail=", udec_(socket[ls].backlog.tail) )
}

pri enqueue_tcp_tx(sck): s
' Enqueue a TCP transmission
    DEBUG("enqueue_tcp_tx(", udec_(sck), "): ", udec_( ( (tcp_tx_pend.tail - tcp_tx_pend.head - 1) & MAX_TCP_TX_PEND_MASK) ), " slots free")

    if ( ( (tcp_tx_pend.tail - tcp_tx_pend.head - 1) & MAX_TCP_TX_PEND_MASK) > 0 )
        tcp_tx_pend.index[tcp_tx_pend.head] := sck
        tcp_tx_pend.head := (tcp_tx_pend.head + 1) & MAX_TCP_TX_PEND_MASK
        socket[sck].tx_pending := true
        return 0

    return -1


pri find_listening_socket(port, proto): s
' Find a socket that's listening on a port and protocol
'   port:   local port
'   proto:  layer-4 protocol (L4_UDP, L4_TCP)
    DEBUG("find_listening_socket(", udec_(port), udec_(proto), ")")
    repeat MAX_SOCKETS with s
        if (socket[s].local_port == port and ...
            socket[s].protocol == proto and ...
            socket[s].state == LISTENING)
            DEBUG(" matching socket ", udec_(s) )
            return s

    DEBUG(" error: no matching listening socket")
    return -1                                   ' no matching socket is listening


pri iface_set_flags(iface, flags)
' Set interface flags
'   iface:  interface
'   flags:  flags to set
    if ( (iface >= 0) and (iface < MAX_INTERFACES) )
        if ( flags & IF_PROMISCUOUS )
            net.set_pkt_filter(net.PF_PROMISCUOUS)


pri lookup_iface(addr, addrlen=4): i | a
' Look up interfaces by IP address
'   addr:       IP address (value, if IPv4, reference/pointer if IPv6)
'   addrlen:    length of address:  4: IPv4 (default), 16: IPv6
'   Returns:    interface number/index on success
'               -1 if no matching interface exists
    if ( addrlen == 4 )
        repeat MAX_INTERFACES with i            ' look for an interface with this address (IPv4)
            repeat MAX_IP_PER_IFACE with a
                if ( interface[i].ipv4_addr[a] == addr )
                    return i
    elseif ( addrlen == 16 )
        repeat MAX_INTERFACES with i            ' look for an interface with this address (IPv6)
            repeat MAX_IP6_PER_IFACE with a
                if ( bytecomp(@interface[i].ipv6_addr[a], addr, IPV6ADDR_LEN) )
                    return i

    return -1                                   ' error: no interface with that IP


pri next_pending_tcp_sck(): s
' Get index of oldest pending TCP segment
    return tcp_tx_pend.index[tcp_tx_pend.tail]


pri open(sck, rip, rp): s | tl, pbuf
' Connect a socket to a remote host
'   sck:    socket number
'   rip:    remote IP
'   rp:     remote port

    DEBUG("open():")
    if ( socket[sck].state == CLOSED )
        ifnot ( socket[sck].local_ip )
            DEBUG(" error: socket not bound to ip")
            return -1                           ' error: socket not bound to an interface/IP

        if ( socket[sck].local_port < 0 )       ' pick a random local port if one wasn't specified
            socket[sck].local_port := 49152+math.rndi(16383)

        socket[sck].remote_ip := rip            ' fill in remote socket
        socket[sck].remote_port := rp
        DEBUG(" lip=", zstr_(str.iptostr(socket[sck].local_ip)), " rip=", zstr_(str.iptostr(rip)), " rp=", udec_(rp) )
        if ( socket[sck].protocol == ip.TCP )
            if ( tcp_tx_pending_free() )
                socket[sck].snd.una := socket[sck].snd.iss := math.rndi(posx)
                socket[sck].snd.nxt := socket[sck].snd.iss
                socket[sck].rcv.wnd := rx_bytes_free(sck)
                socket[sck].tsval := _timestamp_base
                socket[sck].tsecr := 0
                pbuf := pbuf_allocate()
                if ( pbuf >= 0 )
                    tl := write_tcp_socket(pbuf, sck, tcp.SYN) 
                    write_ipv4(pbuf, socket[sck].local_ip, socket[sck].remote_ip, ip.TCP, tl)
                    socket[sck].state := SYN_SENT
                    pb_head := (pb_head + 1) & PKTBUFF_MASK
                    socket[sck].snd.nxt := socket[sck].snd.iss+1
                    return OK
                else
                    return -1                   ' error: no pbufs free
            else
                return -1                       ' error: descriptor TX queue full
        elseif ( socket[sck].protocol == ip.UDP )
            ' UDP is stateless, so if we've gotten this far,
            '   consider the connection established
            set_state(sck, ESTABLISHED)
            return OK

    DEBUG(" error: already connected")
    return -2                                   ' error: socket already connected


pri pbuf_allocate(): p
' Allocate a packet buffer
'   Returns:    pbuf index on success
'               -1 on failure
    DEBUG("pbuf_allocate() ", udec(pb_head), udec(pb_tail) )
    if ( pbuf_free() )
        return pb_head
    else
        DEBUG("pbuf_allocate(): error: no pbufs free")
        return -1


pri pbuf_free(): p
' Get the number of free packet buffers
    DEBUG("pbuf_free() h=", udec_(pb_head), " t=", udec_(pb_tail) )
    return ( ( (pb_tail - pb_head - 1) & PKTBUFF_MASK) )


pri pbuf_next(): p
' Get the index of the next packet buffer queued for transmission
'   Returns:    packet buffer index on success
'               -1 if there are no packet buffers queued
'    DEBUG("pbuf_next() ", udec(pb_head), udec(pb_tail) )

    if ( pbuf_queued() )
        return pb_tail
    else
        return -1                               ' error: no packet buffers queued


pri pbuf_queued(): p
' Get the number of pktbuffs queued
'    DEBUG("pbuf_queued() ", udec(pb_head), udec(pb_tail) )

    return ( ( pb_head-pb_tail ) & PKTBUFF_MASK )


pri pending_tcp_tx(): s
' Get total count of currently pending TCP segments
    return ( (tcp_tx_pend.head-tcp_tx_pend.tail) & MAX_TCP_TX_PEND_MASK)


pri receive_arp(^ethii_t eh): s | e, mf, arp_msg_s ah
' Process received ARP messages
'   eh: ethernet-II header (pointer to structure)
    DEBUG("receive_arp")
    ah~
    arp.rd_arp_msg(@ah)                            ' read message

    ' reference RFC 826, 'Packet Reception'
    ' compare protocol type and sender protocol address (IP) to entries we've cached
    mf := false
    repeat arp.ENTRIES with e
        if (    (arp.proto_type(@ah) == arp.cached_proto_type(e) ) and ...
                (arp.sender_proto_addr(@ah) == arp.cached_proto_addr(e) ) )
            ' the message matches an existing entry; update it with the sender MAC address
            '   in case it's different
            arp.cache_update_hw_addr( e, arp.sender_hw_addr(@ah) )
            mf := true
    if ( arp.target_proto_addr(@ah) == interface.ipv4_addr )
        ' are we the target of the message?
        ifnot ( mf )
            ' this sender hasn't been seen before; store it in the ARP table
            e := arp.cache_entry(   arp.sender_hw_addr(@ah), ...
                                    arp.sender_proto_addr(@ah), ...
                                    arp.proto_type(@ah) )
            if ( e < 0 )
                return -1                       ' error: ARP table full
        if ( arp.opcode(@ah) == arp.ARP_REQ )
            ' was this a request? send out a reply
            arp_reply(@ah)


pri arp_reply(^arp_msg_s ah) | pbuf
' Write an ARP reply message
    pbuf := pbuf_allocate()
    if ( pbuf >= 0 )
        write_arp(pbuf, arp.ARP_REPL, arp.sender_hw_addr(@ah), arp.sender_proto_addr(@ah) )
        write_ethii(pbuf, arp.sender_hw_addr(@ah), @interface[0].mac_addr, ETYP_ARP)
        arp_reply_q.entry[arp_reply_q.head] := pbuf
        pb_head := (pb_head + 1) & PKTBUFF_MASK
        arp_reply_q.head := (arp_reply_q.head + 1) & ARP_REPLQ_MASK


pri receive_ethii(): s | ethii_t eh
' Process received Ethernet-II headers
    eh~
    ethii.rd_ethii_frame(@eh)                      ' read in the Ethernet-II header
    DEBUG("receive_ethii() ethertype=", uhex_(ethii.ethertype(@eh) ) )

    case ethii.ethertype(@eh)
        ETYP_ARP:   
            receive_arp(@eh)
        ETYP_IPV4:
            receive_ipv4(@eh)


var byte _icmp_echo_data[48]
pri receive_icmp() | icmp_msg_s ich
' Process received ICMP headers
    DEBUG("receive_icmp()")
    icmp.rd_icmp_msg(@ich)

    case_fast icmp.msg_type(@ich)
        icmp.DEST_UNREACH:                      ' destination unreachable
            DEBUG("destination unreachable: ")
            'todo: these need to be forwarded to the application or the socket somehow so they know
            ' there was a problem
            if ( icmp.code(@ich) == icmp.PORT_UNREACH )
                DEBUG(" port")
            elseif ( icmp.code(@ich) == icmp.DEST_UNREACH )
                DEBUG(" host")
                return
        icmp.ECHO_REQ:                          ' echo request (ping)
            'todo


pri receive_ipv4(^ethii_t eh) | ipv4_hdr_s ih, sck
' Process received IPv4 headers
    DEBUG("receive_ipv4()")
    ih~
    ip.rd_ip_header(@ih)
    DEBUG(  "src: ", zstr_(str.iptostr(ip.src_addr(@ih) ) ), " dest: ", zstr_(str.iptostr(ip.dest_addr(@ih) ) ), " proto: ", uhex_(ip.layer4_proto(@ih) ) )

    ' add this host to the ARP cache - saves us having to look it up later
    ifnot ( arp.hw_addr_of(ip.src_addr(@ih) ) )
        arp.cache_entry(ethii.src_addr(@eh), ip.src_addr(@ih) )

    repeat MAX_SOCKETS with sck
        if ( (ip.dest_addr(@ih) == socket[sck].local_ip) )
            case ip.layer4_proto(@ih)
                L4_ICMP:
                    receive_icmp()
                    return
                L4_UDP:
                    receive_udp(@ih)
                    return
                L4_TCP:
                    receive_tcp(@ih)
                    return
        elseif ( ip.is_multicast_addr(ip.dest_addr(@ih) ) )
            if ( ip.layer4_proto(@ih) == L4_UDP )
                receive_udp(@ih)
                return


pri receive_tcp(^ipv4_hdr_s ih): tf | tcp_msg_s th, ack, seq, flags, seg_len, seg_accept, loop_nr, reset, ls, s, sck, tl, pbuf
' Process incoming TCP segment (reference TCP RFC 9293, s. 3.10.7 "Segment arrives")
    th~
    tcp.rd_tcp_header(@th)
    if ( tcp.header_len(@th) > 20 )'todo: move this into tcp.rd_tcp_header()
        tcp.rd_tcp_opts(@th)

    DEBUG(  "receive_tcp() sp: ", udec_(tcp.source_port(@th) ), " dp: ", udec_(tcp.dest_port(@th) ), " seq: ", udec_(tcp.seq_nr(@th) ), " ack: ", udec_(tcp.ack_nr(@th) ), " hlen: ", udec_(tcp.header_len(@th) ), " win: ", udec_(tcp.window(@th) ) )

    ' the criteria being checked depend on the current state of the socket, so first
    '   look for a matching one (pre-3.10.7.1)

    reset := true                               ' assume there's no matching socket, initially
    sck := -1

    ' first, look for a socket that's at least half-open
    repeat MAX_SOCKETS with s
        if ( tcp.dest_port(@th) == socket[s].local_port )
            if ((ip.src_addr(@ih) == socket[s].remote_ip) and ...
                (tcp.source_port(@th) == socket[s].remote_port) )
                ' found a matching socket
                reset := false
                sck := s                        ' make this our working socket
                socket[sck].tsval := _timestamp_base + getms()
                socket[sck].tsecr := tcp.timestamp_val()
                DEBUG("matching socket ", udec_(sck), " is in state ", zstr_(netstr.state_str(socket[sck].state) ) )
                quit

    ' if that fails, look for a socket that's listening on that port
    if ( reset )
        ls := find_listening_socket(tcp.dest_port(@th), L4_TCP)
        if ( ls >= 0 )
            reset := false
            DEBUG(" LISTENING")
            if ( tcp.flags(@th) & tcp.RST ) ' invalid; ignore
                return 0
            if ( tcp.flags(@th) & tcp.ACK ) ' bad; send reset in reply
                'seq=seg.ack, ctl=rst'xxx
                return 0
            if ( tcp.flags(@th) & tcp.SYN )
                DEBUG("  SYN socket ", udec_(ls) )
                ' check the listening socket's "half-open" connection backlog for room
                if ( socket[ls].backlog.pending < socket[ls].backlog.max_depth )
                    sck := new_socket()
                    if ( sck < 0 )
                        pbuf := pbuf_allocate()'xxx this block doesn't seem to work; no TCP is
                        if ( pbuf >= 0 )        ' written; instead IPv4 with unknown data
                            tl := write_tcp(pbuf, ...
                                            interface.ipv4_addr, ...
                                            ip.src_addr(@ih), ...
                                            tcp.dest_port(@th), ...
                                            tcp.source_port(@th), ...
                                            tcp.seq_nr(@th), ...
                                            0, ...
                                            tcp.RST | tcp.ACK)
                            write_ipv4( pbuf, ...
                                        interface.ipv4_addr, ...
                                        ip.src_addr(@ih), ...
                                        ip.TCP, ...
                                        tl)
                            pb_head := (pb_head + 1) & PKTBUFF_MASK
                        return -1           ' error: no sockets available; drop
                    ' copy the listening socket and incoming packet into the new socket
                    socket[sck].protocol := L4_TCP
                    socket[sck].rcv.nxt := tcp.seq_nr(@th)+1
                    socket[sck].rcv.irs := tcp.seq_nr(@th)
                    socket[sck].rcv.wnd := socket[ls].rcv.wnd
                    socket[sck].snd.iss := socket[sck].snd.nxt := math.rndi(posx)
                    socket[sck].local_ip := socket[ls].local_ip
                    socket[sck].local_port := socket[ls].local_port
                    socket[sck].remote_ip := ip.src_addr(@ih)
                    socket[sck].remote_port := tcp.source_port(@th)
                    socket[sck].tsval := _timestamp_base + getms()
                    socket[sck].tsecr := tcp.timestamp_val()
                    pbuf := pbuf_allocate()
                    if ( pbuf >= 0 )
                        tl := write_tcp_socket(pbuf, sck, tcp.SYN | tcp.ACK)
                        write_ipv4( pbuf, ...
                                    socket[sck].local_ip, ...
                                    ip.src_addr(@ih), ...
                                    ip.TCP, ...
                                    tl)
                        pb_head := (pb_head + 1) & PKTBUFF_MASK
                        socket[sck].snd.una := socket[sck].snd.iss
                        socket[sck].snd.nxt := socket[sck].snd.iss+1
                        socket[sck].p_signal := socket[ls].p_signal
                        set_state(sck, SYN_RECEIVED)
                        return sck
                else
                    ' backlog full - too many half-open connections; send reset
                    DEBUG("error: TCP backlog full")
                    pbuf := pbuf_allocate()
                    if ( pbuf >= 0 )
                        tl := write_tcp( pbuf, ...
                                        interface.ipv4_addr, ...
                                        ip.src_addr(@ih), ...
                                        tcp.dest_port(@th), ...
                                        tcp.source_port(@th), ...
                                        tcp.seq_nr(@th), ...
                                        0, ...
                                        tcp.RST | tcp.ACK)
                        write_ipv4( pbuf, ...
                                    interface.ipv4_addr, ...
                                    ip.src_addr(@ih), ...
                                    ip.TCP, ...
                                    tl)
                        pb_head := (pb_head + 1) & PKTBUFF_MASK
                    return

    seg_len := ( ip.dgram_len(@ih) - ip.IP_HDR_SZ - tcp.header_len(@th) )

    if ( reset )
        DEBUG("no matching socket")        ' 3.10.7.1 (TCB does not exist)
        if ( tcp.flags(@th) & tcp.RST )
            return 0
        else
            if ( tcp.flags(@th) & tcp.ACK ) ' ACK bit is on
                seq := tcp.ack_nr(@th)      ' echo back the sender's ACK #
                ack := 0
                flags := tcp.RST
            else                            ' ACK bit is off
                seq := 0
                ack := tcp.seq_nr(@th)+seg_len
                flags := tcp.RST | tcp.ACK

            pbuf := pbuf_allocate()
            if ( pbuf >= 0 )
                tl := write_tcp(pbuf, ...
                                interface.ipv4_addr, ...    'xxx find matching interface
                                ip.src_addr(@ih), ...
                                tcp.dest_port(@th), ...
                                tcp.source_port(@th), ...
                                seq, ...
                                ack, ...
                                flags, ...
                                tcp.timest_ptr(), ...
                                0)
                write_ipv4(  pbuf, ...
                            interface.ipv4_addr, ...    'xxx same
                            ip.src_addr(@ih), ...
                            ip.TCP, ...
                            tl)
                pb_head := (pb_head + 1) & PKTBUFF_MASK
            return 0
    else
        ' found a matching fully-specified socket or a listening socket
        DEBUG(" using socket ", udec(ls), udec(s), udec(sck) )
        case socket[sck].state
            SYN_SENT:                           ' 3.10.7.3
                if ( tcp.flags(@th) & tcp.ACK )
                    if ( (tcp.ack_nr(@th) <= socket[sck].snd.iss) or ...
                        (tcp.ack_nr(@th) > socket[sck].snd.nxt) )
                        DEBUG(  "SYN_SENT bad ACK: ", udec_(tcp.ack_nr(@th) ), " is =< snd.iss=", udec_(socket[sck].snd.iss), " or > snd.nxt=", udec_(socket[sck].snd.nxt) )
                        ifnot ( tcp.flags(@th) & tcp.RST )
                            'send reset
                            'seq=seg.ack, ctl=RST
                            pbuf := pbuf_allocate()
                            if ( pbuf >= 0 )
                                tl := write_tcp_socket(pbuf, sck, tcp.RST)
                                write_ipv4( pbuf, ...
                                            interface.ipv4_addr, ...
                                            ip.src_addr(@ih), ...
                                            ip.TCP, ...
                                            tl)
                                pb_head := (pb_head + 1) & PKTBUFF_MASK
                            return 0            ' bad ACK; drop
                    if ( (tcp.ack_nr(@th) > socket[sck].snd.una) and ...
                        (tcp.ack_nr(@th) <= socket[sck].snd.nxt) )
                        ' ACK number is acceptable
                        ' xxx could check ack == snd.nxt instead of <= if we don't want to support
                        '   sending data on SYN segments
                if ( tcp.flags(@th) & tcp.RST )
                    'xxx possible blind reset attack vector here; see RFC 5961
                    ' signal to user: error: connection reset
                    set_state(sck, CLOSED)
                    return
                if ( tcp.flags(@th) & tcp.SYN )
                    DEBUG("SYN_SENT: rcv SYN|ACK")
                    socket[sck].rcv.nxt := tcp.seq_nr(@th)+1
                    socket[sck].rcv.irs := tcp.seq_nr(@th)
                    socket[sck].snd.una := tcp.ack_nr(@th)
                    if ( socket[sck].snd.una > socket[sck].snd.iss )    ' = our SYN has been ACKed
                        'seq=snd.nxt
                        'ack=rcv.nxt
                        'ctl=ACK
                        set_state(sck, ESTABLISHED)
                        pbuf := pbuf_allocate()
                        if ( pbuf >= 0 )
                            tl := write_tcp_socket(pbuf, sck, tcp.ACK)
                            write_ipv4( pbuf, ...
                                        socket[sck].local_ip, ...
                                        socket[sck].remote_ip, ...
                                        ip.TCP, ...
                                        tl)
                            pb_head := (pb_head + 1) & PKTBUFF_MASK
                        return
                    else                        ' simultaneous open?
                        set_state(sck, SYN_RECEIVED)
                        'seq=iss
                        'ack=rcv.nxt
                        'ctl=SYN,ACK
                        'snd.wnd := seg.wnd
                        'snd.wl1 := seg.seq
                        'snd.wl2 := seg.ack
                        return

    ' if we got here, the socket's state must be one of:
    ' SYN_RECEIVED, ESTABLISHED, FIN_WAIT_1, FIN_WAIT_2, CLOSE_WAIT, CLOSING, LAST_ACK, TIME_WAIT
    seg_accept := true
    seq := tcp.seq_nr(@th)
    ack := tcp.ack_nr(@th)
    ' check the sequence number
    DEBUG(  " rcv.nxt=", udec_(socket[sck].rcv.nxt), " seg.seq=", udec_(tcp.seq_nr(@th) ), " rcv.wnd=", udec_(socket[sck].rcv.wnd), " rcv.nxt+rcv.wnd=", udec_(socket[sck].rcv.nxt+socket[sck].rcv.wnd) )

    ' 1
    ifnot ( seq == socket[sck].rcv.nxt )        ' not necessarily a failure; dig deeper:
        ' 2
        ifnot ( socket[sck].rcv.nxt +<= seq +< (socket[sck].rcv.nxt+socket[sck].rcv.wnd) )
            DEBUG(" ERR rcv.nxt =< seg.seq < rcv.nxt+rcv.wnd")
            seg_accept := false
        ' 3
        if ( (seg_len > 0) and (socket[sck].rcv.wnd == 0) )
            ' segment contains text but receive window is closed
            DEBUG(" ERR rcv.wnd closed")
            seg_accept := false
        ' 4
        ifnot ( (socket[sck].rcv.nxt +<= seq +< socket[sck].rcv.nxt+socket[sck].rcv.wnd) or ...
                (socket[sck].rcv.nxt +<= (seq+seg_len-1) +< socket[sck].rcv.nxt+socket[sck].rcv.wnd) )
            DEBUG(" ERR seq_nr outside rcv window")
            seg_accept := false                 ' sequence number outside the rcv window

    ifnot ( seg_accept )                        ' ACK unacceptable segment
        ifnot ( tcp.flags(@th) & tcp.RST )      '   unless the RST flag is set
            pbuf := pbuf_allocate()
            if ( pbuf >= 0 )
                tl := write_tcp_socket(pbuf, sck, tcp.ACK)
                write_ipv4( pbuf, ...
                            socket[sck].local_ip, ...
                            socket[sck].remote_ip, ...
                            ip.TCP, ...
                            tl)
                pb_head := (pb_head + 1) & PKTBUFF_MASK
                DEBUG(" check seq nr ret")
        return OK

    ' check the reset flag
    DEBUG(" checking RST")
    if ( tcp.flags(@th) & tcp.RST )
        case socket[sck].state
            SYN_RECEIVED:
                if ( socket[sck].prev_state == LISTENING )
                    set_state(sck, LISTENING)
                    DEBUG(" connection reset")
                    return OK
                elseif ( socket[sck].prev_state == SYN_SENT )
                    set_state(sck, CLOSED)
                    delete_tcb(sck)
                    return -1
            ESTABLISHED, FIN_WAIT_1, FIN_WAIT_2, CLOSE_WAIT:
                set_state(sck, CLOSED)
                delete_tcb(sck)
                return -1
            CLOSING, LAST_ACK, TIME_WAIT:
                set_state(sck, CLOSED)
                delete_tcb(sck)
                return -1

    ' check the SYN bit
    if ( tcp.flags(@th) & tcp.SYN )
        DEBUG(" SYN is set")
        case socket[sck].state
            SYN_RECEIVED:
                if ( socket[sck].prev_state == LISTENING )
                    delete_tcb(sck)
                    DEBUG(" dup syn received")
                    return OK
            ESTABLISHED, FIN_WAIT_1, FIN_WAIT_2, CLOSE_WAIT, CLOSING, LAST_ACK, TIME_WAIT:
                DEBUG(" state is >= ESTABLISHED")
                pbuf := pbuf_allocate()
                if ( pbuf >= 0 )
                    tl := write_tcp_socket(pbuf, sck, tcp.ACK)
                    write_ipv4( pbuf, ...
                                socket[sck].local_ip, ...
                                socket[sck].remote_ip, ...
                                ip.TCP, ...
                                tl)
                    pb_head := (pb_head + 1) & PKTBUFF_MASK
                return OK

    ' check the ACK field
    ifnot ( tcp.flags(@th) & tcp.ACK )
        DEBUG(" no ACK bit")
        return OK

    ' segment contains an ACK: the loop below checks that the sequence number received is
    '   "in-window." If it's not, how it's handled depends on the socket's current
    '   connection state. The connection could be reset, or the segment silently dropped, etc.
    DEBUG(" seg has ACK bit")
    repeat
        case socket[sck].state
            SYN_RECEIVED:
                DEBUG(" SYN_RECEIVED")
                if ( (tcp.ack_nr(@th) > socket[sck].snd.una) and (tcp.ack_nr(@th) <= socket[sck].snd.nxt) )
                    ls := find_listening_socket(tcp.dest_port(@th), L4_TCP)
                    if ( ls < 0 )   'xxx this shouldn't happen
                        DEBUG(" error: no listening socket")
                        return
                    set_state(sck, ESTABLISHED)
                    socket[ls].backlog.pending++
                    DEBUG(" socket[", udec_(ls), "].backlog=", udec_(socket[ls].backlog.pending) )
                    enqueue(ls, sck)
                    socket[sck].snd.wnd := tcp.window(@th)
                    socket[sck].snd.wl1 := tcp.seq_nr(@th)
                    socket[sck].snd.wl2 := tcp.ack_nr(@th)
                if ( tcp.ack_nr(@th) > socket[sck].snd.nxt )
                    ' ACK to future (not yet sent) segment
                    DEBUG(" ACK to future segment")
                    return OK                   ' drop segment
                    'write_tcp_socket(sck, tcp.ACK)  ' send challenge ACK (xxx rate limit this)
            ESTABLISHED, FIN_WAIT_1, FIN_WAIT_2, CLOSE_WAIT, CLOSING, LAST_ACK:
                DEBUG(" state is >= ESTABLISHED")
                if ( (ack > socket[sck].snd.una) and (ack <= socket[sck].snd.nxt) )
                    socket[sck].snd.una := ack
                if ( ack < socket[sck].snd.una )
                    ' ACK to old (already acknowledged) segment; drop
                    DEBUG(" ack old segment; drop")
                    return OK
                if ( ack > socket[sck].snd.nxt )
                    ' ACK to future (not yet sent) segment
                    ' TCP RFC specifies a challenge ACK here but this doesn't seem like it's
                    '   typical behavior nowadays and puts a greater strain on an embedded stack
                    '   like this (not that it's expected to happen often)
                    DEBUG(" ack future segment; drop")
                    return 
                if (    (socket[sck].snd.wl1 < seq) or ...
                        ( (socket[sck].snd.wl1 == seq) and (socket[sck].snd.wl2 <= ack) ) )
                    ' update the window sequence and ACK numbers
                    socket[sck].snd.wnd := tcp.window(@th)
                    socket[sck].snd.wl1 := seq
                    socket[sck].snd.wl2 := ack
                case socket[sck].state
                    FIN_WAIT_1:
                        set_state(sck, FIN_WAIT_2)
                    FIN_WAIT_2:
                        quit
                    CLOSE_WAIT:
                        quit
                    CLOSING:
                        set_state(sck, TIME_WAIT)
                        quit
                    LAST_ACK:
                        delete_tcb(sck)
                        return OK
                    TIME_WAIT:
                        ' The only thing that can arrive in this state is a retransmission of the
                        '   remote FIN. Acknowledge it, and restart the 2 MSL timeout.
                        if ( seq == socket[sck].rcv.nxt )
                            pbuf := pbuf_allocate()
                            if ( pbuf >= 0 )
                                tl := write_tcp_socket(pbuf, sck, tcp.FIN | tcp.ACK)
                                write_ipv4( pbuf, ...
                                            socket[sck].local_ip, ...
                                            socket[sck].remote_ip, ...
                                            ip.TCP, ...
                                            tl)
                                pb_head := (pb_head + 1) & PKTBUFF_MASK
                        ' TODO: restart timeout
                quit

    ' --
    ' The urgent (URG) flag would normally be processed here. This isn't typically used
    '   nowadays, so we'll ignore it.
    ' --

    ' process segment text
    DEBUG(" process segment text: ", udec_(seg_len), "bytes")
    if ( seg_len )                              ' process only if there's actually a payload
        case socket[sck].state
            ESTABLISHED, FIN_WAIT_1, FIN_WAIT_2:
                ' receive as much data as is allowed by the receive window (and update it)
                socket[sck].rcv.nxt += xrxget(sck, seg_len)
                socket[sck].rcv.wnd := rx_bytes_free(sck)
                long[socket[sck].p_signal] |= DATA_READY
                if ( tcp.flags(@th) & tcp.PSH )
                    DEBUG(" PSH")
                    ' signal to the application protocol the PUSH flag was set
                    long[socket[sck].p_signal+4] := sck
                    long[socket[sck].p_signal] |= PUSH_RECEIVED
                pbuf := pbuf_allocate()
                if ( pbuf >= 0 )
                    tl := write_tcp_socket(pbuf, sck, tcp.ACK)
                    write_ipv4( pbuf, ...
                                socket[sck].local_ip, ...
                                socket[sck].remote_ip, ...
                                ip.TCP, ...
                                tl)
                    pb_head := (pb_head + 1) & PKTBUFF_MASK
            CLOSE_WAIT, CLOSING, LAST_ACK, TIME_WAIT:
                return OK

    DEBUG(" check FIN bit: ")
    ' check the FIN bit
    ifnot ( tcp.flags(@th) & tcp.FIN )             ' not set; ignore
        DEBUG(" not set")
        return OK

    if ( lookdown(socket[sck].state: CLOSED, LISTENING, SYN_SENT) )
        ' sequence number can't be verified in these states; ignore FIN, drop the segment
        DEBUG("set, but seg.seq can't be verified in this state")
        return OK

    DEBUG(" set")
    ' signal to the app the remote wants to disconnect
    long[socket[sck].p_signal+4] := sck
    long[socket[sck].p_signal] := CONN_CLOSED_REMOTE | PUSH_RECEIVED
    DEBUG(" socket ", udec_(sck), " disconnect by remote host")

    flags := tcp.ACK
    case socket[sck].state
        SYN_RECEIVED, ESTABLISHED:
            set_state(sck, CLOSE_WAIT)
        FIN_WAIT_1:
            set_state(sck, CLOSING)
        FIN_WAIT_2:
            set_state(sck, TIME_WAIT)
        CLOSE_WAIT, CLOSING, LAST_ACK:
            ' remain in this state
        TIME_WAIT:
            ' Remain in the TIME-WAIT state.
            ' TODO: Restart the 2 MSL time-wait timeout.

    pbuf := pbuf_allocate()
    if ( pbuf >= 0 )
        socket[sck].rcv.nxt++
        tl := write_tcp_socket(pbuf, sck, flags)
        write_ipv4( pbuf, ...
                    socket[s].local_ip, ...
                    socket[s].remote_ip, ...
                    ip.TCP, ...
                    tl)
        pb_head := (pb_head + 1) & PKTBUFF_MASK

    return OK


pri receive_udp(^ipv4_hdr_s ih): s | udp_msg_s uh, sck, l, h, t, pbuf, il
' Process received UDP headers
    DEBUG("process_udp()")
    udp.set_header(@uh)
    udp.rd_udp_header()

    repeat MAX_SOCKETS with sck
        if ( (udp.dest_port() == socket[sck].local_port) and (socket[sck].protocol == L4_UDP) )
            DEBUG("sck ", udec_(sck), " port match")
            l := udp.payload_len()
            h := socket[sck].rxbuff.datagram.head
            t := socket[sck].rxbuff.datagram.tail
            if ( ( (t-h - 1) & DG_MASK) > 0 )
                s := xrxget(sck, l)
                if ( s > 0 )
                    socket[sck].rxbuff.datagram.descr[h].remote.address := ip.src_addr(@ih)
                    socket[sck].rxbuff.datagram.descr[h].remote.port := udp.src_port()
                    socket[sck].rxbuff.datagram.descr[h].len := l
                    socket[sck].rxbuff.datagram.head := (h + 1) & DG_MASK
                    return
            if ( socket[sck].p_signal )         ' notify the service/protcol handler, if defined
                long[socket[sck].p_signal+4] := sck
                long[socket[sck].p_signal] := DATA_READY
            return

    DEBUG("no matching socket")
    'todo: verify this logic: should we bounce the message regardless, assuming that multicast messages
    '   would've made it this far only if they passed prior filtering? (hardware-based)
    ifnot ( ip.is_multicast_addr(ip.dest_addr(@ih) ) )
        ' no socket exists with that port; bounce message
        pbuf := pbuf_allocate()
        if ( pbuf >= 0 )
            'todo: incomplete
            'write_icmp(pbuf, typ, cd, len=0, p_src=0, ident=0, seq_nr=0): l
            'write_ipv4(pbuf, lip, rip, pro, len=0, ident=0, dscp=0, ttl=0): l
            il := write_icmp(pbuf, icmp.DEST_UNREACH, icmp.PORT_UNREACH)
            write_ipv4(pbuf, interface[0].ipv4_addr, ip.src_addr(@ih), ip.UDP, il)
            pb_head := (pb_head + 1) & PKTBUFF_MASK
            return

    return


pri send_pbuf(pbuf): l
' Write packet buffer to network device
    DEBUG( "send_pbuf(", uhex_(pbuf), ") pbuf len=", udec_(pktbuff[pbuf].len) )

    net.start_frame()
        l := net.wr_block(pktbuff[pbuf].p_data, pktbuff[pbuf].len)
    net.send_frame()
    pb_tail := (pb_tail + 1) & PKTBUFF_MASK

    pbuf_free()


pri set_state(sck, new_state)
' Change the connection state of the socket
    DEBUG("set_state(", udec_(sck), zstr_(netstr.state_str(new_state) ), ")")

    socket[sck].prev_state := socket[sck].state ' record the previous state
    socket[sck].state := new_state
    long[socket[sck].p_signal+4] := sck
    long[socket[sck].p_signal] |= STATE_CHANGED ' signal state change to the application


pri tcp_tx_pending_free(): a
' Get the number of free pending TCP segment slots
    return (tcp_tx_pend.tail-tcp_tx_pend.head-1) & MAX_TCP_TX_PEND_MASK


pri write_arp(pbuf, opc, tha, tpa): l | arp_msg_s ah
' Write ARP header
    DEBUG("write_arp(", udec(pbuf), udec(opc), zstr_(str.mactostr(tha)), zstr_(str.iptostr(tpa) ), ")")
    ah~
    pktbuff[pbuf].p_data := pktbuff[pbuf].p_end := @pktbuff[pbuf].buffer+FRAME_HEADROOM_SZ
    pktbuff[pbuf].len := 0

    ' set up the ARP header
    arp.set_hw_addr_len(@ah,        MACADDR_LEN)
    arp.set_hwtype(@ah,             HRD_ETH)
    arp.set_opcode(@ah,             opc)
    arp.set_proto_addr_len(@ah,     IPV4ADDR_LEN)
    arp.set_proto_type(@ah,         arp.PROTO_TYPE_IP)

    ' who has d.d.d.d?
    ifnot ( tha )
        tha := @_mac_zero
    arp.set_target_hw_addr(@ah,     tha)
    arp.set_target_proto_addr(@ah,  tpa)

    ' tell d.d.d.d (xx:xx:xx:xx:xx:xx)
    arp.set_sender_hw_addr(@ah,     @interface[0].mac_addr)
    arp.set_sender_proto_addr(@ah,  interface[0].ipv4_addr)

    ' write header to pbuf
    pktbuff[pbuf].p_data -= arp.ARP_MSG_SZ      ' rewind to fit ARP header
    pktbuff[pbuf].len += arp.ARP_MSG_SZ
'    DEBUG(" len is now ", udec_(pktbuff[pbuf].len) )
    arp.wr_arp_msg_to(pktbuff[pbuf].p_data, @ah)

    pktbuff[pbuf].layer_written := 3

    return arp.ARP_MSG_SZ


pri write_ethii(pbuf, dest, src, etyp): l | ethii_t eh
' Encapsulate an IP payload with Ethernet-II
'   dest:   destination MAC address
'   src:    source MAC address
'   etyp:   Ethertype
    DEBUG("write_ethii(pbuf=", udec_(pbuf), ")")

    eh~

    ethii.set_dest_addr(@eh, dest)
    ethii.set_src_addr(@eh, src)
    ethii.set_ethertype(@eh, etyp)

    pktbuff[pbuf].p_data -= ethii.ETH_FRM_SZ
    pktbuff[pbuf].len += ethii.ETH_FRM_SZ
    'DEBUG(" len is now ", udec_(pktbuff[pbuf].len) )

    ethii.wr_ethii_frame_to(@eh, pktbuff[pbuf].p_data)

    pktbuff[pbuf].layer_written := 2

    return ethii.ETH_FRM_SZ


pri write_icmp(pbuf, typ, cd, len=0, p_src=0, ident=0, seq_nr=0): l | icmp_msg_s ich, ^echo_msg_s ehdr
' Write ICMP header, message
    DEBUG("write_icmp()")

    ich~

    ' init buffer pointer to the end of the headroom (the first 128 bytes)
    pktbuff[pbuf].p_data := pktbuff[pbuf].p_end := @pktbuff[pbuf].buffer+FRAME_HEADROOM_SZ
    pktbuff[pbuf].len := 0

    ' set up ICMP header
    icmp.set_msg_type(@ich, typ)
    icmp.set_code(@ich, cd)
    icmp.set_chksum(@ich, 0)

    ' write extra message data depending on the ICMP message type
    case icmp.msg_type(@ich)
        icmp.DEST_UNREACH:
            case icmp.code(@ich)
                icmp.PORT_UNREACH:
                    'todo
        icmp.ECHO_REPL:
            ehdr~
            icmp.set_ident(@ehdr, ident)
            icmp.set_seq_nr(@ehdr, seq_nr)
            'todo
        icmp.ECHO_REQ:
            'todo

    ' rewind pbuf pointer to fit ICMP header, and write it
    pktbuff[pbuf].p_data -= icmp.ICMP_MSG_SZ
    pktbuff[pbuf].len += icmp.ICMP_MSG_SZ
    icmp.wr_icmp_msg_to(@ich, pktbuff[pbuf].p_data)


    pktbuff[pbuf].layer_written := 4

    return icmp.ICMP_MSG_SZ


pri write_ipv4(pbuf, lip, rip, pro, len=0, ident=0, dscp=0, ttl=0): l | ipv4_hdr_s ih, tmp, ol, t
' Encapsulate data with IPv4 header
'   Returns:    length of IPv4 header

    DEBUG("write_ipv4(", udec(pbuf), " rip=", zstr_(str.iptostr(rip)), zstr_(netstr.prostr(pro) ), ")")

    ' point to local instance of IPv4 header struct and initialize/clear it out
    ih~

    ' configure IPv4 header
    ip.set_dscp(@ih,            dscp)
    ip.set_msg_ident(@ih,       ident)
    ip.set_flags(@ih,           0)                             'xxx for future use, if frag is ever supported

    ' write options (as applicable) and set TTL
    ol := 0
    if ( ip.dscp(@ih) == ip.CS6 )
        tmp := ip.ROUTER_ALERT_EXAMINE_PKT
        ol += ip.add_option(ip.TYPE_ROUTER_ALERT | ip.COF_COPY, 4, @tmp)
    if ( ip.is_multicast_link_local_addr(rip) )
        ' ttl _must_ be 1 when datagrams are sent to
        '   link-local (224.0.0.0 to .255) multicast addr
        ip.set_ttl(@ih, 1)
    else
        ifnot ( ttl )                           ' use default TTL (64) if it's unspecified
            ip.set_ttl(@ih, ip.TTL_DEFAULT)
        else
            ip.set_ttl(@ih, ttl)

    ip.set_layer4_proto(@ih,    pro)
    ip.set_hdr_chk(@ih,         0)
    ip.set_src_addr(@ih,        lip)
    ip.set_dest_addr(@ih,       rip)
    ip.set_hdr_len(@ih,         ip.IP_HDR_SZ + ol)
    ip.set_dgram_len(@ih,       len)                       ' this depends on the IP header length
    ip.set_frag_offset(@ih,     0)                       'xxx for future use, if frag is ever supported

    pktbuff[pbuf].p_data -= ip.hdr_len(@ih)              ' prepend IP header to transport
    pktbuff[pbuf].len += ip.hdr_len(@ih)

    ip.wr_ip_header_to(@ih, pktbuff[pbuf].p_data)
    ip.wr_chksum_to(@ih, pktbuff[pbuf].p_data+IP_CKSUM)

    arp_queue_ip(pbuf, rip)                           ' queue the dest IP for ARP resolution
'    l := pktbuff[pbuf].p_data-pktbuff[pbuf].p_buff

    pktbuff[pbuf].layer_written := 3

    return ip.hdr_len(@ih)


pri write_ipv4_socket(pbuf, sck, len=0, ident=0, dscp=0, ttl=0): l
' Encapsulate data with IPv4 header, using socket parameters to set up (some of) the header
'   Returns:    length of IPv4 header
    DEBUG("write_ipv4_socket() ", udec(pbuf), " rip=", zstr_(str.iptostr(socket[sck].remote_ip) ) )
    l := write_ipv4(pbuf, ...
                    socket[sck].local_ip, ...
                    socket[sck].remote_ip, ...
                    socket[sck].protocol, ...
                    len, ...
                    ident, ...
                    dscp, ...
                    ttl )
    return


pri write_tcp(pbuf, lip, rip, sp, dp, seqn, ackn, fl, p_ts=0, wnd=0, up=0, slen=0): l | tcp_msg_s th, ck, hl
' Write a TCP segment to the packet buffer
'   lip:    local IP (used for pseudo-header checksum calculation)
'   rip:    remote IP (used for pseudo-header checksum calculation)
'   sp:     source port
'   dp:     destination port
'   seqn:   sequence number
'   ackn:   acknowledgement number
'   fl:     flags/TCP control bits
'   ts:     pointer to timestamps (2 longs, TSval, TSecr)
'   wnd:    TCP window
'   up:     urgent pointer
'   Returns:    length of assembled TCP header

    DEBUG("write_tcp(", udec(pbuf), zstr_(netstr.tcp_flags_str(fl) ), ")")

    ' init buffer pointer to the end of the headroom (the first 128 bytes)
    pktbuff[pbuf].p_data := @pktbuff[pbuf].buffer+FRAME_HEADROOM_SZ

    ' set up local structure for use in building the frame
    th~                                         ' init/fill it with 0

    ' set up the TCP header with socket parameters
    tcp.set_source_port(@th, sp)
    tcp.set_dest_port(@th, dp)
    tcp.set_seq_nr(@th, seqn)
    tcp.set_ack_nr(@th, ackn)
    tcp.set_flags(@th, fl)
    tcp.set_window(@th, wnd)
    tcp.set_urgent_ptr(@th, up)

    ' Check TCP options. The basic TCP header length is initialized to 20.
    '   The value returned by tcp.header_len() is increased for every option set
    tcp.clear_options()
    if ( tcp.flags(@th) & tcp.SYN )                ' new connection?
        DEBUG(" SYN is set")
        tcp.set_option(@th, tcp.MSS,       tcp.MSS_LEN,          net.MTU_MAX-40)
        tcp.set_option(@th, tcp.WIN_SCALE, tcp.WIN_SCALE_LEN,    0)

    ' set timestamps option (sent during connection establishment and in segments thereafter)
    if ( p_ts )
        tcp.set_option(@th, tcp.TMSTAMPS,  tcp.TMSTAMPS_LEN, p_ts)

    hl := tcp.header_len(@th)

    ' rewind the buffer pointer enough to fit the TCP header that was just set up
    pktbuff[pbuf].p_data -= hl
    pktbuff[pbuf].len += hl

    tcp.wr_tcp_header_to(@th, pktbuff[pbuf].p_data)' write the TCP header+options to the buffer

    ' calc the pseudo-header checksum (lip, rip, length, complement output)
    ck := tcp.pseudo_header_cksum(  lip, ...
                                    rip, ...
                                    hl+slen, ...
                                    false)      ' don't complement the output just yet
    ck := crc.inet_chksum(pktbuff[pbuf].p_data, hl+slen, ck, true)

    word[pktbuff[pbuf].p_data+TCPH_CKSUM] := swap_word(ck)

    pktbuff[pbuf].layer_written := 4
    long[p_ts][0] := _timestamp_base+getms()    ' update local TCP segment timestamp

    return hl


pri write_tcp_ip(pbuf, lip, rip, sp, dp, seqn, ackn, fl, ts, wnd=0, up=0, ident=0, dscp=0, ttl=0): l | tl
' Write IPv4-encapsulated TCP segment to the packet buffer
    tl := write_tcp(pbuf, lip, rip, sp, dp, seqn, ackn, fl, ts, wnd, up)
    write_ipv4(pbuf, lip, rip, ip.TCP, tl, ident, dscp, ttl)


pri write_tcp_socket(pbuf, sck, flags, sl=0): s | l
' Send a TCP segment using parameters from a socket
'   sck:    socket number
'   flags:  TCP segment flags
'   sl:     segment length (optional; default=0)
    pktbuff[pbuf].p_end := @pktbuff[pbuf].buffer+FRAME_HEADROOM_SZ

    l := 0
    if ( sl )                                   ' write segment text (payload) if there is one
        l := txget(sck, pktbuff[pbuf].p_end, sl)
        pktbuff[pbuf].p_end += l                ' adjust end pointer to end of payload
        pktbuff[pbuf].len += l

    s := write_tcp( pbuf, ...
                    socket[sck].local_ip, ...
                    socket[sck].remote_ip, ...
                    socket[sck].local_port, ...
                    socket[sck].remote_port, ...
                    socket[sck].snd.nxt, ...
                    socket[sck].rcv.nxt, ...
                    flags, ...
                    @socket[sck].tsval, ...
                    socket[sck].rcv.wnd, ...
                    socket[sck].snd.up, ...
                    l)
    socket[sck].snd.nxt += l
    return s+l


pri write_udp_socket(pbuf, sck): s | udp_msg_s uh, dt, l, pl
' Send UDP socket data
'   sck:    socket number
    DEBUG("write_udp_socket(", udec(pbuf), udec(sck), ")")

    ' init buffer pointer to the end of the headroom (the first 128 bytes)
    pktbuff[pbuf].p_data := pktbuff[pbuf].p_end := @pktbuff[pbuf].buffer+FRAME_HEADROOM_SZ

    ' set up local structures for use in building the frame
    dt := socket[sck].txbuff.datagram.tail
    udp.set_header(@uh)
    udp.set_src_port(socket[sck].local_port)
    udp.set_dest_port(socket[sck].txbuff.datagram.descr[dt].remote.port)
    udp.set_dgram_len(socket[sck].txbuff.datagram.descr[dt].len)
    udp.set_chksum(0)

    ' rewind the buffer pointer enough to fit the UDP header that was just set up
    pktbuff[pbuf].p_data -= udp.UDP_MSG_SZ 
    udp.wr_udp_header_to(pktbuff[pbuf].p_data)
    pktbuff[pbuf].p_data += udp.UDP_MSG_SZ

    ' copy the payload data, if there is any
    if ( udp.payload_len() > 0 )
        pktbuff[pbuf].p_data += txget(sck, ...
                            pktbuff[pbuf].p_data, ...
                            socket[sck].txbuff.datagram.descr[dt].len)
        pktbuff[pbuf].p_end := pktbuff[pbuf].p_data
        pktbuff[pbuf].len += udp.payload_len()

    ' rewind the pointer to the beginning of the UDP header
    pktbuff[pbuf].p_data -= socket[sck].txbuff.datagram.descr[dt].len + ...
                    udp.hdr_len()

    ' write the UDP checksum
    udp.wr_checksum_to( pktbuff[pbuf].p_data+UDP_CKSUM, ...
                        socket[sck].local_ip, ...
                        socket[sck].txbuff.datagram.descr[dt].remote.address, ...
                        udp.payload_len(), ...
                        pktbuff[pbuf].p_data+8)

    pktbuff[pbuf].layer_written := 4

    return udp.dgram_len()


'--

pri show_arp_entry(e)
' Show a specific entry in the ARP table
    DEBUG(  udec_(e), uhex_(arp.cached_proto_type(e) ), zstr_(str.iptostr( arp.cached_proto_addr(e) ) ), zstr_(str.mactostr( arp.cached_hw_addr(e) ) ), udec_(arp.entry[e].resolved) )


pri show_arp_table() | e
' Show the ARP table
    repeat arp.ENTRIES with e
        if ( arp.entry[e].proto_t )
            show_arp_entry(e)


pri show_socket_table() | s

    DEBUG("#    local remote (protocol) state")
    repeat MAX_SOCKETS with s
        if ( socket[s].state > CLOSED )
            DEBUG(  udec_(s), zstr_(str.iptostr( socket[s].local_ip )), ":", udec_(socket[s].local_port), zstr_(str.iptostr( socket[s].remote_ip )), ":", udec_(socket[s].remote_port), "(", zstr_(netstr.prostr(socket[s].protocol) ), ") ", zstr_(netstr.state_str(socket[s].state) ) )


