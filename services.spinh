CON

    FTP_DATA= 20                                ' tcp
    FTP     = 21                                ' tcp
    SSH     = 22                                ' tcp
    TELNET  = 23                                ' tcp
    SMTP    = 25                                ' tcp
    DNS     = 53                                ' tcp/udp
    BOOTP_S = 67                                ' udp
    BOOTP_C = 68                                ' udp
    TFTP    = 69                                ' udp
    HTTP    = 80                                ' tcp
    MDNS    = 5353                              ' udp


DAT
