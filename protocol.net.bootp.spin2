{Spin2_v46}

#ifndef NET_COMMON
#include "net-common.spin2h"
#endif

CON

    { limits }
    BOOTP_MSG_SZ        = 236
    BOOT_FN_LEN         = 128

    BCAST_BIT           = 15

    SECOND              = 1
    MINUTE              = 60 * SECOND
    HR                  = 60 * MINUTE
    DAY                 = 24 * HR
    LSE_90DAYS          = 90 * DAY

    { BOOTP Opcodes }
    BOOT_REQ            = $01
    BOOT_REPL           = $02

    { Hardware types }
    ETHERNET            = $01
    IEEE802             = $06


#include "bootp-common.spin2"


OBJ

    net=    NETIF_DRIVER                        ' network driver "virtual" instance


VAR

    long p_ndev                                 ' network driver object pointer


pub init(optr)
' Set pointer to network device object
    p_ndev := optr


PUB bcast_flag(^bootp_msg_s hdr): f
' Get BOOTP broadcast flag
    return ( ( (hdr.flags >> BCAST_BIT) & 1) == 1)


PUB boot_fn(^bootp_msg_s hdr): p
' Get boot filename
    return @hdr.filename


PUB client_ip(^bootp_msg_s hdr): a
' Get client IP address
    return swap_long(hdr.client_ip)


PUB client_mac(^bootp_msg_s hdr): p
' Get client MAC address
    return @hdr.client_mac


PUB cli_hdw_addr_pad_len(): l
' Get length of client hardware address padding
    return HDWADDRLEN_MAX-MACADDR_LEN   ' XXX make constant


PUB gwy_ip(^bootp_msg_s hdr): a
' Get relay agent IP address
    return swap_long(hdr.gateway_ip)


PUB hdw_addr_len(^bootp_msg_s hdr): l
' Get hardware address length
    return hdr.hw_addr_len


PUB hdw_type(^bootp_msg_s hdr): t
' Get hardware type
    return hdr.client_hw_t


PUB hops(^bootp_msg_s hdr): h
' Get number of hops
    return hdr.hop


PUB inc_xid(^bootp_msg_s hdr)
' Increment xid/transaction ID by 1
    hdr.xid++


PUB lease_elapsed(^bootp_msg_s hdr): s
' Get time elapsed since start of attempt to acquire or renew lease
    return swap_word(hdr.lease_time_elapsed)


PUB new_request(^bootp_msg_s hdr)
' Set up a boot request message
    set_opcode(hdr, BOOT_REQ)
    set_bcast_flag(hdr, true)
    set_client_mac(hdr, net[p_ndev].my_mac() )

PUB opcode(^bootp_msg_s hdr): c
' Get BOOTP message opcode
    return hdr.opcode


PUB rsvd_flags(^bootp_msg_s hdr): f
' Get BOOTP reserved flags
    return hdr.flags


PUB srv_hostname(^bootp_msg_s hdr): p
' Get server hostname
    return @hdr.hostname


PUB srv_ip(^bootp_msg_s hdr): a
' Get next server IP address
    return swap_long(hdr.server_ip)


PUB xid(^bootp_msg_s hdr): i
' Get transaction ID
    return swap_long(hdr.xid)


PUB your_ip(^bootp_msg_s hdr): a
' Get your IP address
    return swap_long(hdr.your_ip)


PUB set_bcast_flag(^bootp_msg_s hdr, flag)
' Set BOOTP broadcast flag
'   Valid values:
'       TRUE (any non-zero value), FALSE (0)
    hdr.flags :=  swap_word( ( (flag <> 0) & 1 ) << BCAST_BIT )


PUB set_boot_fn(^bootp_msg_s hdr, p_str)
' Set boot filename
    bytemove(@hdr.filename, p_str, strsize(p_str) <# BOOT_FN_LEN)


PUB set_client_hw_t(^bootp_msg_s hdr, t)
' Set client hardware address type
    hdr.client_hw_t := t


PUB set_client_ip(^bootp_msg_s hdr, a)
' Set client IP address
    hdr.client_ip := swap_long(a)


PUB set_client_mac(^bootp_msg_s hdr, p_addr)
' Set client MAC address
    bytemove(@hdr.client_mac, p_addr, MACADDR_LEN)


PUB set_cli_hdw_addr_pad_len(len) 'XXX pseudo-metadata that's calculated
' Set length of client hardware address padding
'    _client_hdw_addr_pad := len


PUB set_gwy_ip(^bootp_msg_s hdr, a)
' Set relay agent IP address
    hdr.gateway_ip := swap_long(a)


PUB set_hdw_addr_len(^bootp_msg_s hdr, l)
' Set hardware address length
    hdr.hw_addr_len := l


PUB set_hdw_type(^bootp_msg_s hdr, t)
' Set hardware type
    hdr.client_hw_t := t


PUB set_hops(^bootp_msg_s hdr, h)
' Set number of hops
    hdr.hop := h


PUB set_lease_elapsed(^bootp_msg_s hdr, t)
' Set time elapsed since start of attempt to acquire or renew lease
    hdr.lease_time_elapsed := swap_word(t)


PUB set_opcode(^bootp_msg_s hdr, c)
' Set BOOTP message opcode
    hdr.opcode := c


PUB set_rsvd_flags(^bootp_msg_s hdr, flags)
' Set BOOTP reserved flags
    hdr.flags |= swap_word(flags & $7f00)


PUB set_srv_hostname(^bootp_msg_s hdr, p_str)
' Set server hostname, up to 64 bytes
    bytemove(@hdr.hostname, p_str, strsize(p_str) <# SRV_HOSTN_LEN)


PUB set_srv_ip(^bootp_msg_s hdr, a)
' Set server IP address
    hdr.gateway_ip := swap_long(a)


PUB set_xid(^bootp_msg_s hdr, id)
' Set transaction ID
    hdr.xid := swap_long(id)


PUB set_your_ip(^bootp_msg_s hdr, a)
' Set 'your' IP address
    hdr.your_ip := swap_long(a)


PUB reset_bootp(^bootp_msg_s hdr)
' Reset all values to defaults
    hdr~
    set_client_hw_t(hdr, ETHERNET)
    set_hdw_addr_len(hdr, MACADDR_LEN)
    set_lease_elapsed(hdr, 1)


PUB rd_bootp_msg(^bootp_msg_s hdr): p
' Read BOOTP message, as well as DHCP message, if it exists
'   Returns: current FIFO write pointer
    net[p_ndev].rd_block(@hdr, sizeof(hdr) )
    return net[p_ndev].fifo_wr_ptr()


PUB wr_bootp_msg(^bootp_msg_s hdr): p | st
' Write BOOTP message
'   Returns: number of bytes written to buffer
    st := net[p_ndev].fifo_wr_ptr()
    net[p_ndev].wr_block(@hdr, sizeof(hdr) )
    return net[p_ndev].fifo_wr_ptr()-st


DAT
