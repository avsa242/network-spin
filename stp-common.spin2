con

    struct cist_id_s(...
        word        priority_sysid_ext, ...
        macaddr_s   address)


    ' STP header structure
    struct stp_header_s(...
        word        protocol, ...
        byte        version, ...
        byte        bpdu_type, ...
        byte        bpdu_flags, ...
        cist_id_s   root_id, ...
        long        cost, ...
        cist_id_s   bridge_id, ...
        word        port_id, ...
        word        msg_age, ...
        word        max_age, ...
        word        hello_tm, ...
        word        fwd_delay, ...
        byte        ver1_len, ...
        word        ver3_len)


