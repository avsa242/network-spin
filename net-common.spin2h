#ifndef NET_COMMON
# define NET_COMMON

CON

    MACADDR_LEN         = 6                     ' xx:xx:xx:xx:xx:xx
    IPV4ADDR_LEN        = 4                     ' ddd.ddd.ddd.ddd
    IPV6ADDR_LEN        = 16                    ' xxxx:xxxx:xxxx:xxxx:xxxx:xxxx:xxxx:xxxx

    ' structure definitions
    struct macaddr_s(...
        byte addr[MACADDR_LEN])                 ' OUI_MSB ... LSB

    struct ipv6_addr_s(...
        byte addr[IPV6ADDR_LEN])


   ' ethernet-II header
    struct ethii_hdr_s(...
        byte        dest[MACADDR_LEN], ...
        byte        src[MACADDR_LEN], ...
        word        ethertype)

    ' ARP table/cache
    struct arp_entry_s(...
        long        last_checked, ...
        long        proto_addr, ...
        word        proto_t, ...
        macaddr_s   hw_addr, ...
        byte        resolved)

    ' ARP header
    struct arp_hdr_s(...
        word        hw_t, ...
        word        proto_t, ...
        byte        hw_addr_len, ...
        byte        proto_addr_len, ...
        word        opcode, ...
        macaddr_s   sender_hw_addr, ...
        long        sender_proto_addr, ...
        macaddr_s   target_hw_addr, ...
        long        target_proto_addr)

    ' IPv4 header
    struct ipv4_hdr_s(...
        byte    version, ...
        byte    dscp_ecn, ...
        word    dgram_len, ...
        word    ident, ...
        byte    flags_frag_h, ...
        byte    frag_l, ...
        byte    ttl, ...
        byte    l4proto, ...
        word    checksum, ...
        long    src_addr, ...
        long    dest_addr )

    ' ICMPv4 header
    struct  icmp4_hdr_s(...
        byte    type, ...
        byte    code, ...
        word    checksum)

    ' ICMPv4 echo header
    struct  echo_msg_s(...
        word    ident, ...
        word    seq_nr)

    ' ICMPv4 timestamp header
    struct  timestamp_msg_s(...
        word    ident, ...
        word    seq_nr, ...
        long    time_origin, ...
        long    time_receive, ...
        long    time_transmit)

    ' IGMPv3 membership query header
    struct igmp_memb_query_hdr_s(...
        byte type, ...
        byte max_resp_code, ...
        word checksum, ...
        long group_addr, ...
        byte flags_qrv, ...
        byte qqic, ...
        word num_src)

    ' IGMPv3 memberhip report header
    struct igmp_memb_rep_hdr_s(...
        byte type, ...
        byte reserved, ...
        word checksum, ...
        word flags, ...
        word num_records)

    ' IGMPv3 group record
    struct igmp_grp_rec_s(...
        byte type, ...
        byte aux_data_len, ...
        word num_src, ...
        long mcast_addr)

    ' IPv6 header
    struct ipv6_hdr_s(...
        byte        version_trafch, ...         ' version | trafch[7..4]
        byte        trafcl_flow_h, ...          ' trafcl[3..0] | flow[19..16]
        word        flow_label_l, ...           ' flow[15..0]
        word        payload_len, ...
        byte        next_header, ...
        byte        hop_limit, ...
        ipv6_addr_s src_addr, ...
        ipv6_addr_s dest_addr )


    ' UDP header
    struct udp_hdr_s(...
        word    src_port, ...
        word    dest_port, ...
        word    length, ...
        word    checksum)

    ' TCP header
    struct tcp_hdr_s(...
        word    src_port, ...
        word    dest_port, ...
        long    seq_nr, ...
        long    ack_nr, ...
        byte    header_len, ...                 ' length is b7..4; b0 is b9 of flags
        byte    flags, ...                      ' b7..0
        word    window, ...
        word    checksum, ...
        word    urg_ptr)

    struct pseudo_hdr_s(...
        long    src_ip, ...
        long    dest_ip, ...
        word    l4_proto, ...                   ' TCP | $00
        word    len)


    ' ethertypes
    ETYP_IPV4           = $0800
    ETYP_ARP            = $0806
    ETYP_IPV6           = $86dd
    ETYP_LLDP           = $88cc

    ' hardware types
    HRD_ETH         = 1                         ' only these first two are
    HRD_IEEE802     = 6                         '   officially supported

    HRD_ARCNET      = 7
    HRD_FRMRLY      = 15
    HRD_ATM         = 16
    HRD_HDLC        = 17
    HRD_FIBRECH     = 18
    HRD_ATM2        = 19
    HRD_SERIAL      = 20

    BCAST_IP            = $FF_FF_FF_FF          ' broadcast IP


    ' eth-ii
    ETH_DEST            = 0
    ETH_SRC             = 6
    ETH_TYPE_M          = 12
    ETH_TYPE_L          = 13
    ETH_TYPE            = ETH_TYPE_M

    ' ipv4
    NO_IP               = 0

    IP_ABS_ST           = ETH_TYPE+2            ' add to the below for abs. position within frame

    IP_VERS             = 0
    IP_HDRLEN           = 0
    IP_DSCP_ECN         = 1
    IP_TLEN             = 2
    IP_TLEN_M           = 2
    IP_TLEN_L           = 3
    IP_IDENT_M          = 4
    IP_IDENT_L          = 5
    IP_FLAGS_FRGH       = 6
    IP_FRGL             = 7
    IP_T2L              = 8
    IP_PRTCL            = 9
    IP_CKSUM            = 10
    IP_CKSUM_M          = 10
    IP_CKSUM_L          = 11
    IP_SRCIP            = 12'..15
    IP_DSTIP            = 16'..19

    ' ipv6
    IPV6_VERS           = 0
    IPV6_TRAFFIC_CLASS_M= 0
    IPV6_TRAFFIC_CLASS_L= 1
    IPV6_FLOW_LABEL     = 1
    IPV6_PAYLOAD_LEN    = 4
    IPV6_NEXT_HDR       = 6
    IPV6_HOP_LIMIT      = 7
    IPV6_SRCIP          = 8
    IPV6_DESTIP         = 24


    ' layer 4 protocols
    L4_RSVD             = $00
    L4_ICMP             = $01
    L4_IGMP             = $02
    L4_GGP              = $03
    L4_IP_IN_IP         = $04
    L4_TCP              = $06
    L4_EGP              = $08
    L4_UDP              = $11
    L4_ESP              = $32
    L4_AH               = $33


    ' arp
    ARP_ABS_ST          = ETH_TYPE+2            ' add to the below for abs. position within frame

    ARP_HW_T_M          = 0                     ' 16b/2B
    ARP_HW_T_L          = 1
    ARP_PROTO_T_M       = 2                     ' 16b/2B
    ARP_PROTO_T_L       = 3
    ARP_HWADDR_LEN      = 4                     ' 8b/1B
    ARP_PRADDR_LEN      = 5                     ' 8b/1B
    ARP_OP_CODE_M       = 6                     ' 16b/2B
    ARP_OP_CODE_L       = 7
    ARP_SNDR_HWADDR     = 8'..13                ' 48b/6B
    ARP_SNDR_PRADDR     = 14'..17               ' 32b/4B
    ARP_TGT_HWADDR      = 18'..23               ' 48b/6B
    ARP_TGT_PRADDR      = 24'..27               ' 32b/4B


    ' udp
    UDP_ABS_ST          = IP_DSTIP + 4          ' add to the below for abs. position within frame

    UDP_SRCPORT         = 0
     UDP_SRCPORT_L      = 1
    UDP_DESTPORT        = 2
     UDP_DESTPORT_L     = 3
    UDP_DGRAMLEN        = 4
     UDP_DGRAMLEN_L     = 5
    UDP_CKSUM           = 6
     UDP_CKSUM_L        = 7


    ' icmp
    ICMP_ABS_ST         = IP_DSTIP + 4          ' add to the below for abs. position within frame
    ICMP_T              = 0
    ICMP_CD             = 1
    ICMP_CKSUM          = 2
     ICMP_CKSUM_L       = 3
    ICMP_DATA           = 50                    ' data for ECHO messages

    ' tcp
    TCPH_ST             = IP_ABS_ST+20
    TCPH_SRCP           = 0'..1
    TCPH_DESTP          = 2'..3
    TCPH_SEQNR          = 4'..7
    TCPH_ACKNR          = 8'..11
    TCPH_HDRLEN         = 12                    ' upper four bits only; LSB is MSB of FLAGS
    TCPH_FLAGS          = 13                    ' bottom 8 bits of FLAGS
    TCPH_WIN            = 14'..15
    TCPH_CKSUM          = 16'..17
    TCPH_URGPTR         = 18'..19
    TCPH_OPTS           = 20'..n                ' start of TCP options, if used


pri swap_long(l): sl
' Swap the byte order of a word
    sl.byte[0], sl.byte[1], sl.byte[2], sl.byte[3]  := l.byte[3], l.byte[2], l.byte[1], l.byte[0]


pri swap_word(w): sw
' Swap the byte order of a word
    sw.byte[0], sw.byte[1] := w.byte[1], w.byte[0]


DAT

    _mac_bcast  byte $FF, $FF, $FF, $FF, $FF, $FF
    _mac_zero   byte 0, 0, 0, 0, 0, 0

#endif


DAT
