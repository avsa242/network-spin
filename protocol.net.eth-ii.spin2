{Spin2_v46}

#ifndef NET_COMMON
#include "net-common.spin2h"
#endif

CON

    ' limits
    ETH_FRM_SZ      = 14

   ' ethernet-II structure
    struct ethii_t(...
        macaddr_s   dest, ...
        macaddr_s   src, ...
        word        ethertype)


OBJ

    net=    NETIF_DRIVER                        ' network driver "virtual" instance


VAR

    long p_ndev                                 ' network driver object pointer

    ethii_t message                             ' ethernet-II data


PUB init(optr)
' Set pointer to network device object
    p_ndev := optr
    message~


PUB dest_addr(): a
' Get destination address of ethernet frame
'   Returns:    pointer to 6-byte MAC address
    return @message.dest


PUB ethertype(): t
' Get ethertype of ethernet frame
'   Returns:    word (little-endian)
    return message.ethertype


PUB new(src, dest, ether_t)
' Start new ethernet-II frame
'   src:        source MAC address (pointer)
'   dest:       destination MAC address (pointer)
'   ether_t:    ethertype (little-endian)
    bytemove(@message.dest, dest, MACADDR_LEN)
    bytemove(@message.src, src, MACADDR_LEN)
    message.ethertype := swap_word(ether_t)

    wr_ethii_frame()


PUB reply(): p | macaddr_s mac_tmp
' Set up/write Ethernet II frame as a reply to last received frame
'   Returns:    network device FIFO write pointer after writing ethernet-II data
    ' swap the dest & source addresses
    bytemove(@mac_tmp, @message.dest, MACADDR_LEN)
    bytemove(@message.dest, @message.src, MACADDR_LEN)
    bytemove(@message.src, @mac_tmp, MACADDR_LEN)

    ' write the ethernet-II data
    wr_ethii_frame()
    return net[p_ndev].fifo_wr_ptr()


PUB src_addr(): addr
' Get source address of ethernet frame
'   Returns:    pointer to 6-byte MAC address
    return @message.src


PUB set_dest_addr(p_addr)
' Set destination address of ethernet frame
'   p_addr:     destination MAC address (pointer)
    bytemove(@message.dest, p_addr, MACADDR_LEN)


PUB set_ethertype(t)
' Set ethertype of ethernet frame
'   t:          ethertype (little-endian word)
    message.ethertype := swap_word(t)


PUB set_src_addr(p_addr)
' Set source address of ethernet frame
'   p_addr:     source MAC address (pointer)
    bytemove(@message.src, p_addr, MACADDR_LEN)


PUB rd_ethii_frame(): p
' Read ethernet-II frame
'   Returns: network device FIFO write pointer after reading
    net[p_ndev].rd_block(@message.dest, MACADDR_LEN)
    net[p_ndev].rd_block(@message.src, MACADDR_LEN)
    net[p_ndev].rd_block(@message.ethertype, 2)

    return net[p_ndev].fifo_wr_ptr()


PUB wr_ethii_frame(): p
' Write ethernet-II frame
'   Returns: network device FIFO write pointer after writing
    net[p_ndev].wr_block(@message.dest, MACADDR_LEN)
    net[p_ndev].wr_block(@message.src, MACADDR_LEN)
    net[p_ndev].wr_block(@message.ethertype, 2)

    return net[p_ndev].fifo_wr_ptr()


DAT
