{Spin2_v51}

#ifndef NET_COMMON
# include "net-common.spin2h"
#endif

CON

    ' limits
    ETHII_HDR_SZ      = 14


OBJ

    net=    NETIF_DRIVER                        ' network driver "virtual" instance


VAR

    long p_ndev                                 ' network driver object pointer


PUB init(optr)
' Set pointer to network device object
'   (must be set in order to read from or write to network device FIFO)
    p_ndev := optr


PUB dest_addr(^ethii_hdr_s eh): a
' Get destination address of ethernet header
'   eh:         pointer to ethernet-II structure
'   Returns:    pointer to 6-byte MAC address
    return @eh.dest


PUB ethertype(^ethii_hdr_s eh): t
' Get ethertype of ethernet header
'   eh:         pointer to ethernet-II structure
'   Returns:    word (little-endian)
    return swap_word(eh.ethertype)


PUB new(^ethii_hdr_s eh, src, dest, ether_t, wrf=1, p_dest=0)
' Start new ethernet-II header
'   eh:         pointer to ethernet-II structure
'   src:        source MAC address (pointer)
'   dest:       destination MAC address (pointer)
'   ether_t:    ethertype (little-endian)
    bytemove(@eh.dest, dest, MACADDR_LEN)
    bytemove(@eh.src, src, MACADDR_LEN)
    eh.ethertype := swap_word(ether_t)

    if ( wrf == 1 )
        wr_ethii_frame(@eh)
    elseif ( wrf == 2 )
        wr_ethii_frame_to(@eh, p_dest)


PUB reply(^ethii_hdr_s eh, wrf=1, p_dest=0): p
' Set up/write Ethernet II header as a reply to last received header
'   eh:         pointer to ethernet-II structure
'   wrf:        write header data
'               0: don't write
'               1: write directly to network device FIFO
'               2: write to RAM
'   p_dest:     where to write ethernet-II frame (if wrf == 2)
'   Returns:    network device FIFO write pointer after writing ethernet-II data

    ' swap the dest & source addresses
    bytemove(@eh.dest, @eh.src, MACADDR_LEN)
    bytemove(@eh.src, net[p_ndev].my_mac(), MACADDR_LEN)

    ' write the ethernet-II data
    if ( wrf == 1 )
        return wr_ethii_frame(@eh)
    elseif ( wrf == 2 )
        return wr_ethii_frame_to(@eh, p_dest)


PUB src_addr(^ethii_hdr_s eh): a
' Get source address of ethernet header
'   eh:         pointer to ethernet-II structure
'   Returns:    pointer to 6-byte MAC address
    return @eh.src


PUB set_dest_addr(^ethii_hdr_s eh, p_addr)
' Set destination address of ethernet header
'   eh:     pointer to ethernet-II structure
'   p_addr: destination MAC address (pointer)
    bytemove(@eh.dest, p_addr, MACADDR_LEN)


PUB set_ethertype(^ethii_hdr_s eh, t)
' Set ethertype of ethernet header
'   eh:     pointer to ethernet-II structure
'   t:      ethertype (little-endian word)
    eh.ethertype := swap_word(t)


PUB set_src_addr(^ethii_hdr_s eh, p_addr)
' Set source address of ethernet header
'   eh:     pointer to ethernet-II structure
'   p_addr: source MAC address (pointer)
    bytemove(@eh.src, p_addr, MACADDR_LEN)


PUB rd_ethii_frame(^ethii_hdr_s eh): p
' Read ethernet-II header
'   eh:         pointer to ethernet-II structure
'   Returns:    network device FIFO write pointer after reading
    net[p_ndev].rd_block(@eh, ETHII_HDR_SZ)
    return net[p_ndev].fifo_wr_ptr()


PUB wr_ethii_frame(^ethii_hdr_s eh): p
' Write ethernet-II header directly to network device FIFO
'   eh:         pointer to ethernet-II structure
'   Returns:    network device FIFO write pointer after writing
    net[p_ndev].wr_block(@eh.dest, MACADDR_LEN)
    net[p_ndev].wr_block(@eh.src, MACADDR_LEN)
    net[p_ndev].wr_block(@eh.ethertype, 2)

    return net[p_ndev].fifo_wr_ptr()


pub wr_ethii_frame_to(^ethii_hdr_s eh, p_dest): p
' Write ethernet-II frame
'   eh:         pointer to ethernet-II structure
'   p_dest:     RAM location to write ethernet-II header to
'   Returns:    network device FIFO write pointer after writing
    bytemove(p_dest, @eh, ETHII_HDR_SZ)


DAT
