{Spin2_v46}

#ifndef NET_COMMON
#include "net-common.spin2h"
#endif

CON

    { limits }
    TCP_HDR_SZ      = 20

    struct tcp_msg_s(...
        word    src_port, ...
        word    dest_port, ...
        long    seq_nr, ...
        long    ack_nr, ...
        byte    header_len, ...                 ' length is b7..4; b0 is b9 of flags
        byte    flags, ...                      ' b7..0
        word    window, ...
        word    checksum, ...
        word    urg_ptr)

    pseudo_hdr_s(...
        long    src_ip, ...
        long    dest_ip, ...
        word    l4_proto, ...                   ' TCP | $00
        word    len)


    { TCP flags/control bits }
    CWR_BIT         = 7
    ECN_ECHO_BIT    = 6
    URG_BIT         = 5
    ACK_BIT         = 4
    PSH_BIT         = 3
    RST_BIT         = 2
    SYN_BIT         = 1
    FIN_BIT         = 0

    CWR             = 1 << CWR_BIT
    ECN_ECHO        = 1 << ECN_ECHO_BIT
    URG             = 1 << URG_BIT
    ACK             = 1 << ACK_BIT
    PSH             = 1 << PSH_BIT
    RST             = 1 << RST_BIT
    SYN             = 1 << SYN_BIT
    FIN             = 1 << FIN_BIT

    { TCP options }
    NOOP            = $01
    MSS             = $02
    WIN_SCALE       = $03
    SACK_PRMIT      = $04
    TMSTAMPS        = $08


OBJ

    net=    NETIF_DRIVER                        ' network driver "virtual" instance
    crc:    "math.crc"


VAR

    long p_ndev                                 ' network driver object pointer

    ' TCP options data
    long _tmstamps[2]
    word _tcp_start, _tcp_msglen
    word _tcp_mss
    word _options_len
    byte _tcp_sack_perm
    byte _tcp_winscale

    tcp_msg_s   header                          ' TCP header data


pub init(optr)
' Set pointer to network device object
    p_ndev := optr


PUB pseudo_header_cksum(src, dest, len=0): ck | pseudo_hdr_s phdr
' Calculate TCP pseudo-header checksum
'   ip_src:     IPv4 source address
'   ip_dest:    IPv4 destination address
'   len:        TCP payload length (the TCP header length is already included)
'   Returns:    checksum
    phdr~
    phdr.src_ip :=      src
    phdr.dest_ip :=     dest
    phdr.l4_proto :=    (L4_TCP << 8) | 0       ' b15..8: layer 4 protocol, b7..0: reserved
    phdr.len :=         len                     ' TCP header + payload len

    return crc.inet_chksum(@phdr, 12)


PUB reply(ack_inc)
' Set up the TCP segment to "reply" to the last received segment
'   ack_inc: value to increase the outgoing acknowledgement number by
    swap_ports()
    swap_seq_nrs()
    inc_ack_nr(ack_inc)
    set_checksum(0)


PUB reset()
' Reset/initialize all stored data to 0
    header~


PUB set_ack_nr(n)
' Set TCP acknowledgement number
    header.ack_nr := swap_long(n)


PUB set_checksum(ck)
' Set checksum
    header.checksum := swap_word(ck)


PUB set_dest_port(p)
' Set destination port field
    header.dest_port := swap_word(p)


PUB set_flags(f)
' Set TCP header flags
    header.flags := (f & $ff)


PUB set_header_len(l)
' Set TCP header length, in bytes
    header.header_len := ( (l / 4) << 4)


PUB set_mss(sz) 'xxx review
' Set TCP maximum segment size
    _tcp_mss := swap_word(sz)


PUB set_sack_perm(sp)
' Set selective-acknowledge permitted flag
    { equal to the length in a SACK_PERMIT KLV option? }
    _tcp_sack_perm := (sp <> 0)


PUB set_seq_nr(n)
' Set TCP sequence number
    header.seq_nr := swap_long(n)


PUB set_source_port(p)
' Set source port field
    header.src_port := swap_word(p)


PUB set_timest(tm)
' Set timestamp (TCP option)
    '_tmstamps[0] := tm


PUB set_timest_echo(tm)
' Set timestamp echo (TCP option)
    '_tmstamps[1] := tm


PUB set_urgent_ptr(uptr)
' Set TCP urgent pointer
    header.urg_ptr := swap_word(uptr)


PUB set_window(w)
' Set TCP window
    header.window := swap_word(w)


PUB inc_ack_nr(amt) 'xxx review
' Increment acknowledgement number by amt
    '_ack_nr += amt


PUB inc_seq_nr(amt) 'xxx review
' Increment sequence number by amt
    '_seq_nr += amt


PUB ack_nr(): n
' Get TCP acknowledgement number
    return swap_long(header.ack_nr)


PUB chksum(): ck
' Get TCP header checksum
    return swap_word(header.checksum)


PUB dest_port(): p
' Get destination port field
    return swap_word(header.dest_port)


PUB flags(): f
' Get TCP header flags
    return header.flags


PUB header_len(): len
' Get current header length, in bytes
    return (header.header_len >> 4) * 4


PUB msg_len(): len  'xxx review
' Get current message length
    'return _tcp_msglen


PUB max_seg_sz(): sz    'xxx review
' Get current maximum segment size (TCP option)
    return swap_word(_tcp_mss)


PUB sack_perm(): sp 'xxx review
' Get selective-acknowledge permitted flag (TCP option)
    { equal to the length in a SACK_PERMIT KLV option? }
    return (_tcp_sack_perm == 2)


PUB seq_nr(): n
' Get TCP sequence number
    return swap_long(header.seq_nr)


PUB source_port(): p
' Get source port field
    return swap_word(header.src_port)


PUB swap_ports()    'xxx review
' Swap source and destination ports, for use when sending a response
    '_tcp_port ror= 16
    header.src_port, header.dest_port := header.dest_port, header.src_port


PUB swap_seq_nrs()  'xxx review
' Swap sequence and acknowledgement numbers, for use when sending a response
    header.seq_nr, header.ack_nr := header.ack_nr, header.seq_nr


PUB timest(): tm    'xxx review
' Get timestamp (TCP option)
    return _tmstamps[0]


PUB timest_echo(): tm   'xxx review
' Get timestamp echo (TCP option)
    return _tmstamps[1]


PUB timest_ptr(): ptr   'xxx review
' Get pointer to timestamp data
    return @_tmstamps


PUB urgent_ptr(): p
' Get TCP urgent pointer
    return swap_word(header.urg_ptr)


PUB window(): win
' Get TCP header window
    return swap_word(header.window)


PUB rd_tcp_header(): l  'xxx review; other protocols return the FIFO position, this returns header length
' Read/disassemble TCP header
'   Returns: length of read header, in bytes
    net[p_ndev].rd_block(@header, TCP_HDR_SZ)
    return TCP_HDR_SZ


PUB rd_tcp_opts(): p | kind, st, opts_len
' Read TCP options
    st := net[p_ndev].fifo_wr_ptr()

    ' TCP header length is the header itself plus the options;
    '   subtract out the header to get the length of the options
    opts_len := header_len() - 20

    ' read through all KLVs
    repeat
        kind := net[p_ndev].rd_byte()
        case kind
            MSS:
                net[p_ndev].rd_byte()                       ' skip over the length byte
                _tcp_mss := net[p_ndev].rd_word()
            SACK_PRMIT:
                _tcp_sack_perm := net[p_ndev].rd_byte()     ' actually the length byte
            TMSTAMPS:
                net[p_ndev].rd_byte()
                _tmstamps[0] := net[p_ndev].rd_long()
                _tmstamps[1] := net[p_ndev].rd_long()
            NOOP:
                ' only one byte - do nothing
            WIN_SCALE:
                _tcp_winscale := net[p_ndev].rd_byte()
    until ( net[p_ndev].fifo_wr_ptr()-st ) > opts_len
    return net[p_ndev].fifo_wr_ptr()


PUB wr_tcp_header(): p  'xxx review; other protocols return FIFO position after writing; this returns TCP msg len
' Write/assemble TCP header
'   Returns: length of assembled header, in bytes
    _tcp_start := net[p_ndev].fifo_wr_ptr()
    net[p_ndev].wr_block(@header, TCP_HDR_SZ)
    _tcp_msglen := net[p_ndev].fifo_wr_ptr()-_tcp_start
    return _tcp_msglen


PUB write_klv(kind, len, wrv=0, v=0): l
' Write KLV to ptr_buff
'   kind:   option kind
'   len:    length of KLV, 1..255 (number of option bytes only; do not include kind or len bytes)
'           any other value: only the type will be written
'   wv:     Whether to write the value data (0: ignore, non-zero: write val)
'   v:      value of option data (ignored if len is outside valid range or if wr_val is 0)
'           When len is 1..4, values will be read directly from parameter
'           When len is 5..255, val is expected to be a pointer to value data
'   Returns: total length of KLV (includes: kind, length, and all values)

    ' track length of options; it'll be needed later for padding the end of the message
    _options_len += net[p_ndev].wr_byte(kind)
    case len
        1..4:                                   ' len <= 4: write immediate value
            _options_len += net[p_ndev].wr_byte(len+2)
            if ( wrv )
            ' only write the value data if explicitly called to; some options only consist of the
            '   KIND and LENGTH fields
                _options_len += net[p_ndev].wr_block(@v, len-2)
        5..255:                                 ' len >4: write values pointed to
            _options_len += net[p_ndev].wr_byte(len)
            if ( wrv )
                _options_len += net[p_ndev].wr_block(v, len-2)
        other:                                  ' write kind only; no values
    return _options_len


DAT
