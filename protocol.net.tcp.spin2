{Spin2_v51}

#ifndef NET_COMMON
#include "net-common.spin2h"
#endif

CON

    { limits }
    TCP_HDR_SZ      = 20


    { TCP flags/control bits }
    CWR_BIT         = 7
    ECN_ECHO_BIT    = 6
    URG_BIT         = 5
    ACK_BIT         = 4
    PSH_BIT         = 3
    RST_BIT         = 2
    SYN_BIT         = 1
    FIN_BIT         = 0

    CWR             = 1 << CWR_BIT
    ECN_ECHO        = 1 << ECN_ECHO_BIT
    URG             = 1 << URG_BIT
    ACK             = 1 << ACK_BIT
    PSH             = 1 << PSH_BIT
    RST             = 1 << RST_BIT
    SYN             = 1 << SYN_BIT
    FIN             = 1 << FIN_BIT

    { TCP options }
    NOOP            = $01
    MSS             = $02
    WIN_SCALE       = $03
    SACK_PRMIT      = $04
    TMSTAMPS        = $08

    MSS_LEN         = 4
    WIN_SCALE_LEN   = 3
    SACK_PRMIT_LEN  = 2
    TMSTAMPS_LEN    = 10


OBJ

    net=    NETIF_DRIVER                        ' network driver "virtual" instance
    crc:    "math.crc"


VAR

    long p_ndev                                 ' network driver object pointer

    ' TCP options data
    long _tmstamps[2]
    word _tcp_start, _tcp_msglen
    word _tcp_mss
    word _options_len
    byte _tcp_sack_perm
    byte _tcp_winscale

    byte _options_buff[20]


pub init(optr)
' Set pointer to network device object
    p_ndev := optr


PUB pseudo_header_cksum(src, dest, l=0, co=true): ck | pseudo_hdr_s phdr
' Calculate TCP pseudo-header checksum
'   ip_src:     IPv4 source address
'   ip_dest:    IPv4 destination address
'   len:        TCP payload length (the TCP header length is already included)
'   co:         complement the checksum
'   Returns:    checksum
    phdr~
    phdr.src_ip :=      swap_long(src)          ' swap to network byte order
    phdr.dest_ip :=     swap_long(dest)         '
    phdr.l4_proto :=    (L4_TCP << 8) | 0       ' b15..8: layer 4 protocol, b7..0: reserved
    phdr.len :=         swap_word(l)            ' TCP header + payload len

    if ( co )
        return crc.inet_chksum(@phdr, 12)
    else
        return crc.inet_chksum(@phdr, 12, 0, false)


PUB reply(^tcp_msg_s hdr, ack_inc)
' Set up the TCP segment to "reply" to the last received segment
'   ack_inc: value to increase the outgoing acknowledgement number by
    swap_ports(@hdr)
    swap_seq_nrs(@hdr)
    set_checksum(@hdr, 0)


PUB reset(^tcp_msg_s hdr)
' Reset/initialize all stored data to 0
    hdr~


PUB set_ack_nr(^tcp_msg_s hdr, n)
' Set TCP acknowledgement number
    hdr.ack_nr := swap_long(n)


PUB set_checksum(^tcp_msg_s hdr, ck)
' Set checksum
    hdr.checksum := swap_word(ck)


PUB set_dest_port(^tcp_msg_s hdr, p)
' Set destination port field
    hdr.dest_port := swap_word(p)


PUB set_flags(^tcp_msg_s hdr, f)
' Set TCP header flags
    hdr.flags := (f & $ff)


PUB set_header_len(^tcp_msg_s hdr, l)
' Set TCP header length, in bytes
    hdr.header_len := ( (l / 4) << 4)


PUB set_mss(sz) 'xxx review
' Set TCP maximum segment size
    _tcp_mss := swap_word(sz)


PUB set_sack_perm(sp)
' Set selective-acknowledge permitted flag
    { equal to the length in a SACK_PERMIT KLV option? }
    _tcp_sack_perm := (sp <> 0)


PUB set_seq_nr(^tcp_msg_s hdr, n)
' Set TCP sequence number
    hdr.seq_nr := swap_long(n)


PUB set_source_port(^tcp_msg_s hdr, p)
' Set source port field
    hdr.src_port := swap_word(p)


PUB set_local_timestamp(tm)
' Set timestamp (TCP option)
    _tmstamps[0] := swap_long(tm)


PUB set_timestamp_echo(tm)
' Set timestamp echo (TCP option)
    _tmstamps[1] := swap_long(tm)


PUB set_urgent_ptr(^tcp_msg_s hdr, uptr)
' Set TCP urgent pointer
    hdr.urg_ptr := swap_word(uptr)


PUB set_window(^tcp_msg_s hdr, w)
' Set TCP window
    hdr.window := swap_word(w)


PUB ack_nr(^tcp_msg_s hdr): n
' Get TCP acknowledgement number
    return swap_long(hdr.ack_nr)


PUB chksum(^tcp_msg_s hdr): ck
' Get TCP header checksum
    return swap_word(hdr.checksum)


PUB dest_port(^tcp_msg_s hdr): p
' Get destination port field
    return swap_word(hdr.dest_port)


PUB flags(^tcp_msg_s hdr): f
' Get TCP header flags
    return hdr.flags


PUB header_len(^tcp_msg_s hdr): len
' Get current header length, in bytes
    return (hdr.header_len >> 4) * 4


PUB max_seg_sz(): sz    'xxx review
' Get current maximum segment size (TCP option)
    return swap_word(_tcp_mss)


PUB sack_perm(): sp 'xxx review
' Get selective-acknowledge permitted flag (TCP option)
    { equal to the length in a SACK_PERMIT KLV option? }
    return (_tcp_sack_perm == 2)


PUB seq_nr(^tcp_msg_s hdr): n
' Get TCP sequence number
    return swap_long(hdr.seq_nr)


PUB source_port(^tcp_msg_s hdr): p
' Get source port field
    return swap_word(hdr.src_port)


PUB swap_ports(^tcp_msg_s hdr)    'xxx review
' Swap source and destination ports, for use when sending a response
    '_tcp_port ror= 16
    hdr.src_port, hdr.dest_port := hdr.dest_port, hdr.src_port


PUB swap_seq_nrs(^tcp_msg_s hdr)  'xxx review
' Swap sequence and acknowledgement numbers, for use when sending a response
    hdr.seq_nr, hdr.ack_nr := hdr.ack_nr, hdr.seq_nr


PUB timestamp_val(): tm    'xxx review
' Get timestamp (TCP option)
    return swap_long(_tmstamps[0])


PUB timestamp_echo(): tm   'xxx review
' Get timestamp echo (TCP option)
    return swap_long(_tmstamps[1])


PUB timest_ptr(): ptr   'xxx review
' Get pointer to timestamp data
    return @_tmstamps


pub update_checksum(^tcp_msg_s hdr, lip, rip, sl=0, p_seg=0): ck | tmp
' Update the checksum in the TCP header
'   lip:        local/source IP for pseudo-header checksum
'   rip:        remote/destination IP for pseudo-header checksum
'   sl:         TCP segment length (optional; default is 0)
'   p_seg:      pointer to segment/payload data (optional)
'   Returns:    TCP segment checksum
    set_checksum(@hdr, 0)                             ' init checksum field to 0

    ' we always need the basic TCP header checksum, so do it first, seeded by the
    '   pseudo-header checksum
    ck := crc.inet_chksum(  @hdr, ...
                            20, ...
                            pseudo_header_cksum(lip, rip, 20+sl, false), ...
                            false )
    if ( sl )
        ' if there's segment text (a payload), checksum it as well, using the header checksum
        '   as a starting point
        ck := crc.inet_chksum(p_seg, sl, ck, false)

    ck := !ck & $ffff                           ' complement the output, keep only the lower 16 bits

    ' write the checksum back to the TCP header and restore the FIFO write pointer afterwards
    tmp := net[p_ndev].fifo_wr_ptr()
    net[p_ndev].fifo_set_wr_ptr(_tcp_start + TCPH_CKSUM)
    net[p_ndev].wr_word( swap_word(ck) )
    net[p_ndev].fifo_set_wr_ptr(tmp)


pub wr_checksum_to(^tcp_msg_s hdr, p_dest, lip, rip, sl=0, p_seg=0): ck

    set_checksum(@hdr, 0)                             ' init checksum field to 0

    ' we always need the basic TCP header checksum, so do it first, seeded by the
    '   pseudo-header checksum
    ck := crc.inet_chksum(  @hdr, ...
                            header_len(@hdr), ...
                            pseudo_header_cksum(lip, rip, 24+sl, false), ...
                            false )
    if ( sl )
        ' if there's segment text (a payload), checksum it as well, using the header checksum
        '   as a starting point
        ck := crc.inet_chksum(p_seg, sl, ck, false)

    ck := !ck & $ffff                           ' complement the output, keep only the lower 16 bits

    ' write the checksum back to the TCP header and restore the FIFO write pointer afterwards
    ck := swap_word(ck)
    word[p_dest] := ck


PUB urgent_ptr(^tcp_msg_s hdr): p
' Get TCP urgent pointer
    return swap_word(hdr.urg_ptr)


PUB window(^tcp_msg_s hdr): win
' Get TCP header window
    return swap_word(hdr.window)


PUB rd_tcp_header(^tcp_msg_s hdr): l  'xxx review; other protocols return the FIFO position, this returns header length
' Read/disassemble TCP header
'   Returns: length of read header, in bytes
    net[p_ndev].rd_block(@hdr, TCP_HDR_SZ)
    return TCP_HDR_SZ


PUB rd_tcp_opts(^tcp_msg_s hdr): p | kind, st, opts_len
' Read TCP options
    st := net[p_ndev].fifo_wr_ptr()

    ' TCP header length is the header itself plus the options;
    '   subtract out the header to get the length of the options
    opts_len := header_len(@hdr) - 20

    ' read through all KLVs
    repeat
        kind := net[p_ndev].rd_byte()
        case kind
            MSS:
                net[p_ndev].rd_byte()                       ' skip over the length byte
                _tcp_mss := net[p_ndev].rd_word()
                opts_len -= MSS_LEN
            SACK_PRMIT:
                _tcp_sack_perm := net[p_ndev].rd_byte()     ' actually the length byte
                opts_len -= SACK_PRMIT_LEN
            TMSTAMPS:
                net[p_ndev].rd_byte()
                _tmstamps[0] := net[p_ndev].rd_long()       ' TSval
                _tmstamps[1] := net[p_ndev].rd_long()       ' TSecr
                opts_len -= TMSTAMPS_LEN
            NOOP:
                ' only one byte - do nothing
                opts_len--
            WIN_SCALE:
                _tcp_winscale := net[p_ndev].rd_byte()
                opts_len -= WIN_SCALE_LEN
    while (opts_len > 0)

    return net[p_ndev].fifo_wr_ptr()


PUB wr_tcp_header(^tcp_msg_s hdr): p  'xxx review; other protocols return FIFO position after writing; this returns TCP msg len
' Write/assemble TCP header
'   Returns: length of assembled header, in bytes
    _tcp_start := net[p_ndev].fifo_wr_ptr()
    net[p_ndev].wr_block(@hdr, TCP_HDR_SZ)
    _tcp_msglen := net[p_ndev].fifo_wr_ptr()-_tcp_start
    return _tcp_msglen


pub wr_tcp_header_to(^tcp_msg_s hdr, p_dest): p | d, r

'    r := 4-( (TCP_HDR_SZ+_options_len) // 4)

    bytemove(p_dest, @hdr, TCP_HDR_SZ)
    p_dest += TCP_HDR_SZ
    if ( _options_len )                         ' if there're options defined, write them out, too
        bytemove(p_dest, @_options_buff, _options_len)


PUB write_klv(kind, len, wrv=0, v=0): l
' Write KLV to ptr_buff
'   kind:   option kind
'   len:    length of KLV, 1..255 (number of option bytes only; do not include kind or len bytes)
'           any other value: only the type will be written
'   wv:     Whether to write the value data (0: ignore, non-zero: write val)
'   v:      value of option data (ignored if len is outside valid range or if wr_val is 0)
'           When len is 1..4, values will be read directly from parameter
'           When len is 5..255, val is expected to be a pointer to value data
'   Returns: total length of KLV (includes: kind, length, and all values)

    ' track length of options; it'll be needed later for padding the end of the message
    _options_len += net[p_ndev].wr_byte(kind)
    case len
        1..4:                                   ' len <= 4: write immediate value
            _options_len += net[p_ndev].wr_byte(len+2)
            if ( wrv )
            ' only write the value data if explicitly called to; some options only consist of the
            '   KIND and LENGTH fields
                _options_len += net[p_ndev].wr_block(@v, len-2)
        5..255:                                 ' len >4: write values pointed to
            _options_len += net[p_ndev].wr_byte(len)
            if ( wrv )
                _options_len += net[p_ndev].wr_block(v, len-2)
        other:                                  ' write kind only; no values
    return _options_len


pub clear_options()
' Clear options buffer
    bytefill(@_options_buff, 0, 20)
    _options_len := 0


PUB set_option(^tcp_msg_s hdr, kind, len=0, v=0): l | p_dest, r
' Write KLV to options buffer
'   kind:   option kind
'   len:    length of KLV, 1..255 (if unspecified or 0, the length field will not be emitted)
'   v:      value of option data (ignored if len is outside valid range or if wr_val is 0)
'           When len is 1..4, values will be read directly from parameter
'           When len is 5..255, val is expected to be a pointer to value data
'   Returns: total length of KLV (includes: kind, length, and all values)

    p_dest := @_options_buff+_options_len
    byte[p_dest++] := kind                      ' write the kind

    case len
        1..4:
            byte[p_dest++] := len               ' write the length
            'xxx determine whether value(s) should be writte based on kind
            if ( (len-2) == 2 )
                v := swap_word(v)               ' swap to network byte order
                long[p_dest] := v
            elseif ( (len-2) == 4 )
                v := swap_long(v)               ' swap to network byte order
                long[p_dest] := v
        5..255:
            byte[p_dest++] := len               ' write the length
            'xxx determine whether value(s) should be written based on kind
            case kind
                TMSTAMPS:
                    long[p_dest][0] := swap_long(long[v][0])
                    long[p_dest][1] := swap_long(long[v][1])
                other:
                    bytemove(p_dest, v, len-2)
        other:                                  ' no length or value fields

    _options_len += len
    r := (TCP_HDR_SZ+_options_len) // 4
    if ( r )                                    ' zero-pad if TCP header isn't a multiple of 4
        r := 4-r
    set_header_len(@hdr, TCP_HDR_SZ+_options_len+r)
    return _options_len

DAT
