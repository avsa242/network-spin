{Spin2_v46}

con

   ' structure definitions
    struct tftp_req_pkt_s(...
        word opcode, ...
        byte filename[FN_LEN_MAX], ...
        byte mode[MODE_LEN_MAX])

    struct tftp_data_pkt_s(...
        word opcode, ...
        word block_nr, ...
        byte data[TFTP_BLOCK_LEN_MAX])

    struct tftp_ack_pkt_s(...
        word opcode, ...
        word block_nr)

    struct tftp_error_pkt_s(...
        word opcode, ...
        word error_code, ...
        byte error_msg[ERRMSG_LEN_MAX])


